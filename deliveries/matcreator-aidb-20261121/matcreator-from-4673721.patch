+from __future__ import annotations
+
+import json
+import os
+from copy import deepcopy
+from pathlib import Path
+from typing import Any, Mapping
+
+BOHRIUM_WORKFLOWS_HOST = "https://workflows.deepmodeling.com"
+DEFAULT_BOHRIUM_DFLOW_CONFIG = {
+    "dflow_host": BOHRIUM_WORKFLOWS_HOST,
+    "k8s_api_server": BOHRIUM_WORKFLOWS_HOST,
+    "batch_type": "Bohrium",
+    "context_type": "Bohrium",
+}
+
+
+def _drop_none(data: dict[str, Any]) -> dict[str, Any]:
+    return {key: value for key, value in data.items() if value is not None}
+
+
+def _deep_update(base: dict[str, Any], updates: Mapping[str, Any] | None) -> dict[str, Any]:
+    if not updates:
+        return base
+    for key, value in updates.items():
+        if isinstance(value, Mapping) and isinstance(base.get(key), dict):
+            _deep_update(base[key], value)
+        else:
+            base[key] = deepcopy(value)
+    return base
+
+
+def _load_apex_account_config() -> dict[str, Any]:
+    """Read APEX account defaults if present, without importing APEX."""
+    account_path = Path(os.environ.get("APEX_ACCOUNT_FILE", Path.home() / ".apex" / "account.json")).expanduser()
+    if not account_path.is_file():
+        return {}
+    try:
+        return json.loads(account_path.read_text(encoding="utf-8"))
+    except json.JSONDecodeError:
+        return {}
+
+
+def _bohrium_config(config: Mapping[str, Any]) -> dict[str, Any]:
+    bohrium = deepcopy(config.get("bohrium", {}))
+    account = _load_apex_account_config()
+    merged: dict[str, Any] = {}
+    _deep_update(merged, account)
+    _deep_update(merged, bohrium)
+    env_map = {
+        "email": os.environ.get("BOHRIUM_EMAIL") or os.environ.get("BOHRIUM_USERNAME"),
+        "password": os.environ.get("BOHRIUM_PASSWORD") or os.environ.get("BOHRIUM_TOKEN"),
+        "program_id": os.environ.get("BOHRIUM_PROGRAM_ID") or os.environ.get("BOHRIUM_PROJECT_ID"),
+        "phone": os.environ.get("BOHRIUM_PHONE"),
+    }
+    _deep_update(merged, _drop_none(env_map))
+    if merged.get("program_id") not in (None, ""):
+        try:
+            merged["program_id"] = int(merged["program_id"])
+        except (TypeError, ValueError):
+            pass
+    return merged
+
+
+def bohrium_credentials_available(config: Mapping[str, Any]) -> bool:
+    if not config.get("bohrium", {}).get("enabled", True):
+        return False
+    bohrium = _bohrium_config(config)
+    return bool(
+        (bohrium.get("email") or bohrium.get("phone"))
+        and bohrium.get("password")
+        and bohrium.get("program_id") not in (None, "")
+    )
+
+
+def build_executor_metadata(config: Mapping[str, Any]) -> dict[str, Any]:
+    bohrium = config.get("bohrium", {})
+    return {
+        "executor": bohrium.get("executor", "bohrium"),
+        "machine_type": bohrium.get("machine_type", "auto"),
+        "scass_type": bohrium.get("scass_type") or bohrium.get("machine_type", "auto"),
+        "image": bohrium.get("image"),
+        "vasp_command": bohrium.get("vasp_command", "vasp_std"),
+    }
+
+
+def build_dflow_runtime_config(config: Mapping[str, Any]) -> dict[str, Any]:
+    dflow_cfg = config.get("dflow", {})
+    host = dflow_cfg.get("host") or os.environ.get("DFLOW_HOST")
+    if not host and config.get("bohrium", {}).get("enabled", True):
+        host = BOHRIUM_WORKFLOWS_HOST
+    runtime = {
+        "host": host,
+        "k8s_api_server": dflow_cfg.get("k8s_api_server") or host,
+        "namespace": dflow_cfg.get("namespace"),
+        "mode": dflow_cfg.get("mode", "default"),
+        "debug_copy_method": dflow_cfg.get("debug_copy_method", "copy"),
+        "debug_pool_workers": dflow_cfg.get("debug_pool_workers", 1),
+        "debug_workdir": dflow_cfg.get("debug_workdir"),
+    }
+    _deep_update(runtime, dflow_cfg.get("dflow_config"))
+    return _drop_none(runtime)
+
+
+def build_bohrium_plugin_config(config: Mapping[str, Any]) -> dict[str, Any]:
+    bohrium = _bohrium_config(config)
+    return _drop_none(
+        {
+            "username": bohrium.get("email"),
+            "phone": bohrium.get("phone"),
+            "password": bohrium.get("password"),
+            "project_id": bohrium.get("program_id"),
+        }
+    )
+
+
+def build_bohrium_machine_dict(config: Mapping[str, Any]) -> dict[str, Any]:
+    bohrium = _bohrium_config(config)
+    context_type = bohrium.get("context_type") or config.get("dflow", {}).get("context_type") or "Bohrium"
+    batch_type = bohrium.get("batch_type") or config.get("dflow", {}).get("batch_type") or "Bohrium"
+    scass_type = bohrium.get("scass_type") or bohrium.get("machine_type")
+    machine = {
+        "batch_type": batch_type,
+        "context_type": context_type,
+        "remote_profile": {
+            "email": bohrium.get("email"),
+            "password": bohrium.get("password"),
+            "program_id": bohrium.get("program_id"),
+            "input_data": {
+                "job_type": bohrium.get("job_type", "container"),
+                "platform": bohrium.get("platform", "ali"),
+                "scass_type": scass_type,
+            },
+        },
+    }
+    _deep_update(machine, bohrium.get("machine"))
+    return machine
+
+
+def sanitized_bohrium_metadata(config: Mapping[str, Any]) -> dict[str, Any]:
+    bohrium = _bohrium_config(config)
+    return {
+        "host": build_dflow_runtime_config(config).get("host"),
+        "context_type": bohrium.get("context_type", "Bohrium"),
+        "batch_type": bohrium.get("batch_type", "Bohrium"),
+        "program_id": bohrium.get("program_id"),
+        "email": bohrium.get("email"),
+        "has_password": bool(bohrium.get("password")),
+        "scass_type": bohrium.get("scass_type") or bohrium.get("machine_type"),
+    }
