+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any, Iterable
+
+from ai_ready_db.chemistry.functionals import analyze_functional_metadata
+from ai_ready_db.chemistry.elements import DEFAULT_TRANSITION_METALS, has_transition_metal
+from ai_ready_db.core.hashing import compute_structure_hash, generate_record_id
+from ai_ready_db.core.stress import normalize_stress, virial_from_stress
+
+
+def _require_ase():
+    try:
+        from ase import Atoms
+        from ase.io import read, write
+    except ModuleNotFoundError as exc:
+        raise RuntimeError("ASE conversion requires `ase`. Install ai-ready-db dependencies.") from exc
+    return Atoms, read, write
+
+
+def ase_atoms_to_structure_dict(atoms: Any) -> dict[str, Any]:
+    cell = atoms.cell.array.tolist()
+    scaled = atoms.get_scaled_positions().tolist()
+    symbols = atoms.get_chemical_symbols()
+    return {
+        "lattice": {"matrix": cell, "volume": float(atoms.get_volume())},
+        "sites": [
+            {"species": [{"element": symbol, "occu": 1}], "abc": [float(x) for x in abc]}
+            for symbol, abc in zip(symbols, scaled)
+        ],
+    }
+
+
+def _composition(symbols: Iterable[str]) -> dict[str, float]:
+    counts: dict[str, float] = {}
+    for symbol in symbols:
+        counts[symbol] = counts.get(symbol, 0.0) + 1.0
+    return counts
+
+
+def _reduced_formula(composition: dict[str, float]) -> str:
+    from ai_ready_db.core.normalization import reduced_formula_from_composition
+
+    return reduced_formula_from_composition(composition)
+
+
+def _serializable_info(info: dict[str, Any]) -> dict[str, Any]:
+    out: dict[str, Any] = {}
+    for key, value in info.items():
+        if hasattr(value, "tolist"):
+            out[key] = value.tolist()
+        else:
+            out[key] = value
+    return out
+
+
+def _json_info_for_extxyz(info: dict[str, Any]) -> dict[str, Any]:
+    out: dict[str, Any] = {}
+    for key, value in info.items():
+        if isinstance(value, (dict, list)):
+            if key == "stress":
+                out[key] = __import__("numpy").array(value, dtype=float)
+            else:
+                out[f"ai_json_{key}"] = json.dumps(value, sort_keys=True, default=str)
+        else:
+            out[key] = value
+    return out
+
+
+def _restore_json_info(info: dict[str, Any]) -> dict[str, Any]:
+    restored: dict[str, Any] = {}
+    for key, value in info.items():
+        if key.startswith("ai_json_"):
+            try:
+                restored[key.removeprefix("ai_json_")] = json.loads(value)
+            except (TypeError, json.JSONDecodeError):
+                restored[key.removeprefix("ai_json_")] = value
+        else:
+            restored[key] = value
+    return restored
+
+
+def material_record_from_ase_atoms(
+    atoms: Any,
+    source_dataset: str = "ase",
+    source_id: str | None = None,
+    transition_metals: set[str] | None = None,
+):
+    from ai_ready_db.core.material_record import MaterialRecord
+
+    info = _restore_json_info(_serializable_info(dict(atoms.info)))
+    symbols = atoms.get_chemical_symbols()
+    composition = _composition(symbols)
+    elements = sorted(composition)
+    formula_reduced = str(info.get("formula_reduced") or _reduced_formula(composition))
+    source_id = str(source_id or info.get("source_id") or info.get("record_id") or info.get("sid") or "ase-0")
+    structure = ase_atoms_to_structure_dict(atoms)
+    stress_unit = str(info.get("stress_unit") or info.get("original_stress_unit") or "eV/Angstrom^3")
+    stress_convention = str(info.get("stress_convention") or "unknown")
+    raw_stress = info.get("stress")
+    try:
+        raw_stress = atoms.get_stress(voigt=True).tolist() if raw_stress is None else raw_stress
+    except Exception:
+        pass
+    provenance = dict(info.get("provenance") or {})
+    stress, provenance = normalize_stress(raw_stress, stress_unit, stress_convention, provenance)
+    functional = info.get("functional") or info.get("xc") or info.get("run_type")
+    calculation_parameters = dict(info.get("calculation_parameters") or {})
+    source_metadata = dict(info.get("source_metadata") or {})
+    source_metadata.update({k: v for k, v in info.items() if k not in {"source_metadata", "calculation_parameters", "provenance"}})
+    dft_payload = {"functional": functional, "calculation_parameters": calculation_parameters, "source_metadata": source_metadata}
+    functional_metadata = analyze_functional_metadata(dft_payload)
+    has_hubbard_u = functional_metadata["has_hubbard_u"]
+    hubbard_u = functional_metadata["hubbard_u"]
+    structure_hash = compute_structure_hash(structure, formula_reduced, elements, len(atoms))
+    energy = info.get("energy")
+    if energy is None:
+        try:
+            energy = atoms.get_potential_energy()
+        except Exception:
+            energy = None
+    energy = float(energy) if energy is not None else None
+    forces = None
+    if "forces" in atoms.arrays:
+        forces = atoms.arrays["forces"].tolist()
+    else:
+        try:
+            forces = atoms.get_forces().tolist()
+        except Exception:
+            forces = None
+    calculation_type = info.get("calculation_type") or info.get("task_type")
+    record_id = str(info.get("record_id") or generate_record_id(source_dataset, source_id, structure_hash, energy, functional, has_hubbard_u, calculation_type))
+    tm_set = transition_metals or DEFAULT_TRANSITION_METALS
+    record = MaterialRecord(
+        record_id=record_id,
+        source_dataset=source_dataset,
+        source_id=source_id,
+        structure=structure,
+        formula_pretty=str(info.get("formula_pretty") or atoms.get_chemical_formula()),
+        formula_reduced=formula_reduced,
+        composition=composition,
+        elements=elements,
+        nsites=len(atoms),
+        volume=float(atoms.get_volume()) if atoms.cell.rank == 3 else None,
+        density=None,
+        structure_hash=structure_hash,
+        energy=energy,
+        energy_per_atom=energy / len(atoms) if energy is not None and len(atoms) else None,
+        forces=forces,
+        stress=stress,
+        stress_unit="eV/Angstrom^3" if stress is not None else None,
+        stress_convention=stress_convention,
+        virial=virial_from_stress(stress, float(atoms.get_volume()) if atoms.cell.rank == 3 else None),
+        virial_unit="eV" if stress is not None and atoms.cell.rank == 3 else None,
+        magmom=atoms.arrays.get("magmoms").tolist() if "magmoms" in atoms.arrays else info.get("magmom"),
+        charge=atoms.arrays.get("charges").tolist() if "charges" in atoms.arrays else info.get("charge"),
+        functional=str(functional) if functional is not None else None,
+        hubbard_u=hubbard_u if has_hubbard_u else None,
+        has_transition_metal=has_transition_metal(elements, tm_set),
+        calculation_type=str(calculation_type) if calculation_type is not None else None,
+        calculation_parameters=calculation_parameters,
+        source_metadata=source_metadata,
+        screening=dict(info.get("screening") or {}),
+        provenance={**provenance, "source_dataset": source_dataset, "source_id": source_id},
+        trajectory_id=info.get("trajectory_id"),
+        frame_index=int(info["frame_index"]) if info.get("frame_index") is not None else None,
+        parent_structure_id=info.get("parent_structure_id"),
+        sampling_type=info.get("sampling_type"),
+    )
+    if record.has_transition_metal and record.has_hubbard_u:
+        record.source_metadata["recalc_label"] = "need_to_recal"
+    return record
+
+
+def material_record_to_ase_atoms(record: Any):
+    Atoms, _, _ = _require_ase()
+    symbols: list[str] = []
+    scaled: list[list[float]] = []
+    cell = record.structure.get("lattice", {}).get("matrix") if isinstance(record.structure.get("lattice"), dict) else None
+    for site in record.structure.get("sites", []):
+        species = site.get("species") or []
+        symbol = species[0].get("element") if species and isinstance(species[0], dict) else site.get("label")
+        symbols.append(str(symbol))
+        scaled.append(site.get("abc") or [0.0, 0.0, 0.0])
+    atoms = Atoms(symbols=symbols, scaled_positions=scaled, cell=cell, pbc=True)
+    info = {
+        "record_id": record.record_id,
+        "source_dataset": record.source_dataset,
+        "source_id": record.source_id,
+        "formula_reduced": record.formula_reduced,
+        "energy": record.energy,
+        "energy_per_atom": record.energy_per_atom,
+        "functional": record.functional,
+        "hubbard_u": record.hubbard_u or {},
+        "source_metadata": record.source_metadata,
+        "calculation_parameters": record.calculation_parameters,
+        "provenance": record.provenance,
+        "stress": record.stress,
+        "stress_unit": record.stress_unit,
+        "stress_convention": record.stress_convention,
+        "trajectory_id": record.trajectory_id,
+        "frame_index": record.frame_index,
+        "parent_structure_id": record.parent_structure_id,
+        "sampling_type": record.sampling_type,
+    }
+    atoms.info.update(_json_info_for_extxyz({k: v for k, v in info.items() if v is not None}))
+    if record.forces is not None:
+        atoms.arrays["forces"] = __import__("numpy").array(record.forces, dtype=float)
+    return atoms
+
+
+def write_extxyz(records: list[Any], path: str | Path) -> Path:
+    _, _, write = _require_ase()
+    atoms_list = [material_record_to_ase_atoms(record) for record in records]
+    output = Path(path)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    write(str(output), atoms_list, format="extxyz")
+    return output
+
+
+def read_extxyz(path: str | Path, source_dataset: str = "extxyz") -> list[Any]:
+    _, read, _ = _require_ase()
+    atoms_items = read(str(path), index=":", format="extxyz")
+    return [material_record_from_ase_atoms(atoms, source_dataset=source_dataset) for atoms in atoms_items]
