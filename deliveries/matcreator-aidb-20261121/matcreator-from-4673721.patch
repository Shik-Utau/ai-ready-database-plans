+from __future__ import annotations
+
+from collections import Counter
+from pathlib import Path
+from typing import Any
+
+from .local.local_ase_db import write_atoms_record
+from .metadata import normalize_metadata, validate_metadata
+from .vasp_io import parse_vasp_outputs
+
+
+def finalize_dft_results(work_dir: str | Path, local_db_path: str | Path, config: Any) -> dict[str, Any]:
+    root = Path(work_dir)
+    folders = sorted({path.parent for path in root.rglob("vasprun.xml")})
+    skipped = Counter()
+    inserted = 0
+    successful = 0
+    failed = 0
+    for folder in folders:
+        try:
+            parsed = parse_vasp_outputs(folder)
+            metadata = normalize_metadata({**parsed["metadata"], "system_type": getattr(config, "system_type", None)}, parsed["atoms"], parsed["data"])
+            validate_metadata(metadata)
+            if metadata["calculation_status"] != "finished" or metadata["data_quality"] != "valid":
+                failed += 1
+                skipped["not converged or invalid"] += 1
+                continue
+            write_atoms_record(local_db_path, parsed["atoms"], metadata, parsed["data"])
+            successful += 1
+            inserted += 1
+        except Exception as exc:  # noqa: BLE001
+            failed += 1
+            skipped[str(exc)] += 1
+    return {
+        "folders_scanned": len(folders),
+        "successful_calculations": successful,
+        "failed_calculations": failed,
+        "records_inserted": inserted,
+        "records_skipped": sum(skipped.values()),
+        "skipped_reasons": dict(skipped),
+    }
