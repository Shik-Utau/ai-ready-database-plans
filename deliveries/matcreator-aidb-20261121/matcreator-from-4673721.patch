@@ -0,0 +1,55 @@
+from __future__ import annotations
+
+from typing import Any
+
+KBAR_TO_EV_PER_ANG3 = 0.0006241509125883258
+GPA_TO_EV_PER_ANG3 = 0.006241509125883258
+
+
+def _scale_for_unit(unit: str | None) -> float:
+    normalized = (unit or "ev/angstrom^3").strip().lower().replace("å", "a")
+    normalized = normalized.replace("ang^3", "angstrom^3").replace("a^3", "angstrom^3")
+    if normalized in {"ev/angstrom^3", "ev/a^3", "ev/ang3", "ev/angstrom3"}:
+        return 1.0
+    if normalized in {"kbar", "kbars"}:
+        return KBAR_TO_EV_PER_ANG3
+    if normalized in {"gpa"}:
+        return GPA_TO_EV_PER_ANG3
+    raise ValueError(f"Unsupported stress unit: {unit}")
+
+
+def _map_numeric(value: Any, scale: float) -> Any:
+    if isinstance(value, list):
+        return [_map_numeric(item, scale) for item in value]
+    if isinstance(value, tuple):
+        return [_map_numeric(item, scale) for item in value]
+    return float(value) * scale
+
+
+def normalize_stress(
+    stress: Any,
+    unit: str | None = None,
+    convention: str | None = None,
+    provenance: dict[str, Any] | None = None,
+) -> tuple[Any, dict[str, Any]]:
+    """Normalize stress-like data to eV/Angstrom^3.
+
+    The sign convention is recorded but not flipped automatically. Datasets vary
+    between stress and virial definitions, so sign changes should be explicit in
+    source-specific loaders.
+    """
+    if stress is None:
+        return None, provenance or {}
+    scale = _scale_for_unit(unit)
+    updated = dict(provenance or {})
+    updated["original_stress_unit"] = unit or "eV/Angstrom^3"
+    updated["original_stress_convention"] = convention or "unknown"
+    updated["normalized_stress_unit"] = "eV/Angstrom^3"
+    updated["normalized_stress_convention"] = convention or "unknown"
+    return _map_numeric(stress, scale), updated
+
+
+def virial_from_stress(stress_ev_per_ang3: Any, volume_ang3: float | None) -> Any:
+    if stress_ev_per_ang3 is None or volume_ang3 is None:
+        return None
+    return _map_numeric(stress_ev_per_ang3, -float(volume_ang3))
diff --git a/delivery/vendor/ai-ready-db/ai_ready_db/core/tags.py b/delivery/vendor/ai-ready-db/ai_ready_db/core/tags.py
