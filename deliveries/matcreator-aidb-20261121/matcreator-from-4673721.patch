+++ b/delivery/vendor/ai-ready-db/ai_ready_db/ai_ready_db_Renaissance/local/local_workspace.py
@@ -0,0 +1,142 @@
+from __future__ import annotations
+
+import os
+from pathlib import Path
+from typing import Any
+
+from ai_ready_db.ai_ready_db_Renaissance.local.local_converters import (
+    atoms_to_material_record,
+    build_key_value_pairs,
+    material_record_to_atoms,
+    sidecar_payload_from_record,
+)
+from ai_ready_db.ai_ready_db_Renaissance.local.sidecar import SidecarStore
+from ai_ready_db.core.material_record import MaterialRecord
+
+TRAINABLE_NAMESPACES = {"bulk_base_pbe", "bulk_dft_u_archive", "fine_tune_working"}
+ASE_RESERVED_RESULT_KEYS = {"energy", "energy_per_atom"}
+
+
+class LocalASEWorkspace:
+    def __init__(self, config: dict):
+        self.config = config
+        ase_cfg = config.get("ase_sqlite", config.get("local_database", {}))
+        self.path = Path(ase_cfg.get("path", "data/ai_ready_materials.db"))
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self.sidecar = SidecarStore(ase_cfg.get("json_sidecar_path", "data/ai_ready_materials.sidecar.json"))
+
+    def _connect(self):
+        try:
+            from ase.db import connect
+        except ModuleNotFoundError as exc:
+            raise RuntimeError("Local ASE workspace requires `ase`.") from exc
+        return connect(str(self.path))
+
+    @staticmethod
+    def _enforce_namespace(record: MaterialRecord, namespace: str, export: bool = False) -> None:
+        if namespace == "bulk_base_pbe" and record.has_hubbard_u:
+            raise ValueError("namespace bulk_base_pbe requires has_hubbard_u=false")
+        if namespace == "bulk_dft_u_archive" and not record.has_hubbard_u:
+            raise ValueError("namespace bulk_dft_u_archive requires has_hubbard_u=true")
+        if export and namespace in {"rejected_records", "workflow"}:
+            raise ValueError(f"namespace {namespace} cannot be exported for training")
+
+    def write_record(self, record: MaterialRecord, namespace: str, origin: str, sync_status: str) -> str:
+        self._enforce_namespace(record, namespace)
+        sidecar_id = self.sidecar.put(record.record_id, sidecar_payload_from_record(record))
+        atoms = material_record_to_atoms(record)
+        kv = build_key_value_pairs(record, namespace, origin, sync_status, sidecar_id, self.config)
+        ase_kv = {key: value for key, value in kv.items() if key not in ASE_RESERVED_RESULT_KEYS}
+        with self._connect() as db:
+            for row in db.select(record_id=record.record_id):
+                db.delete([row.id])
+            db.write(atoms, key_value_pairs=ase_kv, data={"sidecar_id": sidecar_id, "query_payload": kv})
+        return record.record_id
+
+    def _row_to_record(self, row: Any) -> MaterialRecord:
+        sidecar_id = row.get("sidecar_id") or (row.data or {}).get("sidecar_id")
+        payload = self.sidecar.get(sidecar_id) if sidecar_id else None
+        record = atoms_to_material_record(row.toatoms(), payload)
+        for key in ("record_id", "source_dataset", "source_id", "formula_reduced", "functional", "calculation_type"):
+            if hasattr(row, key) and getattr(row, key):
+                setattr(record, key, getattr(row, key))
+        record.energy = getattr(row, "energy", record.energy) if hasattr(row, "energy") else record.energy
+        record.energy_per_atom = getattr(row, "energy_per_atom", record.energy_per_atom) if hasattr(row, "energy_per_atom") else record.energy_per_atom
+        record.has_transition_metal = bool(getattr(row, "has_transition_metal", record.has_transition_metal))
+        record.source_metadata["logical_namespace"] = getattr(row, "logical_namespace", record.source_metadata.get("logical_namespace", ""))
+        record.source_metadata["origin"] = getattr(row, "origin", record.source_metadata.get("origin", ""))
+        record.source_metadata["sync_status"] = getattr(row, "sync_status", record.source_metadata.get("sync_status", ""))
+        record.source_metadata["sidecar_id"] = sidecar_id
+        record.sampling_type = getattr(row, "sampling_type", record.sampling_type) if hasattr(row, "sampling_type") else record.sampling_type
+        record.trajectory_id = getattr(row, "trajectory_id", record.trajectory_id) if hasattr(row, "trajectory_id") else record.trajectory_id
+        frame_index = getattr(row, "frame_index", None) if hasattr(row, "frame_index") else None
+        record.frame_index = int(frame_index) if frame_index is not None and int(frame_index) >= 0 else record.frame_index
+        return record
+
+    def get_record(self, record_id: str) -> MaterialRecord | None:
+        with self._connect() as db:
+            rows = list(db.select(record_id=record_id, limit=1))
+            return self._row_to_record(rows[0]) if rows else None
+
+    def select_records(self, filters: dict) -> list[MaterialRecord]:
+        with self._connect() as db:
+            rows = list(db.select())
+            records = [self._row_to_record(row) for row in rows]
+            out = []
+            for record, row in zip(records, rows):
+                ok = True
+                for key, expected in filters.items():
+                    value = getattr(row, key, getattr(record, key, None))
+                    if value != expected:
+                        ok = False
+                        break
+                if ok:
+                    out.append(record)
+            return out
+
+    def count(self, namespace: str | None = None) -> int:
+        with self._connect() as db:
+            if namespace is None:
+                return len(list(db.select()))
+            return len(list(db.select(logical_namespace=namespace)))
+
+    def delete_record(self, record_id: str) -> None:
+        with self._connect() as db:
+            rows = list(db.select(record_id=record_id))
+            for row in rows:
+                sidecar_id = row.get("sidecar_id") or (row.data or {}).get("sidecar_id")
+                if sidecar_id:
+                    self.sidecar.delete(sidecar_id)
+                db.delete([row.id])
+
+    def update_sync_status(self, record_id: str, sync_status: str, cloud_record_id: str | None = None) -> None:
+        with self._connect() as db:
+            rows = list(db.select(record_id=record_id, limit=1))
+            if not rows:
+                raise KeyError(f"Local record not found: {record_id}")
+            row = rows[0]
+            sidecar_id = row.get("sidecar_id") or (row.data or {}).get("sidecar_id")
+            if sidecar_id and cloud_record_id:
+                self.sidecar.update(sidecar_id, {"cloud_record_id": cloud_record_id})
+            updates = {"sync_status": sync_status}
+            if cloud_record_id:
+                updates["cloud_record_id"] = cloud_record_id
+            db.update(row.id, **updates)
+
+    def export_records(self, record_ids: list[str], output_path: str, format: str = "extxyz") -> str:
+        from ai_ready_db.ai_ready_db_Renaissance.local.local_export import export_local_records
+
+        records = []
+        namespaces = {}
+        with self._connect() as db:
+            for record_id in record_ids:
+                rows = list(db.select(record_id=record_id, limit=1))
+                if not rows:
+                    continue
+                namespace = getattr(rows[0], "logical_namespace", None)
+                record = self._row_to_record(rows[0])
+                self._enforce_namespace(record, namespace, export=True)
+                records.append(record)
+                namespaces[record.record_id] = namespace
+        result = export_local_records(records, output_path, format=format, config=self.config, namespaces=namespaces)
+        return os.fspath(result["output_path"])
