+from __future__ import annotations
+
+from dataclasses import asdict, dataclass, field
+from typing import Any
+
+from ai_ready_db.core.classification import FourLayerClassification
+from ai_ready_db.core.dft_defaults import DFTProfile
+
+
+@dataclass(frozen=True)
+class CloudNamespace:
+    name: str
+    layer_path: str
+    upload_eligible: bool
+    tags: list[str] = field(default_factory=list)
+    reason: str = ""
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def route_record_to_cloud_namespace(
+    classification: FourLayerClassification,
+    dft_profile: DFTProfile,
+) -> CloudNamespace:
+    tags = sorted(set(classification.tags + dft_profile.tags + classification.special_reasons))
+    layer_path = "/".join(
+        [
+            classification.software,
+            classification.xc_functional,
+            classification.model_type,
+            classification.prototype,
+        ]
+    )
+    if dft_profile.is_clean_default_pbe and classification.model_type.lower() in {"bulk", "unknown"} and not classification.special_reasons:
+        return CloudNamespace(
+            name="bulk_base_pbe",
+            layer_path=layer_path,
+            upload_eligible=True,
+            tags=tags + ["clean_pbe_base"],
+            reason="clean reusable PBE single-point non-spin bulk-compatible record",
+        )
+    if dft_profile.dft_u or "+U" in classification.xc_functional.upper():
+        return CloudNamespace(
+            name="pbe_plus_u_archive",
+            layer_path=layer_path,
+            upload_eligible=True,
+            tags=tags + ["pbe_plus_u"],
+            reason="DFT+U records are separated from clean PBE base",
+        )
+    if dft_profile.dispersion or "+D3" in classification.xc_functional.upper():
+        return CloudNamespace(
+            name="pbe_d3_archive",
+            layer_path=layer_path,
+            upload_eligible=True,
+            tags=tags + ["pbe_d3"],
+            reason="dispersion-corrected records are separated from clean PBE base",
+        )
+    return CloudNamespace(
+        name="special_settings_archive",
+        layer_path=layer_path,
+        upload_eligible=True,
+        tags=tags + ["special_settings"],
+        reason="record uses spin, non-bulk model, relaxation, trajectory, or other non-default settings",
+    )
