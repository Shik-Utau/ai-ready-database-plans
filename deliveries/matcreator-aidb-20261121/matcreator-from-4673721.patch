+    "omat24": OMat24Loader,
+    "salex": SAlexLoader,
+    "mptrj": MPtrjLoader,
+    "generic_jsonl": GenericJsonlLoader,
+}
+
+
+def _iter_enabled_records(config: Mapping[str, Any], workflow_repo: Any | None = None, ingest_run_id: str | None = None) -> list[MaterialRecord]:
+    records: list[MaterialRecord] = []
+    transition_metals = set(config.get("dft_policy", {}).get("transition_metals") or [])
+    for name, dataset_cfg in (config.get("datasets") or {}).items():
+        if not dataset_cfg.get("enabled", False):
+            continue
+        path = dataset_cfg.get("path")
+        if not path:
+            LOGGER.warning("Skipping dataset %s because no path is configured", name)
+            continue
+        loader_key = name if name in LOADER_CLASSES else "generic_jsonl"
+        if dataset_cfg.get("format") == "jsonl":
+            loader_key = "generic_jsonl"
+        loader_cls = LOADER_CLASSES[loader_key]
+        loader_config = dict(dataset_cfg)
+        loader_config["transition_metals"] = transition_metals
+        LOGGER.info("Loading %s records from %s with %s", name, path, loader_cls.__name__)
+        try:
+            for record in loader_cls(path, name, loader_config).iter_records():
+                assign_structure_tags(record)
+                record.ingest_run_id = ingest_run_id
+                records.append(record)
+        except Exception as exc:
+            LOGGER.exception("Failed to load dataset %s from %s", name, path)
+            if workflow_repo is not None:
+                workflow_repo.insert_rejected_record(
+                    rejection_stage="parser",
+                    rejection_reason=str(exc),
+                    record_json={"dataset": name, "path": str(path)},
+                    ingest_run_id=ingest_run_id,
+                    source_dataset=name,
+                )
+    return records
+
+
+def _candidate_from_record(record: MaterialRecord, config: Mapping[str, Any]) -> dict[str, Any]:
+    job_root = Path(config.get("vasp", {}).get("job_root", "outputs/recalc_jobs"))
+    recommended_job_dir = job_root / record.source_dataset / record.record_id
+    return {
+        "original_dft_u_record_id": record.record_id,
+        "source_dataset": record.source_dataset,
+        "source_id": record.source_id,
+        "formula_reduced": record.formula_reduced,
+        "elements": record.elements,
+        "structure": record.structure,
+        "composition": record.composition,
+        "nsites": record.nsites,
+        "original_hubbard_u": record.hubbard_u or {},
+        "target_functional": config.get("dft_policy", {}).get("clean_functional", "PBE"),
+        "target_disable_ldau": True,
+        "recommended_job_dir": str(recommended_job_dir),
+    }
+
+
+def ingest_base_database(config_or_path: Mapping[str, Any] | str, database: Any) -> dict[str, Any]:
+    config = load_config(config_or_path) if isinstance(config_or_path, str) else dict(config_or_path)
+    repos = repository_bundle(config, database)
+    clean_repo = repos.clean
+    dft_repo = repos.dft_u
+    job_repo = repos.recalc_jobs
+
+    workflow_repo = repos.workflow
+    ingest_run_id = None
+    if workflow_repo is not None:
+        ingest_run_id = workflow_repo.create_ingest_run(stable_digest(config), __version__, source_summary=dict(config.get("datasets") or {}))
+    records = _iter_enabled_records(config, workflow_repo, ingest_run_id)
+    classified = classify_records_for_cloud(records)
+    accepted_classified, screening_report = screen_classified_records(classified, config.get("screening", {}))
+    clean_candidates = [item.record for item in classified if item.namespace["name"] == "bulk_base_pbe"]
+    accepted_clean = [item.record for item in accepted_classified if item.namespace["name"] == "bulk_base_pbe"]
+    dft_u_records = [item.record for item in accepted_classified if item.namespace["name"] == "pbe_plus_u_archive"]
+    pbe_d3_records = [item.record for item in accepted_classified if item.namespace["name"] == "pbe_d3_archive"]
+    special_records = [item.record for item in accepted_classified if item.namespace["name"] == "special_settings_archive"]
+    if workflow_repo is not None:
+        for record in clean_candidates:
+            if not record.screening.get("accepted"):
+                workflow_repo.insert_rejected_record(
+                    rejection_stage="screening",
+                    rejection_reason=str(record.screening.get("reason")),
+                    record_json=record.to_dict(),
+                    ingest_run_id=ingest_run_id,
+                    source_dataset=record.source_dataset,
+                    source_id=record.source_id,
+                )
+
+    inserted_clean = 0
+    for record in accepted_clean:
+        clean_repo.insert_clean_record(record)
+        inserted_clean += 1
+
+    inserted_pbe_d3 = 0
+    inserted_special = 0
+    if repos.routed is not None:
+        for record in pbe_d3_records:
+            repos.routed.insert_routed_record(record)
+            inserted_pbe_d3 += 1
+        for record in special_records:
+            repos.routed.insert_routed_record(record)
+            inserted_special += 1
+
+    recalc_candidates: list[dict[str, Any]] = []
+    recalc_enabled = bool(config.get("dft_policy", {}).get("recalc_transition_metal_dft_u_without_u", True))
+    for record in dft_u_records:
+        dft_repo.insert_dft_u_record(record)
+        if record.has_transition_metal and recalc_enabled:
+            record.source_metadata["recalc_label"] = "need_to_recal"
+            candidate = _candidate_from_record(record, config)
+            job_repo.create_or_get_job(candidate)
+            dft_repo.update_recalc_status(record.record_id, "pending")
+            recalc_candidates.append(candidate)
+        else:
+            dft_repo.update_recalc_status(record.record_id, "not_required")
+
+    outputs = config.get("outputs", {})
+    export_screening_report(
+        clean_candidates,
+        screening_report,
+        outputs.get("screening_report_json", "outputs/screening_report.json"),
+        outputs.get("screening_report_csv", "outputs/screening_report.csv"),
+    )
+    export_recalc_candidates(
+        recalc_candidates,
+        outputs.get("recalc_candidates_jsonl", "outputs/recalc_candidates.jsonl"),
+        outputs.get("recalc_candidates_csv", "outputs/recalc_candidates.csv"),
+    )
+    result = {
+        "loaded_records": len(records),
+        "clean_candidates": len(clean_candidates),
+        "inserted_clean": inserted_clean,
+        "dft_u_archived": len(dft_u_records),
+        "pbe_d3_archived": inserted_pbe_d3,
+        "special_settings_archived": inserted_special,
+        "recalc_candidates": len(recalc_candidates),
+        "screening": screening_report,
+        "ingest_run_id": ingest_run_id,
+    }
+    if workflow_repo is not None and ingest_run_id is not None:
+        workflow_repo.update_ingest_run(ingest_run_id, "completed", source_summary=result)
+    return result
