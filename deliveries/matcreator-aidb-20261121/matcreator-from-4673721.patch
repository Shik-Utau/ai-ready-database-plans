index 0000000..83c019f
--- /dev/null
+++ b/delivery/vendor/ai-ready-db/ai_ready_db/ai_ready_db_Reforging/screening/bias_screen.py
@@ -0,0 +1,184 @@
+from __future__ import annotations
+
+from collections import Counter, defaultdict
+from typing import Any, Mapping
+
+from ai_ready_db.core.hashing import stable_digest
+from ai_ready_db.core.material_record import MaterialRecord
+from ai_ready_db.ai_ready_db_Reforging.screening.force_energy_bins import assign_bin, force_norms
+from ai_ready_db.ai_ready_db_Reforging.screening.similarity import lightweight_similarity_hash
+
+SCREENING_VERSION = "bias_screen_v1"
+
+
+def _deterministic_sort_key(record: MaterialRecord, seed: int) -> tuple[str, str]:
+    return stable_digest({"seed": seed, "record_id": record.record_id, "source_id": record.source_id}), record.record_id
+
+
+def _screening_config(config: Mapping[str, Any]) -> Mapping[str, Any]:
+    return config.get("screening", config) if "screening" in config else config
+
+
+def _energy_minima(records: list[MaterialRecord]) -> dict[tuple[str, str], float]:
+    minima: dict[tuple[str, str], float] = {}
+    for record in records:
+        if record.energy_per_atom is None:
+            continue
+        key = (record.source_dataset, record.formula_reduced)
+        value = float(record.energy_per_atom)
+        minima[key] = min(minima.get(key, value), value)
+    return minima
+
+
+def _annotate_records(records: list[MaterialRecord], config: Mapping[str, Any]) -> None:
+    force_cfg = config.get("force_norm_bins", {})
+    energy_cfg = config.get("energy_above_min_bins", {})
+    similarity_cfg = config.get("structure_similarity", {})
+    minima = _energy_minima(records)
+    force_bins = [float(value) for value in force_cfg.get("bins", [])]
+    energy_bins = [float(value) for value in energy_cfg.get("bins", [])]
+    round_decimals = int(similarity_cfg.get("volume_per_atom_round_decimals", 2))
+    for record in records:
+        max_force_norm, mean_force_norm = force_norms(record.forces)
+        min_energy = minima.get((record.source_dataset, record.formula_reduced))
+        delta_e = None
+        if min_energy is not None and record.energy_per_atom is not None:
+            delta_e = float(record.energy_per_atom) - min_energy
+        record.screening.update(
+            {
+                "accepted": False,
+                "reason": "not_evaluated",
+                "screening_version": SCREENING_VERSION,
+                "max_force_norm": max_force_norm,
+                "mean_force_norm": mean_force_norm,
+                "force_bin": assign_bin(max_force_norm, force_bins) if force_cfg.get("enabled", True) else None,
+                "energy_above_formula_source_min": delta_e,
+                "energy_bin": assign_bin(delta_e, energy_bins) if energy_cfg.get("enabled", True) else None,
+                "similarity_hash": lightweight_similarity_hash(record, round_decimals)
+                if similarity_cfg.get("enabled", True)
+                else None,
+            }
+        )
+
+
+def _reject(record: MaterialRecord, reason: str) -> None:
+    record.screening["accepted"] = False
+    record.screening["reason"] = reason
+
+
+def _accept(record: MaterialRecord, reason: str = "accepted") -> None:
+    record.screening["accepted"] = True
+    record.screening["reason"] = reason
+
+
+def screen_records(records: list[MaterialRecord], config: Mapping[str, Any]) -> tuple[list[MaterialRecord], dict[str, Any]]:
+    """Apply deterministic bias-reduction filters before clean-base insertion.
+
+    This is intentionally not a Boltzmann reconstruction. It is a reproducible
+    coverage-balancing filter over force bins, local energy bins, similarity
+    hashes, and source weights.
+    """
+    screening_cfg = _screening_config(config)
+    seed = int(screening_cfg.get("random_seed", 2026))
+    _annotate_records(records, screening_cfg)
+    if not screening_cfg.get("enabled", True):
+        for record in records:
+            _accept(record, "screening_disabled")
+        return records, _summary(records)
+
+    force_cfg = screening_cfg.get("force_norm_bins", {})
+    energy_cfg = screening_cfg.get("energy_above_min_bins", {})
+    similarity_cfg = screening_cfg.get("structure_similarity", {})
+    force_limit = int(force_cfg.get("max_per_bin_per_formula_per_source", 200))
+    energy_limit = int(energy_cfg.get("max_per_bin_per_formula_per_source", 200))
+    duplicate_limit = int(similarity_cfg.get("max_duplicates_per_hash", 10))
+    trajectory_limit = screening_cfg.get("max_frames_per_trajectory")
+    trajectory_limit = int(trajectory_limit) if trajectory_limit is not None else None
+
+    force_counts: Counter[tuple[str, str, str | None]] = Counter()
+    energy_counts: Counter[tuple[str, str, str | None]] = Counter()
+    similarity_counts: Counter[str | None] = Counter()
+    trajectory_counts: Counter[str] = Counter()
+    provisional: list[MaterialRecord] = []
+
+    for record in sorted(records, key=lambda rec: _deterministic_sort_key(rec, seed)):
+        if trajectory_limit is not None and record.trajectory_id:
+            if trajectory_counts[record.trajectory_id] >= trajectory_limit:
+                _reject(record, "max_frames_per_trajectory")
+                continue
+        similarity_hash = record.screening.get("similarity_hash")
+        if similarity_cfg.get("enabled", True) and similarity_counts[similarity_hash] >= duplicate_limit:
+            _reject(record, "duplicate_similarity_hash_limit")
+            continue
+        force_key = (record.source_dataset, record.formula_reduced, record.screening.get("force_bin"))
+        if force_cfg.get("enabled", True) and force_counts[force_key] >= force_limit:
+            _reject(record, "force_bin_limit")
+            continue
+        energy_key = (record.source_dataset, record.formula_reduced, record.screening.get("energy_bin"))
+        if energy_cfg.get("enabled", True) and energy_counts[energy_key] >= energy_limit:
+            _reject(record, "energy_bin_limit")
+            continue
+        similarity_counts[similarity_hash] += 1
+        force_counts[force_key] += 1
+        energy_counts[energy_key] += 1
+        if record.trajectory_id:
+            trajectory_counts[record.trajectory_id] += 1
+        provisional.append(record)
+
+    source_balance_cfg = screening_cfg.get("source_balance", {})
+    if source_balance_cfg.get("enabled", True):
+        provisional = _apply_source_balance(provisional, source_balance_cfg, seed)
+    else:
+        for record in provisional:
+            _accept(record)
+
+    return [record for record in records if record.screening.get("accepted")], _summary(records)
+
+
+def _apply_source_balance(
+    provisional: list[MaterialRecord],
+    source_balance_cfg: Mapping[str, Any],
+    seed: int,
+) -> list[MaterialRecord]:
+    targets = {str(k): float(v) for k, v in (source_balance_cfg.get("target_source_weights") or {}).items()}
+    active_sources = {record.source_dataset for record in provisional}
+    if len(active_sources) < 2:
+        for record in provisional:
+            _accept(record)
+        return provisional
+    total = len(provisional)
+    caps = {
+        source: max(1, int(total * targets.get(source, 1.0) * 1.05 + 0.999999))
+        for source in active_sources
+    }
+    source_counts: Counter[str] = Counter()
+    accepted: list[MaterialRecord] = []
+    for record in sorted(provisional, key=lambda rec: _deterministic_sort_key(rec, seed)):
+        source = record.source_dataset
+        record.screening["source_balance_group"] = source
+        if source_counts[source] >= caps[source]:
+            _reject(record, "source_balance_limit")
+            continue
+        source_counts[source] += 1
+        _accept(record)
+        accepted.append(record)
+    return accepted
+
+
+def _summary(records: list[MaterialRecord]) -> dict[str, Any]:
+    accepted = [record for record in records if record.screening.get("accepted")]
+    rejected = [record for record in records if not record.screening.get("accepted")]
+    reason_counts = Counter(str(record.screening.get("reason")) for record in records)
+    source_counts = defaultdict(lambda: {"accepted": 0, "rejected": 0})
+    for record in records:
+        bucket = "accepted" if record.screening.get("accepted") else "rejected"
+        source_counts[record.source_dataset][bucket] += 1
+    return {
+        "screening_version": SCREENING_VERSION,
+        "description": "deterministic bias-reduction and coverage-balancing; not Boltzmann-distributed",
+        "total": len(records),
+        "accepted": len(accepted),
+        "rejected": len(rejected),
+        "reason_counts": dict(reason_counts),
+        "source_counts": dict(source_counts),
+    }
