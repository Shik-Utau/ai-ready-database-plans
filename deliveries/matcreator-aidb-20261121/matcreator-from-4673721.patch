+from __future__ import annotations
+
+from collections.abc import Iterator
+
+from ai_ready_db.datasets.generic_jsonl import GenericJsonlLoader
+from ai_ready_db.core.material_record import MaterialRecord
+
+
+class OMat24Loader(GenericJsonlLoader):
+    """OMat24 adapter.
+
+    Supports normalized JSONL plus optional FairChem ``AseDBDataset`` directories
+    such as ``.../omat24/train/rattled-relax``.
+    """
+
+    def __init__(self, path, source_dataset: str = "omat24", config=None):
+        super().__init__(path, source_dataset, config)
+
+    def iter_records(self) -> Iterator[MaterialRecord]:
+        fmt = str(self.config.get("format", "auto")).lower()
+        if fmt in {"fairchem", "ase_db", "asedb"} or (fmt == "auto" and self.path.is_dir() and not list(self.path.glob("*.jsonl"))):
+            yield from self._iter_fairchem_asedb()
+            return
+        yield from super().iter_records()
+
+    def _iter_fairchem_asedb(self) -> Iterator[MaterialRecord]:
+        try:
+            from fairchem.core.datasets import AseDBDataset
+        except ModuleNotFoundError as exc:
+            raise RuntimeError(
+                "OMat24 FairChem loading requires `fairchem-core` in the active environment. "
+                "Install it in `aidb` or set dataset format to jsonl."
+            ) from exc
+        transition_metals = set(self.config.get("transition_metals") or [])
+        config_kwargs = dict(self.config.get("fairchem_config") or {})
+        dataset = AseDBDataset(config={"src": str(self.path), **config_kwargs})
+        for index in range(len(dataset)):
+            atoms = dataset.get_atoms(index)
+            atoms.info.setdefault("source_id", f"{self.path.name}-{index}")
+            atoms.info.setdefault("source_metadata", {})
+            atoms.info["source_metadata"].update({"loader": "fairchem.AseDBDataset", "dataset_path": str(self.path), "frame_index": index})
+            atoms.info.setdefault("frame_index", index)
+            atoms.info.setdefault("sampling_type", "rattled" if "rattle" in str(self.path).lower() else None)
+            record = MaterialRecord.from_ase_atoms(
+                atoms,
+                source_dataset=self.source_dataset,
+                source_id=str(atoms.info.get("source_id")),
+                transition_metals=transition_metals or None,
+            )
+            if record.has_transition_metal and record.has_hubbard_u:
+                record.source_metadata["recalc_label"] = "need_to_recal"
+            yield record
