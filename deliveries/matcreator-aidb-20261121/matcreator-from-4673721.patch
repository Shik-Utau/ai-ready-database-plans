+from __future__ import annotations
+
+from dataclasses import asdict, dataclass, field
+from typing import Any, Mapping
+
+from ai_ready_db.core.classification import FourLayerClassification
+
+
+@dataclass(frozen=True)
+class DFTProfile:
+    software: str = "VASP"
+    xc_functional: str = "PBE"
+    dft_u: bool = False
+    dispersion: bool = False
+    spin_polarized: bool = False
+    calculation_type: str = "static_single_point"
+    nsw: int = 0
+    ibrion: int = -1
+    ldau: bool = False
+    ispin: int = 1
+    tags: list[str] = field(default_factory=list)
+    reason: str = "clean_default_pbe_single_point"
+    parameters: dict[str, Any] = field(default_factory=dict)
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+    @property
+    def is_clean_default_pbe(self) -> bool:
+        return (
+            self.software.upper() == "VASP"
+            and self.xc_functional.upper() == "PBE"
+            and not self.dft_u
+            and not self.dispersion
+            and not self.spin_polarized
+            and self.calculation_type == "static_single_point"
+            and self.nsw == 0
+            and self.ibrion == -1
+            and not self.ldau
+            and self.ispin == 1
+        )
+
+
+def get_default_dft_profile(
+    classification: FourLayerClassification,
+    user_overrides: Mapping[str, Any] | None = None,
+) -> DFTProfile:
+    overrides = dict(user_overrides or {})
+    software = str(overrides.get("software") or "VASP").upper()
+    xc = str(overrides.get("xc_functional") or overrides.get("functional") or "PBE")
+    dft_u = bool(overrides.get("dft_u", False))
+    dispersion = bool(overrides.get("dispersion", False))
+    spin = bool(overrides.get("spin_polarized", False))
+    calculation_type = str(overrides.get("calculation_type") or "static_single_point")
+    nsw = int(overrides.get("NSW", overrides.get("nsw", 0)))
+    ibrion = int(overrides.get("IBRION", overrides.get("ibrion", -1)))
+    ldau = bool(overrides.get("LDAU", overrides.get("ldau", dft_u)))
+    ispin = int(overrides.get("ISPIN", overrides.get("ispin", 2 if spin else 1)))
+
+    tags: list[str] = []
+    reason = "clean_default_pbe_single_point"
+    if software != "VASP":
+        tags.append("special_software")
+    if xc.upper() != "PBE" or dft_u or "+U" in xc.upper():
+        tags.append("special_xc_functional")
+    if dispersion or "+D3" in xc.upper():
+        tags.append("special_dispersion")
+    if spin or ispin != 1:
+        tags.append("special_spin")
+    if calculation_type != "static_single_point" or nsw != 0 or ibrion != -1:
+        tags.append("special_calculation_type")
+    if classification.model_type.lower() not in {"bulk", "unknown"}:
+        tags.append(f"special_model_type_{classification.model_type.lower()}")
+    if tags:
+        reason = "explicit_or_routed_special_dft_profile"
+
+    return DFTProfile(
+        software=software,
+        xc_functional=xc,
+        dft_u=dft_u or "+U" in xc.upper() or ldau,
+        dispersion=dispersion or "+D3" in xc.upper(),
+        spin_polarized=spin or ispin != 1,
+        calculation_type=calculation_type,
+        nsw=nsw,
+        ibrion=ibrion,
+        ldau=ldau,
+        ispin=ispin,
+        tags=sorted(set(tags)),
+        reason=reason,
+        parameters={"NSW": nsw, "IBRION": ibrion, "LDAU": ldau, "ISPIN": ispin},
+    )
+
+
+def get_dpa_special_dft_profile() -> DFTProfile:
+    return DFTProfile(
+        software="ABACUS",
+        xc_functional="PBE+D3",
+        dft_u=False,
+        dispersion=True,
+        spin_polarized=True,
+        calculation_type="relax",
+        nsw=200,
+        ibrion=2,
+        ldau=False,
+        ispin=2,
+        tags=["special_software", "special_dispersion", "special_spin", "special_calculation_type"],
+        reason="dpa_finetune_special_relaxation_profile",
+        parameters={"calculation": "relax", "dispersion": "D3", "nspin": 2},
+    )
