+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Callable
+
+from .entrypoints import (
+    ai_ready_db_accept_cloud_plan,
+    ai_ready_db_Renaissance_start,
+    ai_ready_db_finalize_dft,
+    ai_ready_db_finetune_plan,
+    ai_ready_db_reject_cloud_plan,
+)
+
+AgentHandler = Callable[[str | Path], dict[str, Any]]
+
+
+_ACTION_HANDLERS: dict[str, AgentHandler] = {
+    "renaissance_start": ai_ready_db_Renaissance_start,
+    "finalize_dft": ai_ready_db_finalize_dft,
+    "finetune_plan": ai_ready_db_finetune_plan,
+    "accept_cloud_plan": ai_ready_db_accept_cloud_plan,
+    "reject_cloud_plan": ai_ready_db_reject_cloud_plan,
+}
+
+
+def available_agent_actions() -> tuple[str, ...]:
+    """Return the stable public actions an agent may request."""
+
+    return tuple(_ACTION_HANDLERS)
+
+
+def handle_agent_action(action: str, config_path: str | Path) -> dict[str, Any]:
+    """Dispatch one agent action to the user-facing Ai-ready_db_Renaissance skill API.
+
+    This module is transport-agnostic. It is intentionally not an MCP server;
+    an MCP layer can register this function as a tool later without moving the
+    workflow logic out of the package.
+    """
+
+    try:
+        handler = _ACTION_HANDLERS[action]
+    except KeyError as exc:
+        available = ", ".join(available_agent_actions())
+        raise ValueError(f"Unknown agent action '{action}'. Available actions: {available}") from exc
+
+    result = handler(config_path)
+    return {
+        "action": action,
+        "ok": True,
+        "result": result,
+    }
