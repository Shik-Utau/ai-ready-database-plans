+from __future__ import annotations
+
+from ai_ready_db.ai_ready_db_Renaissance.local.local_workspace import LocalASEWorkspace
+from ai_ready_db.ai_ready_db_Renaissance.fine_tune_planer.target_profile import TargetProfile
+from ai_ready_db.core.material_record import MaterialRecord
+
+_DEFAULT_WORKSPACE: LocalASEWorkspace | None = None
+
+
+def set_default_workspace(workspace: LocalASEWorkspace) -> None:
+    global _DEFAULT_WORKSPACE
+    _DEFAULT_WORKSPACE = workspace
+
+
+def _workspace(workspace: LocalASEWorkspace | None = None) -> LocalASEWorkspace:
+    if workspace is not None:
+        return workspace
+    if _DEFAULT_WORKSPACE is None:
+        from ai_ready_db.config import load_config
+
+        return LocalASEWorkspace(load_config())
+    return _DEFAULT_WORKSPACE
+
+
+def query_local_by_target_profile(profile: TargetProfile, limit: int | None = None, workspace: LocalASEWorkspace | None = None) -> list[MaterialRecord]:
+    records = _workspace(workspace).select_records({"logical_namespace": "bulk_base_pbe"})
+    out = []
+    required_elements = set(profile.elements)
+    required_tags = set(profile.tags + profile.prototypes)
+    for record in records:
+        tag_names = {tag["tag"] for tag in record.tags if isinstance(tag, dict) and "tag" in tag}
+        if profile.functional and record.functional != profile.functional:
+            continue
+        if not profile.allow_dft_u and record.has_hubbard_u:
+            continue
+        if required_elements and not required_elements.issubset(set(record.elements)):
+            continue
+        if profile.formulas and record.formula_reduced not in profile.formulas:
+            continue
+        if required_tags and not required_tags.intersection(tag_names):
+            continue
+        out.append(record)
+        if limit is not None and len(out) >= limit:
+            break
+    return out
+
+
+def query_local_by_formula(formula_reduced: str, workspace: LocalASEWorkspace | None = None) -> list[MaterialRecord]:
+    return [record for record in _workspace(workspace).select_records({}) if record.formula_reduced == formula_reduced]
+
+
+def query_local_by_elements(elements: list[str], require_all: bool = True, workspace: LocalASEWorkspace | None = None) -> list[MaterialRecord]:
+    target = set(elements)
+    records = _workspace(workspace).select_records({})
+    if require_all:
+        return [record for record in records if target.issubset(set(record.elements))]
+    return [record for record in records if target.intersection(record.elements)]
+
+
+def query_local_by_tags(tags: list[str], require_all: bool = False, workspace: LocalASEWorkspace | None = None) -> list[MaterialRecord]:
+    target = set(tags)
+    out = []
+    for record in _workspace(workspace).select_records({}):
+        tag_names = {tag["tag"] for tag in record.tags if isinstance(tag, dict) and "tag" in tag}
+        if (target.issubset(tag_names) if require_all else bool(target.intersection(tag_names))):
+            out.append(record)
+    return out
+
+
+def summarize_local_workspace(workspace: LocalASEWorkspace | None = None) -> dict:
+    records = _workspace(workspace).select_records({})
+    by_namespace: dict[str, int] = {}
+    by_origin: dict[str, int] = {}
+    by_sync: dict[str, int] = {}
+    for record in records:
+        ns = record.source_metadata.get("logical_namespace", "unknown")
+        by_namespace[ns] = by_namespace.get(ns, 0) + 1
+        origin = record.source_metadata.get("origin", "unknown")
+        by_origin[origin] = by_origin.get(origin, 0) + 1
+        sync = record.source_metadata.get("sync_status", "unknown")
+        by_sync[sync] = by_sync.get(sync, 0) + 1
+    return {"total": len(records), "by_namespace": by_namespace, "by_origin": by_origin, "by_sync_status": by_sync}
