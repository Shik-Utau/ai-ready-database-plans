@@ -0,0 +1,78 @@
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+from ase import Atoms
+
+
+def _to_pymatgen_structure(structure: Any):
+    from pymatgen.io.ase import AseAtomsAdaptor
+    from pymatgen.core import Structure
+
+    if isinstance(structure, Atoms):
+        return AseAtomsAdaptor.get_structure(structure)
+    if isinstance(structure, Structure):
+        return structure
+    if isinstance(structure, dict):
+        return Structure.from_dict(structure)
+    raise TypeError("structure must be ASE Atoms, pymatgen Structure, or a pymatgen-compatible dict")
+
+
+def generate_vasp_relax_inputs(structure: Any, output_dir: str | Path, user_incar_settings: dict[str, Any] | None = None) -> Path:
+    from pymatgen.io.vasp.sets import MPRelaxSet
+
+    output = Path(output_dir)
+    output.mkdir(parents=True, exist_ok=True)
+    MPRelaxSet(_to_pymatgen_structure(structure), user_incar_settings=user_incar_settings or {}).write_input(output)
+    return output
+
+
+def generate_vasp_static_inputs(structure: Any, output_dir: str | Path, user_incar_settings: dict[str, Any] | None = None) -> Path:
+    from pymatgen.io.vasp.sets import MPStaticSet
+
+    output = Path(output_dir)
+    output.mkdir(parents=True, exist_ok=True)
+    MPStaticSet(_to_pymatgen_structure(structure), user_incar_settings=user_incar_settings or {}).write_input(output)
+    return output
+
+
+def parse_vasp_outputs(calc_dir: str | Path) -> dict[str, Any]:
+    from pymatgen.io.ase import AseAtomsAdaptor
+    from pymatgen.io.vasp.outputs import Outcar, Vasprun
+
+    calc_path = Path(calc_dir)
+    vasprun_path = calc_path / "vasprun.xml"
+    if not vasprun_path.exists():
+        raise FileNotFoundError(f"Missing vasprun.xml in {calc_path}")
+    vasprun = Vasprun(vasprun_path, parse_potcar_file=False)
+    final_structure = vasprun.final_structure
+    outcar_path = calc_path / "OUTCAR"
+    outcar = Outcar(outcar_path) if outcar_path.exists() else None
+    ionic_step = vasprun.ionic_steps[-1] if vasprun.ionic_steps else {}
+    forces = ionic_step.get("forces")
+    stress = ionic_step.get("stress")
+    incar = dict(vasprun.incar)
+    return {
+        "atoms": AseAtomsAdaptor.get_atoms(final_structure),
+        "data": {
+            "energy": vasprun.final_energy,
+            "forces": forces,
+            "stress": stress,
+            "magnetic_moment": getattr(outcar, "magnetization", None) if outcar else None,
+        },
+        "metadata": {
+            "software": "VASP",
+            "software_version": getattr(vasprun, "vasp_version", None),
+            "xc_functional": vasprun.parameters.get("GGA") or vasprun.parameters.get("METAGGA") or "unknown",
+            "dft_u": bool(incar.get("LDAU")) if "LDAU" in incar else None,
+            "u_values": {"LDAUU": incar.get("LDAUU"), "LDAUJ": incar.get("LDAUJ"), "LDAUL": incar.get("LDAUL")},
+            "dispersion": "D3" if any(key in incar for key in ("IVDW", "VDW_VERSION")) else None,
+            "spin_polarized": bool(incar.get("ISPIN") == 2) if "ISPIN" in incar else None,
+            "calculation_status": "finished" if vasprun.converged else "failed",
+            "data_quality": "valid" if vasprun.converged else "invalid",
+            "incar": incar,
+            "kpoints": str(vasprun.kpoints) if vasprun.kpoints else None,
+            "potcar_symbols": list(getattr(vasprun, "potcar_symbols", []) or []),
+        },
+    }
