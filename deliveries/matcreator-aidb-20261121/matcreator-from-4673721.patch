+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+from ..cloud.cloud_query import fetch_cloud_records
+from ..config import load_renaissance_config
+from ..dft_finalize import finalize_dft_results
+from ..fine_tune_planer.gap_planner import plan_finetune_data_gap
+from ..local.local_ase_db import export_records_for_training, init_local_db
+
+
+def _format_gap(report: dict[str, Any]) -> str:
+    return (
+        f"Local available configurations: {report['local_available']}\n"
+        f"Cloud reusable configurations: {report['cloud_available']}\n"
+        f"Required new DFT configurations without cloud: {report['needed_without_cloud']}\n"
+        f"Required new DFT configurations with cloud: {report['needed_with_cloud']}\n"
+        f"Estimated saving from cloud usage: {report['saved_by_cloud']}\n"
+        f"Recommended next step: {report['recommended_action']}"
+    )
+
+
+def ai_ready_db_Renaissance_start(config_path: str | Path) -> dict[str, Any]:
+    config = load_renaissance_config(config_path)
+    init_local_db(config.local_db_path)
+    config.work_dir.mkdir(parents=True, exist_ok=True)
+    return {"local_db_path": str(config.local_db_path), "work_dir": str(config.work_dir), "status": "ready"}
+
+
+def ai_ready_db_finalize_dft(config_path: str | Path) -> dict[str, Any]:
+    config = load_renaissance_config(config_path)
+    return finalize_dft_results(config.work_dir, config.local_db_path, config)
+
+
+def ai_ready_db_finetune_plan(config_path: str | Path) -> dict[str, Any]:
+    config = load_renaissance_config(config_path)
+    report = plan_finetune_data_gap(config.local_db_path, config.cloud_postgres_uri, config.query, config.min_required_configurations, allow_cloud_probe=True).to_dict()
+    report["message"] = _format_gap(report)
+    return report
+
+
+def ai_ready_db_accept_cloud_plan(config_path: str | Path) -> dict[str, Any]:
+    config = load_renaissance_config(config_path)
+    report = ai_ready_db_finetune_plan(config_path)
+    cloud_records = fetch_cloud_records(config.cloud_postgres_uri, config.query, limit=report["cloud_available"]) if config.cloud_postgres_uri else []
+    output = export_records_for_training(config.local_db_path, config.query, config.work_dir / "training_local.h5")
+    return {"accepted_cloud_data": True, "cloud_records_retrieved": len(cloud_records), "local_training_export": str(output), "gap_report": report}
+
+
+def ai_ready_db_reject_cloud_plan(config_path: str | Path) -> dict[str, Any]:
+    report = ai_ready_db_finetune_plan(config_path)
+    return {"accepted_cloud_data": False, "new_dft_configurations_required": report["needed_without_cloud"], "gap_report": report}
