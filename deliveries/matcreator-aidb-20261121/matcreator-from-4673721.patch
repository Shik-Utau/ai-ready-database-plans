@@ -0,0 +1,167 @@
+from __future__ import annotations
+
+from typing import Any
+
+from ai_ready_db.core.ase_converters import material_record_from_ase_atoms, material_record_to_ase_atoms
+from ai_ready_db.core.material_record import MaterialRecord
+
+LOCAL_NAMESPACES = {"bulk_base_pbe", "bulk_dft_u_archive", "workflow", "rejected_records", "local_exports", "fine_tune_working"}
+ORIGINS = {"local_calculation", "cloud_retrieved", "user_uploaded", "generated_recalc", "fine_tune_export"}
+SYNC_STATUSES = {"local_only", "retrieved_from_cloud", "synced_to_cloud", "modified_locally", "sync_failed"}
+
+
+def material_record_to_atoms(record: MaterialRecord):
+    atoms = material_record_to_ase_atoms(record)
+    if record.forces is not None:
+        import numpy as np
+
+        atoms.arrays["forces"] = np.asarray(record.forces, dtype=float)
+    if record.charge is not None:
+        import numpy as np
+
+        atoms.arrays["charges"] = np.asarray(record.charge, dtype=float)
+    if record.magmom is not None:
+        import numpy as np
+
+        atoms.arrays["magmoms"] = np.asarray(record.magmom, dtype=float)
+    if record.stress is not None:
+        atoms.info["stress"] = record.stress
+        atoms.info["stress_unit"] = record.stress_unit or "eV/Angstrom^3"
+    return atoms
+
+
+def atoms_to_material_record(atoms: Any, sidecar_payload: dict | None = None) -> MaterialRecord:
+    record = material_record_from_ase_atoms(atoms)
+    if not sidecar_payload:
+        return record
+    record.record_id = str(sidecar_payload.get("record_id") or record.record_id)
+    record.structure = sidecar_payload.get("structure_json") or record.structure
+    record.composition = sidecar_payload.get("composition") or record.composition
+    record.elements = sidecar_payload.get("elements") or record.elements
+    record.energy = sidecar_payload.get("energy") if sidecar_payload.get("energy") is not None else record.energy
+    record.energy_per_atom = sidecar_payload.get("energy_per_atom") if sidecar_payload.get("energy_per_atom") is not None else record.energy_per_atom
+    record.functional = sidecar_payload.get("functional") or record.functional
+    record.has_transition_metal = bool(sidecar_payload.get("has_transition_metal", record.has_transition_metal))
+    record.calculation_type = sidecar_payload.get("calculation_type") or record.calculation_type
+    record.sampling_type = sidecar_payload.get("sampling_type") or record.sampling_type
+    record.trajectory_id = sidecar_payload.get("trajectory_id") or record.trajectory_id
+    record.frame_index = sidecar_payload.get("frame_index") if sidecar_payload.get("frame_index") is not None else record.frame_index
+    record.forces = sidecar_payload.get("forces") if sidecar_payload.get("forces") is not None else record.forces
+    record.stress = sidecar_payload.get("stress") if sidecar_payload.get("stress") is not None else record.stress
+    record.virial = sidecar_payload.get("virial")
+    record.magmom = sidecar_payload.get("magmom")
+    record.charge = sidecar_payload.get("charge")
+    record.hubbard_u = sidecar_payload.get("hubbard_u")
+    record.calculation_parameters = sidecar_payload.get("calculation_parameters") or {}
+    record.source_metadata = sidecar_payload.get("source_metadata") or {}
+    record.screening = sidecar_payload.get("screening") or {}
+    record.tags = sidecar_payload.get("tags") or []
+    record.provenance = sidecar_payload.get("provenance") or {}
+    record.workflow_id = (sidecar_payload.get("workflow") or {}).get("workflow_id", record.workflow_id)
+    record.source_metadata["cloud_record_id"] = sidecar_payload.get("cloud_record_id")
+    return record
+
+
+def sidecar_payload_from_record(record: MaterialRecord, cloud_record_id: str | None = None) -> dict[str, Any]:
+    return {
+        "record_id": record.record_id,
+        "cloud_record_id": cloud_record_id or record.source_metadata.get("cloud_record_id"),
+        "structure_json": record.structure,
+        "composition": record.composition,
+        "elements": record.elements,
+        "energy": record.energy,
+        "energy_per_atom": record.energy_per_atom,
+        "functional": record.functional,
+        "has_transition_metal": record.has_transition_metal,
+        "calculation_type": record.calculation_type,
+        "sampling_type": record.sampling_type,
+        "trajectory_id": record.trajectory_id,
+        "frame_index": record.frame_index,
+        "forces": record.forces,
+        "stress": record.stress,
+        "virial": record.virial,
+        "magmom": record.magmom,
+        "charge": record.charge,
+        "hubbard_u": record.hubbard_u,
+        "calculation_parameters": record.calculation_parameters,
+        "source_metadata": record.source_metadata,
+        "screening": record.screening,
+        "tags": record.tags,
+        "provenance": record.provenance,
+        "workflow": {"workflow_id": record.workflow_id, "original_dft_u_record_id": record.original_dft_u_record_id},
+        "export_history": [],
+    }
+
+
+def _tags_key(record: MaterialRecord) -> str:
+    names = []
+    for tag in record.tags:
+        if isinstance(tag, dict) and tag.get("tag"):
+            names.append(str(tag["tag"]))
+    return "|".join(sorted(set(names)))
+
+
+def _quality_score(record: MaterialRecord) -> float:
+    value = record.source_metadata.get("quality_score") or record.screening.get("quality_score")
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        return 1.0
+
+
+def build_key_value_pairs(
+    record: MaterialRecord,
+    namespace: str,
+    origin: str,
+    sync_status: str,
+    sidecar_id: str,
+    config: dict,
+) -> dict[str, Any]:
+    if namespace not in LOCAL_NAMESPACES:
+        raise ValueError(f"Unsupported local logical namespace: {namespace}")
+    if origin not in ORIGINS:
+        raise ValueError(f"Unsupported local record origin: {origin}")
+    if sync_status not in SYNC_STATUSES:
+        raise ValueError(f"Unsupported local sync status: {sync_status}")
+    kv = {
+        "record_id": record.record_id,
+        "cloud_record_id": record.source_metadata.get("cloud_record_id") or "",
+        "logical_namespace": namespace,
+        "origin": origin,
+        "sync_status": sync_status,
+        "source_dataset": record.source_dataset,
+        "source_id": record.source_id,
+        "formula_reduced": record.formula_reduced,
+        "elements_key": ",".join(sorted(record.elements)),
+        "nsites": int(record.nsites),
+        "structure_hash": record.structure_hash,
+        "energy": float(record.energy) if record.energy is not None else None,
+        "energy_per_atom": float(record.energy_per_atom) if record.energy_per_atom is not None else None,
+        "functional": record.functional or "",
+        "has_hubbard_u": bool(record.has_hubbard_u),
+        "has_transition_metal": bool(record.has_transition_metal),
+        "calculation_type": record.calculation_type or "",
+        "sampling_type": record.sampling_type or "",
+        "trajectory_id": record.trajectory_id or "",
+        "frame_index": int(record.frame_index) if record.frame_index is not None else -1,
+        "has_forces": record.forces is not None,
+        "has_stress": record.stress is not None,
+        "quality_score": _quality_score(record),
+        "tags_key": _tags_key(record),
+        "sidecar_id": sidecar_id,
+    }
+    kv = {key: value for key, value in kv.items() if value not in (None, "", -1)}
+    validate_key_budget(kv, config)
+    return kv
+
+
+def validate_key_budget(kv: dict, config: dict) -> None:
+    ase_cfg = config.get("ase_sqlite", config.get("local_database", {}))
+    allowed = set(ase_cfg.get("allowed_query_keys") or [])
+    if allowed:
+        extra = sorted(set(kv) - allowed)
+        if extra:
+            raise ValueError(f"ASE key_value_pairs contain unapproved keys: {extra}")
+    max_keys = int(ase_cfg.get("max_query_keys_per_row", 24))
+    if len(kv) > max_keys:
+        raise ValueError(f"ASE key_value_pairs exceed max_query_keys_per_row={max_keys}: {len(kv)}")
