+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from dflow.python import Artifact, OP, OPIO, OPIOSign, upload_packages
+
+upload_packages.append(__file__)
+
+
+class RunPreparedVasp(OP):
+    """Run one already-prepared VASP recalculation directory.
+
+    The task directory is expected to contain POSCAR, INCAR, KPOINTS, POTCAR,
+    and metadata.json. The OP deliberately does not generate inputs; generation
+    remains the responsibility of ai-ready-db prepare-recalc.
+    """
+
+    @classmethod
+    def get_input_sign(cls):
+        return OPIOSign(
+            {
+                "task_path": Artifact(Path),
+                "run_command": str,
+                "task_name": str,
+                "backward_list": list,
+            }
+        )
+
+    @classmethod
+    def get_output_sign(cls):
+        return OPIOSign({"backward_dir": Artifact(Path)})
+
+    @OP.exec_sign_check
+    def execute(self, op_in: OPIO) -> OPIO:
+        task_path = Path(op_in["task_path"]).resolve()
+        run_command = op_in["run_command"]
+        task_name = op_in["task_name"]
+        backward_list = [str(item) for item in op_in["backward_list"]]
+        stdout_path = task_path / "stdout.txt"
+        stderr_path = task_path / "stderr.txt"
+        started_at = datetime.now(timezone.utc).isoformat()
+        completed_at = None
+        return_code = None
+        try:
+            with stdout_path.open("w", encoding="utf-8") as stdout, stderr_path.open("w", encoding="utf-8") as stderr:
+                completed = subprocess.run(
+                    run_command,
+                    shell=True,
+                    cwd=task_path,
+                    stdout=stdout,
+                    stderr=stderr,
+                    check=False,
+                )
+            return_code = completed.returncode
+            completed_at = datetime.now(timezone.utc).isoformat()
+            if completed.returncode != 0:
+                raise RuntimeError(f"VASP command failed for {task_name} with exit code {completed.returncode}")
+        finally:
+            status = {
+                "task_name": task_name,
+                "run_command": run_command,
+                "started_at": started_at,
+                "completed_at": completed_at,
+                "return_code": return_code,
+            }
+            (task_path / "ai_ready_recalc_status.json").write_text(
+                json.dumps(status, indent=2, sort_keys=True) + "\n",
+                encoding="utf-8",
+            )
+
+        backward_dir = Path("backward_dir").resolve()
+        backward_dir.mkdir(parents=True, exist_ok=True)
+        for name in backward_list:
+            source = task_path / name
+            if not source.exists():
+                continue
+            target = backward_dir / name
+            if source.is_dir():
+                shutil.copytree(source, target, dirs_exist_ok=True)
+            else:
+                target.parent.mkdir(parents=True, exist_ok=True)
+                shutil.copy2(source, target)
+        return OPIO({"backward_dir": backward_dir})
