+from typing import Any
+
+from ai_ready_db.core.hashing import stable_json
+from ai_ready_db.core.material_record import MaterialRecord
+
+
+def export_screening_report(records: list[MaterialRecord], report: dict[str, Any], json_path: str, csv_path: str) -> None:
+    Path(json_path).parent.mkdir(parents=True, exist_ok=True)
+    Path(csv_path).parent.mkdir(parents=True, exist_ok=True)
+    payload = {
+        "summary": report,
+        "description": "Deterministic bias-reduction and coverage-balancing report; not a Boltzmann distribution.",
+        "records": [
+            {
+                "record_id": record.record_id,
+                "source_dataset": record.source_dataset,
+                "source_id": record.source_id,
+                "formula_reduced": record.formula_reduced,
+                "screening": record.screening,
+            }
+            for record in records
+        ],
+    }
+    Path(json_path).write_text(json.dumps(payload, indent=2, sort_keys=True), encoding="utf-8")
+    with Path(csv_path).open("w", encoding="utf-8", newline="") as handle:
+        writer = csv.DictWriter(
+            handle,
+            fieldnames=[
+                "record_id",
+                "source_dataset",
+                "source_id",
+                "formula_reduced",
+                "accepted",
+                "reason",
+                "force_bin",
+                "energy_bin",
+                "similarity_hash",
+                "screening_json",
+            ],
+        )
+        writer.writeheader()
+        for record in records:
+            screening = record.screening or {}
+            writer.writerow(
+                {
+                    "record_id": record.record_id,
+                    "source_dataset": record.source_dataset,
+                    "source_id": record.source_id,
+                    "formula_reduced": record.formula_reduced,
+                    "accepted": screening.get("accepted"),
+                    "reason": screening.get("reason"),
+                    "force_bin": screening.get("force_bin"),
+                    "energy_bin": screening.get("energy_bin"),
+                    "similarity_hash": screening.get("similarity_hash"),
+                    "screening_json": stable_json(screening),
+                }
+            )
+
+
+def export_recalc_candidates(candidates: list[dict[str, Any]], jsonl_path: str, csv_path: str) -> None:
+    Path(jsonl_path).parent.mkdir(parents=True, exist_ok=True)
+    Path(csv_path).parent.mkdir(parents=True, exist_ok=True)
+    with Path(jsonl_path).open("w", encoding="utf-8") as handle:
+        for candidate in candidates:
+            handle.write(json.dumps(candidate, sort_keys=True, default=str) + "\n")
+    with Path(csv_path).open("w", encoding="utf-8", newline="") as handle:
+        writer = csv.DictWriter(
+            handle,
+            fieldnames=[
+                "original_dft_u_record_id",
+                "source_dataset",
+                "source_id",
+                "formula_reduced",
+                "elements",
+                "target_functional",
+                "target_disable_ldau",
+                "recommended_job_dir",
+            ],
+            extrasaction="ignore",
+        )
+        writer.writeheader()
+        for candidate in candidates:
+            row = dict(candidate)
+            row["elements"] = ",".join(candidate.get("elements") or [])
+            writer.writerow(row)
