+from __future__ import annotations
+
+import math
+from typing import Any
+
+
+def force_norms(forces: list[Any] | None) -> tuple[float | None, float | None]:
+    if not forces:
+        return None, None
+    norms: list[float] = []
+    for vector in forces:
+        if not isinstance(vector, (list, tuple)) or len(vector) < 3:
+            continue
+        try:
+            norms.append(math.sqrt(float(vector[0]) ** 2 + float(vector[1]) ** 2 + float(vector[2]) ** 2))
+        except (TypeError, ValueError):
+            continue
+    if not norms:
+        return None, None
+    return max(norms), sum(norms) / len(norms)
+
+
+def assign_bin(value: float | None, bins: list[float]) -> str | None:
+    if value is None:
+        return None
+    if len(bins) < 2:
+        return None
+    for lower, upper in zip(bins[:-1], bins[1:]):
+        if lower <= value < upper:
+            return f"[{lower:g},{upper:g})"
+    if value == bins[-1]:
+        return f"[{bins[-2]:g},{bins[-1]:g}]"
+    return f">={bins[-1]:g}"
