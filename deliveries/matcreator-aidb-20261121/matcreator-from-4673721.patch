+from __future__ import annotations
+
+import re
+from pathlib import Path
+from typing import Any, Mapping
+
+from sqlalchemy import create_engine, text
+from sqlalchemy.engine import Engine
+
+from ai_ready_db.config import get_postgres_url
+from ai_ready_db.database.schemas import DEFAULT_SQL_PATH
+
+
+def create_postgres_engine(config_or_url: Mapping[str, Any] | str, echo: bool | None = None) -> Engine:
+    if isinstance(config_or_url, str):
+        url = config_or_url
+        echo_sql = bool(echo)
+    else:
+        url = get_postgres_url(config_or_url)
+        echo_sql = bool(config_or_url.get("postgres", {}).get("echo_sql", False) if echo is None else echo)
+    return create_engine(url, echo=echo_sql, future=True)
+
+
+def split_sql_statements(sql_text: str) -> list[str]:
+    statements: list[str] = []
+    current: list[str] = []
+    in_single_quote = False
+    previous = ""
+    for char in sql_text:
+        if char == "'" and previous != "\\":
+            in_single_quote = not in_single_quote
+        if char == ";" and not in_single_quote:
+            statement = "".join(current).strip()
+            if statement:
+                statements.append(statement)
+            current = []
+        else:
+            current.append(char)
+        previous = char
+    tail = "".join(current).strip()
+    if tail:
+        statements.append(tail)
+    return statements
+
+
+def init_database(engine: Engine, sql_path: str | Path = DEFAULT_SQL_PATH) -> None:
+    sql_file = Path(sql_path)
+    sql_text = sql_file.read_text(encoding="utf-8")
+    with engine.begin() as conn:
+        for statement in split_sql_statements(sql_text):
+            if re.match(r"^\s*--", statement) and "\n" not in statement:
+                continue
+            conn.execute(text(statement))
