+from __future__ import annotations
+
+from typing import Any
+
+
+def normalize_energy(record: dict[str, Any]) -> dict[str, Any]:
+    return record
+
+
+def normalize_forces(record: dict[str, Any]) -> dict[str, Any]:
+    return record
+
+
+def normalize_stress(record: dict[str, Any]) -> dict[str, Any]:
+    if record.get("stress") is not None and not record.get("stress_unit"):
+        record["stress_unit"] = "eV/Angstrom^3"
+    return record
+
+
+def normalize_structure(record: dict[str, Any]) -> dict[str, Any]:
+    return record
+
+
+def normalize_record(record: dict[str, Any]) -> dict[str, Any]:
+    for func in (normalize_structure, normalize_energy, normalize_forces, normalize_stress):
+        record = func(record)
+    return record
