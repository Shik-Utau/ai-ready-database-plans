+from __future__ import annotations
+
+from typing import Any
+
+from ai_ready_db.ai_ready_db_Renaissance.metadata import classify_property_labels, classify_software
+
+
+def classify_xc(record: dict[str, Any]) -> str:
+    functional = record.get("functional") or record.get("xc_functional")
+    if not functional:
+        return "unknown"
+    base = str(functional).upper().replace(" ", "")
+    hubbard_u = record.get("hubbard_u")
+    dispersion = str(record.get("dispersion") or "").upper()
+    if base == "PBE":
+        if hubbard_u and dispersion == "D3":
+            return "PBE+U+D3"
+        if hubbard_u:
+            return "PBE+U"
+        if dispersion == "D3":
+            return "PBE+D3"
+        return "PBE"
+    if base in {"SCAN", "R2SCAN", "HSE06"}:
+        return "r2SCAN" if base == "R2SCAN" else base
+    return "others"
+
+
+def classify_spin(record: dict[str, Any]) -> str:
+    metadata = record.get("source_metadata") or {}
+    spin_polarized = metadata.get("spin_polarized", record.get("spin_polarized"))
+    magnetic_order = metadata.get("magnetic_order", record.get("magnetic_order"))
+    if magnetic_order:
+        return "magnetic order known"
+    if spin_polarized is True:
+        return "spin-polarized"
+    if spin_polarized is False:
+        return "non-spin-polarized"
+    return "spin metadata missing"
+
+
+def classify_system_type(record: dict[str, Any]) -> str:
+    value = str((record.get("source_metadata") or {}).get("system_type") or record.get("system_type") or "").lower()
+    return value if value in {"bulk", "surface", "interface", "defect", "vacancy", "interstitial", "adsorbate", "molecule"} else "unknown"
+
+
+def classify_property_labels(record: dict[str, Any]) -> list[str]:
+    payload = {
+        "energy": record.get("energy"),
+        "forces": record.get("forces"),
+        "stress": record.get("stress"),
+        "magnetic_moment": record.get("magmom"),
+    }
+    from ai_ready_db.ai_ready_db_Renaissance.metadata import classify_property_labels as _labels
+
+    return _labels(payload)
+
+
+def classify_record(record: dict[str, Any]) -> dict[str, Any]:
+    source_meta = record.get("source_metadata") or {}
+    software = classify_software({"software": source_meta.get("software") or record.get("software")})
+    return {
+        "software": software,
+        "xc_functional": classify_xc(record),
+        "spin_state": classify_spin(record),
+        "system_type": classify_system_type(record),
+        "property_labels": classify_property_labels(record),
+    }
