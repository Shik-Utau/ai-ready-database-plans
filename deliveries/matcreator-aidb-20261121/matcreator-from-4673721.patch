+from __future__ import annotations
+
+import json
+from collections.abc import Iterable
+from typing import Any
+
+from sqlalchemy import create_engine, text
+
+
+def create_required_tables(uri: str) -> None:
+    ddl = """
+    CREATE TABLE IF NOT EXISTS materials_records (
+      id bigserial PRIMARY KEY,
+      structure_hash text UNIQUE NOT NULL,
+      composition jsonb,
+      formula text,
+      natoms integer,
+      software text NOT NULL,
+      software_version text,
+      xc_functional text NOT NULL,
+      dft_u boolean,
+      u_values jsonb,
+      dispersion text,
+      spin_state text NOT NULL,
+      magnetic_order text,
+      system_type text NOT NULL,
+      property_labels jsonb NOT NULL,
+      energy double precision,
+      forces jsonb,
+      stress jsonb,
+      metadata jsonb,
+      source_dataset text,
+      source_id text,
+      data_quality text,
+      created_at timestamptz NOT NULL DEFAULT now()
+    )
+    """
+    with create_engine(uri).begin() as conn:
+        conn.execute(text(ddl))
+
+
+def insert_cleaned_records(uri: str, records: Iterable[dict[str, Any]], batch_size: int = 500) -> dict[str, int]:
+    rows = list(records)
+    if not rows:
+        return {"inserted": 0, "duplicates": 0}
+    sql = text(
+        """
+        INSERT INTO materials_records (
+          structure_hash, composition, formula, natoms, software, software_version,
+          xc_functional, dft_u, u_values, dispersion, spin_state, magnetic_order,
+          system_type, property_labels, energy, forces, stress, metadata,
+          source_dataset, source_id, data_quality
+        ) VALUES (
+          :structure_hash, CAST(:composition AS jsonb), :formula, :natoms, :software, :software_version,
+          :xc_functional, :dft_u, CAST(:u_values AS jsonb), :dispersion, :spin_state, :magnetic_order,
+          :system_type, CAST(:property_labels AS jsonb), :energy, CAST(:forces AS jsonb), CAST(:stress AS jsonb), CAST(:metadata AS jsonb),
+          :source_dataset, :source_id, :data_quality
+        ) ON CONFLICT (structure_hash) DO NOTHING
+        """
+    )
+    inserted = 0
+    with create_engine(uri).begin() as conn:
+        for row in rows:
+            result = conn.execute(sql, {
+                "structure_hash": row["structure_hash"],
+                "composition": json.dumps(row.get("composition") or {}),
+                "formula": row.get("formula_reduced") or row.get("formula_pretty"),
+                "natoms": row.get("nsites"),
+                "software": row["classification"]["software"],
+                "software_version": (row.get("source_metadata") or {}).get("software_version"),
+                "xc_functional": row["classification"]["xc_functional"],
+                "dft_u": bool(row.get("hubbard_u")) if row.get("hubbard_u") is not None else None,
+                "u_values": json.dumps(row.get("hubbard_u") or {}),
+                "dispersion": row.get("dispersion"),
+                "spin_state": row["classification"]["spin_state"],
+                "magnetic_order": (row.get("source_metadata") or {}).get("magnetic_order"),
+                "system_type": row["classification"]["system_type"],
+                "property_labels": json.dumps(row["classification"]["property_labels"]),
+                "energy": row.get("energy"),
+                "forces": json.dumps(row.get("forces")) if row.get("forces") is not None else None,
+                "stress": json.dumps(row.get("stress")) if row.get("stress") is not None else None,
+                "metadata": json.dumps(row),
+                "source_dataset": row.get("source_dataset"),
+                "source_id": row.get("source_id"),
+                "data_quality": (row.get("source_metadata") or {}).get("data_quality", "unknown"),
+            })
+            inserted += int(result.rowcount or 0)
+    return {"inserted": inserted, "duplicates": len(rows) - inserted}
diff --git a/delivery/vendor/ai-ready-db/ai_ready_db/ai_ready_db_Reforging/reforge_omat.py b/delivery/vendor/ai-ready-db/ai_ready_db/ai_ready_db_Reforging/reforge_omat.py
