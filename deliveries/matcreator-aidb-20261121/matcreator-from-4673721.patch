@@ -0,0 +1,86 @@
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Iterable
+
+import h5py
+import numpy as np
+from ase import Atoms
+from ase.db import connect
+
+
+def init_local_db(db_path: str | Path) -> Path:
+    path = Path(db_path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with connect(path):
+        pass
+    return path
+
+
+def _split_payload(metadata: dict[str, Any], data: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
+    kv: dict[str, Any] = {}
+    embedded = {"metadata": metadata, "results": data}
+    for key, value in metadata.items():
+        if isinstance(value, (str, int, float, bool)) or value is None:
+            kv[key] = value
+    return kv, embedded
+
+
+def write_atoms_record(db_path: str | Path, atoms: Atoms, metadata: dict[str, Any], data: dict[str, Any]) -> int:
+    init_local_db(db_path)
+    kv, embedded = _split_payload(metadata, data)
+    with connect(db_path) as db:
+        return int(db.write(atoms, key_value_pairs=kv, data=embedded))
+
+
+def read_candidate_records(db_path: str | Path, query: dict[str, Any] | None = None) -> list[dict[str, Any]]:
+    query = query or {}
+    with connect(db_path) as db:
+        rows = list(db.select())
+    out: list[dict[str, Any]] = []
+    for row in rows:
+        metadata = dict((row.data or {}).get("metadata", {}))
+        if all(metadata.get(key) == value for key, value in query.items()):
+            out.append({"atoms": row.toatoms(), "metadata": metadata, "data": dict((row.data or {}).get("results", {}))})
+    return out
+
+
+def count_relevant_local_records(db_path: str | Path, query: dict[str, Any] | None = None) -> int:
+    return len(read_candidate_records(db_path, query))
+
+
+def export_records_for_training(db_path: str | Path, query: dict[str, Any], output_path: str | Path) -> Path:
+    records = read_candidate_records(db_path, query)
+    if not records:
+        raise ValueError("No matching records available for export")
+    output = Path(output_path)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    max_atoms = max(len(item["atoms"]) for item in records)
+    positions = np.full((len(records), max_atoms, 3), np.nan)
+    species = np.full((len(records), max_atoms), "", dtype="S8")
+    energies = np.full((len(records),), np.nan)
+    forces = np.full((len(records), max_atoms, 3), np.nan)
+    stress = np.full((len(records), 3, 3), np.nan)
+    with h5py.File(output, "w") as handle:
+        for idx, item in enumerate(records):
+            atoms = item["atoms"]
+            n = len(atoms)
+            positions[idx, :n] = atoms.positions
+            species[idx, :n] = np.asarray(atoms.get_chemical_symbols(), dtype="S8")
+            result = item["data"]
+            if result.get("energy") is not None:
+                energies[idx] = float(result["energy"])
+            if result.get("forces") is not None:
+                forces[idx, :n] = np.asarray(result["forces"], dtype=float)
+            if result.get("stress") is not None:
+                value = np.asarray(result["stress"], dtype=float)
+                stress[idx] = value.reshape(3, 3) if value.size == 9 else np.diag(value[:3])
+        handle.create_dataset("structures/positions", data=positions)
+        handle.create_dataset("structures/species", data=species)
+        handle.create_dataset("properties/energy", data=energies)
+        handle.create_dataset("properties/forces", data=forces)
+        handle.create_dataset("properties/stress", data=stress)
+        meta = handle.create_group("metadata")
+        meta.attrs["record_count"] = len(records)
+        meta.attrs["query"] = str(query)
+    return output
diff --git a/delivery/vendor/ai-ready-db/ai_ready_db/ai_ready_db_Renaissance/local/local_converters.py b/delivery/vendor/ai-ready-db/ai_ready_db/ai_ready_db_Renaissance/local/local_converters.py
