+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+
+@dataclass
+class RenaissanceConfig:
+    local_db_path: Path
+    work_dir: Path
+    dft_code: str = "vasp"
+    vasp_input_mode: str = "relax"
+    xc_functional: str | None = None
+    dft_u: bool | None = None
+    u_values: dict[str, Any] = field(default_factory=dict)
+    dispersion: str | None = None
+    spin_polarized: bool | None = None
+    system_type: str | None = None
+    property_labels: list[str] = field(default_factory=list)
+    cloud_postgres_uri: str | None = None
+    similarity_search_settings: dict[str, Any] = field(default_factory=dict)
+    min_required_configurations: int = 100
+    allow_cloud_data: bool | None = None
+    query: dict[str, Any] = field(default_factory=dict)
+
+
+def load_renaissance_config(path: str | Path) -> RenaissanceConfig:
+    raw = yaml.safe_load(Path(path).read_text(encoding="utf-8")) or {}
+    required = ["local_db_path", "work_dir"]
+    missing = [name for name in required if not raw.get(name)]
+    if missing:
+        raise ValueError(f"Missing required Renaissance config fields: {', '.join(missing)}")
+    raw["local_db_path"] = Path(raw["local_db_path"])
+    raw["work_dir"] = Path(raw["work_dir"])
+    return RenaissanceConfig(**{k: v for k, v in raw.items() if k in RenaissanceConfig.__dataclass_fields__})
