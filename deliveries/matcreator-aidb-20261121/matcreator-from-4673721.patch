+from __future__ import annotations
+
+from typing import Any
+
+from ai_ready_db.core.material_record import MaterialRecord
+
+
+def _find_spacegroup(metadata: dict[str, Any]) -> str | None:
+    for key in ("spacegroup", "space_group", "sg_symbol", "spacegroup_symbol"):
+        value = metadata.get(key)
+        if value is not None:
+            return str(value)
+    symmetry = metadata.get("symmetry")
+    if isinstance(symmetry, dict):
+        for key in ("spacegroup", "space_group", "symbol", "number"):
+            value = symmetry.get(key)
+            if value is not None:
+                return str(value)
+    return None
+
+
+def lightweight_similarity_hash(record: MaterialRecord, volume_per_atom_round_decimals: int = 2) -> str:
+    volume_per_atom = None
+    if record.volume is not None and record.nsites:
+        volume_per_atom = round(float(record.volume) / float(record.nsites), volume_per_atom_round_decimals)
+    spacegroup = _find_spacegroup(record.source_metadata)
+    parts = [
+        record.formula_reduced,
+        str(record.nsites),
+        ",".join(sorted(record.elements)),
+        str(volume_per_atom),
+    ]
+    if spacegroup:
+        parts.append(spacegroup)
+    return "|".join(parts)
