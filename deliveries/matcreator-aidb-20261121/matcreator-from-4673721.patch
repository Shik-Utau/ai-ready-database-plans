+        "upload_requested": allow_upload,
+        "upload_allowed": bool(allow_upload and not errors),
+        "automatic_upload": False,
+        "classification": classification.to_dict(),
+        "dft_profile": profile.to_dict(),
+        "target_namespace": namespace.to_dict(),
+        "validation_errors": errors,
+        "required_checks": [
+            "schema_validation",
