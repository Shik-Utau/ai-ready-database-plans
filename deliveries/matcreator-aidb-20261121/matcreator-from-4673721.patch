+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Any, Mapping
+
+
+def _load_mp_relax_set_config() -> dict[str, Any]:
+    """Return a deep copy of pymatgen MPRelaxSet.CONFIG when available."""
+    try:
+        from pymatgen.io.vasp.sets import MPRelaxSet
+    except ModuleNotFoundError as exc:
+        raise RuntimeError(
+            "pymatgen.io.vasp.sets.MPRelaxSet is required for OMat24-style VASP settings. "
+            "Install pymatgen with `python -m pip install pymatgen`."
+        ) from exc
+
+    config = getattr(MPRelaxSet, "CONFIG", None)
+    if not isinstance(config, Mapping):
+        raise RuntimeError("pymatgen MPRelaxSet.CONFIG is not available in this pymatgen version.")
+    return deepcopy(dict(config))
+
+
+def get_omat24_like_vasp_settings(config: Mapping[str, Any]) -> dict[str, Any]:
+    """Return VASP settings for clean PBE no-U recalculation inputs.
+
+    The AI-ready clean-base policy is stricter than pymatgen's MPRelaxSet
+    defaults: do not silently introduce spin, MAGMOM, DFT+U, dispersion, or
+    relax settings.  MPRelaxSet is still captured as provenance for historical
+    OMat-style compatibility, but the default emitted INCAR is the reusable
+    static single-point PBE profile.
+    """
+    vasp_cfg = config.get("vasp", config)
+    mp_relax_config = _load_mp_relax_set_config()
+
+    calculation_type = vasp_cfg.get("calculation_type", "single_point")
+    input_backend = vasp_cfg.get("input_backend", "pymatgen")
+
+    clean_static_incar: dict[str, Any] = {
+        "ALGO": "Normal",
+        "ENCUT": 520,
+        "EDIFF": 1e-5,
+        "IBRION": -1,
+        "ISPIN": 1,
+        "LDAU": False,
+        "LWAVE": False,
+        "LCHARG": False,
+        "NSW": 0,
+        "PREC": "Accurate",
+    }
+    if vasp_cfg.get("include_default_smearing", False):
+        clean_static_incar["ISMEAR"] = int(vasp_cfg.get("default_ismear", 0))
+        clean_static_incar["SIGMA"] = float(vasp_cfg.get("default_sigma", 0.05))
+
+    if vasp_cfg.get("use_mp_relax_defaults", False):
+        user_incar_settings = deepcopy(mp_relax_config.get("INCAR", {}))
+    else:
+        user_incar_settings = clean_static_incar
+    user_incar_settings.update(deepcopy(vasp_cfg.get("user_incar_settings") or {}))
+    user_incar_settings.update(deepcopy(vasp_cfg.get("incar_overrides") or {}))
+
+    user_incar_settings["ALGO"] = "Normal"
+    user_incar_settings["LDAU"] = False if vasp_cfg.get("disable_ldau", True) else bool(
+        user_incar_settings.get("LDAU", False)
+    )
+    if vasp_cfg.get("force_non_spin", True):
+        user_incar_settings["ISPIN"] = 1
+        user_incar_settings.pop("MAGMOM", None)
+
+    if user_incar_settings.get("LDAU") is False:
+        for key in ("LDAUU", "LDAUJ", "LDAUL"):
+            user_incar_settings.pop(key, None)
+        if vasp_cfg.get("remove_lmaxmix_when_disabling_ldau", True):
+            user_incar_settings.pop("LMAXMIX", None)
+
+    if calculation_type in {"single_point", "static"}:
+        user_incar_settings["NSW"] = 0
+        user_incar_settings["IBRION"] = -1
+
+    return {
+        "preset": vasp_cfg.get("preset", "omat24_like"),
+        "base_input_set": "clean_pbe_static_single_point",
+        "base_input_set_config": mp_relax_config,
+        "input_backend": input_backend,
+        "calculation_type": calculation_type,
+        "incar": user_incar_settings,
+        "user_incar_settings": user_incar_settings,
+        "kpoints_policy": vasp_cfg.get("kpoints_policy", "MPRelaxSet"),
+        "kpoints": vasp_cfg.get("kpoints", deepcopy(mp_relax_config.get("KPOINTS"))),
+        "potcar_policy": vasp_cfg.get("potcar_policy", "MPRelaxSet"),
+        "potcar_mapping": vasp_cfg.get("potcar_mapping", {}),
+    }
