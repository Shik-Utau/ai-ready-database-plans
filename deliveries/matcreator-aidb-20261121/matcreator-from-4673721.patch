+from __future__ import annotations
+
+from collections.abc import Iterable
+from pathlib import Path
+from typing import Any, Mapping
+
+from ai_ready_db.config import load_config
+from ai_ready_db.core.material_record import MaterialRecord
+from ai_ready_db.core.normalization import normalize_json_record
+from ai_ready_db.ai_ready_db_Reforging.build_base_database import _iter_enabled_records
+
+
+def load_cleaning_records(config_or_path: Mapping[str, Any] | str) -> list[MaterialRecord]:
+    config = load_config(config_or_path) if isinstance(config_or_path, str) else dict(config_or_path)
+    return _iter_enabled_records(config)
+
+
+def read_records_jsonl(path: str | Path, source_dataset: str = "jsonl") -> list[MaterialRecord]:
+    import json
+
+    records: list[MaterialRecord] = []
+    for line in Path(path).read_text(encoding="utf-8").splitlines():
+        if not line.strip():
+            continue
+        raw = json.loads(line)
+        if set(MaterialRecord.__dataclass_fields__).issuperset(raw):
+            records.append(MaterialRecord(**raw))
+        else:
+            records.append(normalize_json_record(raw, raw.get("source_dataset", source_dataset)))
+    return records
+
+
+def write_records_jsonl(records: Iterable[MaterialRecord], path: str | Path) -> str:
+    import json
+
+    output = Path(path)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with output.open("w", encoding="utf-8") as handle:
+        for record in records:
+            handle.write(json.dumps(record.to_dict(), sort_keys=True, default=str) + "\n")
+    return str(output)
