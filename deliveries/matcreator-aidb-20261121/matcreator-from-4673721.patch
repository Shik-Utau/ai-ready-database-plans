+class RoutedCloudRepository(_BaseRepository):
+    def __init__(self, engine: Engine, config: Mapping[str, Any] | None = None):
+        super().__init__(engine, config)
+        self.clean = CleanBaseRepository(engine, config)
+        self.dft_u = DftUArchiveRepository(engine, config)
+        self.pbe_d3 = SpecialSettingsRepository(engine, self.pbe_d3_schema, config)
+        self.special = SpecialSettingsRepository(engine, self.special_schema, config)
+
+    def classify_and_route(self, record: MaterialRecord) -> dict[str, Any]:
+        classification = classify_record_four_layers(record)
+        dft_profile = get_default_dft_profile(classification, record.calculation_parameters)
+        namespace = route_record_to_cloud_namespace(classification, dft_profile)
+        return {
+            "record_id": record.record_id,
+            "classification": classification.to_dict(),
+            "dft_profile": dft_profile.to_dict(),
+            "namespace": namespace.to_dict(),
+        }
+
+    def insert_routed_record(self, record: MaterialRecord) -> dict[str, Any]:
+        routing = self.classify_and_route(record)
+        namespace_name = routing["namespace"]["name"]
+        if namespace_name == "bulk_base_pbe":
+            self.clean.insert_clean_record(record)
+        elif namespace_name == "pbe_plus_u_archive":
+            self.dft_u.insert_dft_u_record(record)
+        elif namespace_name == "pbe_d3_archive":
+            self.pbe_d3.insert_record(record, CloudNamespace(**routing["namespace"]), routing["classification"], routing["dft_profile"])
+        elif namespace_name == "special_settings_archive":
+            self.special.insert_record(record, CloudNamespace(**routing["namespace"]), routing["classification"], routing["dft_profile"])
+        else:
+            raise ValueError(f"Unsupported CloudDB namespace: {namespace_name}")
+        return routing
