@@ -0,0 +1,140 @@
+from __future__ import annotations
+
+import re
+from dataclasses import asdict, is_dataclass
+from typing import Any, Iterable, Mapping
+
+
+HUBBARD_U_TEXT_RE = re.compile(
+    r"(\bGGA\s*[\+_\- ]?\s*U\b|\bPBE\s*[\+_\- ]?\s*U\b|\bDFT\s*[\+_\- ]?\s*U\b|"
+    r"\br2SCAN\s*[\+_\- ]?\s*U\b|\bGGA_U\b|\bPBE_U\b|Hubbard)",
+    re.IGNORECASE,
+)
+
+
+def _as_mapping(record_or_metadata: Any) -> dict[str, Any]:
+    if is_dataclass(record_or_metadata):
+        return asdict(record_or_metadata)
+    if isinstance(record_or_metadata, Mapping):
+        return dict(record_or_metadata)
+    data: dict[str, Any] = {}
+    for key in (
+        "functional",
+        "calculation_type",
+        "calculation_parameters",
+        "source_metadata",
+        "hubbard_u",
+    ):
+        if hasattr(record_or_metadata, key):
+            data[key] = getattr(record_or_metadata, key)
+    return data
+
+
+def _walk(obj: Any) -> Iterable[tuple[str, Any]]:
+    if isinstance(obj, Mapping):
+        for key, value in obj.items():
+            yield str(key), value
+            yield from _walk(value)
+    elif isinstance(obj, list):
+        for item in obj:
+            yield from _walk(item)
+
+
+def _truthy(value: Any) -> bool:
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, (int, float)):
+        return bool(value)
+    if isinstance(value, str):
+        return value.strip().lower() in {"true", "t", ".true.", "yes", "y", "1"}
+    return False
+
+
+def _numeric_nonzero(value: Any) -> bool:
+    if value is None:
+        return False
+    if isinstance(value, Mapping):
+        return any(_numeric_nonzero(v) for v in value.values())
+    if isinstance(value, list):
+        return any(_numeric_nonzero(v) for v in value)
+    if isinstance(value, str):
+        stripped = value.strip()
+        parts = [part for part in re.split(r"[\s,;]+", stripped) if part]
+        if len(parts) > 1:
+            return any(_numeric_nonzero(part) for part in parts)
+        value = stripped
+    try:
+        return abs(float(value)) > 1e-12
+    except (TypeError, ValueError):
+        return False
+
+
+def _collect_text_values(payload: Mapping[str, Any]) -> list[str]:
+    values: list[str] = []
+    for key in ("run_type", "task_type", "functional", "calculation_type"):
+        value = payload.get(key)
+        if value is not None:
+            values.append(str(value))
+    for key, value in _walk(payload):
+        if key.lower() in {"run_type", "task_type", "functional", "xc", "metagga"} and value is not None:
+            values.append(str(value))
+    return values
+
+
+def _detect_hubbard_u(payload: Mapping[str, Any]) -> tuple[bool, dict[str, Any]]:
+    normalized: dict[str, Any] = {
+        "ldau": None,
+        "ldauu": None,
+        "ldauj": None,
+        "ldaul": None,
+        "hubbards": None,
+        "indicators": [],
+    }
+    has_hubbard_u = False
+
+    for key, value in _walk(payload):
+        lowered = key.lower()
+        if lowered == "ldau":
+            normalized["ldau"] = value
+            if _truthy(value):
+                normalized["indicators"].append("LDAU=true")
+                has_hubbard_u = True
+        elif lowered == "ldauu":
+            normalized["ldauu"] = value
+            if _numeric_nonzero(value):
+                normalized["indicators"].append("LDAUU_nonzero")
+                has_hubbard_u = True
+        elif lowered == "ldauj":
+            normalized["ldauj"] = value
+        elif lowered == "ldaul":
+            normalized["ldaul"] = value
+        elif lowered in {"hubbards", "hubbard_u", "hubbardus", "hubbard"}:
+            normalized["hubbards"] = value
+            if _numeric_nonzero(value):
+                normalized["indicators"].append(f"{key}_nonzero")
+                has_hubbard_u = True
+
+    for text_value in _collect_text_values(payload):
+        if HUBBARD_U_TEXT_RE.search(text_value):
+            normalized["indicators"].append(f"text:{text_value}")
+            has_hubbard_u = True
+
+    return has_hubbard_u, normalized
+
+
+def analyze_functional_metadata(record_or_metadata: Any) -> dict[str, Any]:
+    """Analyze electronic-structure functional metadata.
+
+    The API is intentionally broader than the current implementation. Today it
+    normalizes Hubbard-U evidence; future extensions can add dispersion,
+    meta-GGA, hybrid, or other functional features without changing callers.
+    """
+    payload = _as_mapping(record_or_metadata)
+    has_hubbard_u, hubbard_u = _detect_hubbard_u(payload)
+    functional = payload.get("functional")
+    return {
+        "functional": str(functional) if functional is not None else None,
+        "has_hubbard_u": has_hubbard_u,
+        "hubbard_u": hubbard_u,
+        "features": ["hubbard_u"] if has_hubbard_u else [],
+    }
diff --git a/delivery/vendor/ai-ready-db/ai_ready_db/cli.py b/delivery/vendor/ai-ready-db/ai_ready_db/cli.py
