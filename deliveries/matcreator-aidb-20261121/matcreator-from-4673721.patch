+++ b/delivery/vendor/ai-ready-db/ai_ready_db/ai_ready_db_Renaissance/evaluator/coverage.py
@@ -0,0 +1,52 @@
+from __future__ import annotations
+
+from typing import Any
+
+from ai_ready_db.ai_ready_db_Renaissance.fine_tune_planer.target_profile import TargetProfile
+from ai_ready_db.core.material_record import MaterialRecord
+
+DEFAULT_WEIGHTS = {
+    "chemistry": 0.25,
+    "prototype": 0.20,
+    "local_environment": 0.20,
+    "domain": 0.15,
+    "hamiltonian": 0.10,
+    "quality": 0.10,
+}
+
+
+def _tag_names(record: MaterialRecord) -> set[str]:
+    return {str(tag.get("tag")) for tag in record.tags if isinstance(tag, dict) and tag.get("tag")}
+
+
+def compute_coverage(records: list[MaterialRecord], profile: TargetProfile, weights: dict[str, float] | None = None) -> dict[str, Any]:
+    weights = weights or DEFAULT_WEIGHTS
+    if not records:
+        breakdown = {key: 0.0 for key in weights}
+        return {"score": 0.0, "breakdown": breakdown, "usable_records": 0}
+    target_elements = set(profile.elements)
+    target_tags = set(profile.tags + profile.prototypes)
+    chemistry_hits = [record for record in records if not target_elements or target_elements.issubset(set(record.elements))]
+    prototype_hits = [record for record in records if not target_tags or target_tags.intersection(_tag_names(record))]
+    environment_hits = [record for record in records if not profile.formulas or record.formula_reduced in profile.formulas]
+    domain_hits = [record for record in records if not profile.domain or profile.domain in _tag_names(record) or profile.domain == record.source_metadata.get("domain")]
+    hamiltonian_hits = [
+        record for record in records if (profile.allow_dft_u or not record.has_hubbard_u) and (not profile.functional or record.functional == profile.functional)
+    ]
+    qualities = []
+    for record in records:
+        try:
+            qualities.append(float(record.source_metadata.get("quality_score", record.screening.get("quality_score", 1.0))))
+        except (TypeError, ValueError):
+            qualities.append(1.0)
+    breakdown = {
+        "chemistry": len(chemistry_hits) / len(records),
+        "prototype": len(prototype_hits) / len(records),
+        "local_environment": len(environment_hits) / len(records),
+        "domain": len(domain_hits) / len(records),
+        "hamiltonian": len(hamiltonian_hits) / len(records),
+        "quality": min(1.0, sum(qualities) / len(qualities)),
+    }
+    score = sum(weights.get(key, 0.0) * value for key, value in breakdown.items())
+    count_factor = min(1.0, len(records) / max(1, profile.min_records))
+    return {"score": score * count_factor, "raw_score": score, "count_factor": count_factor, "breakdown": breakdown, "usable_records": len(records)}
