+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+from typing import Any
+
+from ai_ready_db.core.hashing import compute_structure_hash, generate_record_id
+from ai_ready_db.core.material_record import MaterialRecord
+
+
+TOTEN_RE = re.compile(r"free\s+energy\s+TOTEN\s+=\s+([-+0-9.Ee]+)")
+
+
+def _load_json_output(job_dir: Path) -> dict[str, Any] | None:
+    for name in ("result.json", "outputs.json", "parsed_vasp.json"):
+        path = job_dir / name
+        if path.exists():
+            return json.loads(path.read_text(encoding="utf-8"))
+    return None
+
+
+def _parse_outcar(job_dir: Path) -> dict[str, Any]:
+    outcar = job_dir / "OUTCAR"
+    if not outcar.exists():
+        raise FileNotFoundError(f"No parseable VASP output found in {job_dir}")
+    text = outcar.read_text(encoding="utf-8", errors="ignore")
+    energies = [float(match.group(1)) for match in TOTEN_RE.finditer(text)]
+    if not energies:
+        raise ValueError(f"Could not parse TOTEN energy from {outcar}")
+    return {
+        "energy": energies[-1],
+        "converged": "reached required accuracy" in text.lower()
+        or "aborting loop because ediff is reached" in text.lower(),
+        "parser": "outcar_minimal",
+    }
+
+
+def parse_vasp_recalc_output(job_dir: str | Path) -> dict[str, Any]:
+    job_path = Path(job_dir)
+    metadata_path = job_path / "metadata.json"
+    if not metadata_path.exists():
+        raise FileNotFoundError(f"Missing recalculation metadata: {metadata_path}")
+    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
+    output = _load_json_output(job_path) or _parse_outcar(job_path)
+    if output.get("converged") is False:
+        raise ValueError(f"VASP recalculation did not converge for {job_path}")
+    if output.get("energy") is None and output.get("energy_per_atom") is None:
+        raise ValueError(f"Parsed output has no energy for {job_path}")
+    return {"metadata": metadata, "output": output}
+
+
+def build_recalculated_record(parsed: dict[str, Any], workflow_id: str | None = None) -> MaterialRecord:
+    metadata = parsed["metadata"]
+    output = parsed["output"]
+    structure = metadata.get("structure") or metadata.get("candidate", {}).get("structure") or {}
+    elements = [str(element) for element in metadata.get("elements") or []]
+    nsites = int(output.get("nsites") or metadata.get("candidate", {}).get("nsites") or len(structure.get("sites") or []) or 0)
+    formula_reduced = str(metadata.get("formula_reduced") or "UNKNOWN")
+    energy = output.get("energy")
+    energy_per_atom = output.get("energy_per_atom")
+    if energy_per_atom is None and energy is not None and nsites:
+        energy_per_atom = float(energy) / nsites
+    composition = metadata.get("candidate", {}).get("composition") or {}
+    if not composition:
+        for element in elements:
+            composition[element] = 0.0
+        for site in structure.get("sites") or []:
+            if isinstance(site, dict):
+                species = site.get("specie") or site.get("element") or site.get("label")
+                composition[str(species)] = composition.get(str(species), 0.0) + 1.0
+    structure_hash = compute_structure_hash(structure, formula_reduced, elements, nsites)
+    record_id = generate_record_id(
+        source_dataset=str(metadata.get("source_dataset")),
+        source_id=str(metadata.get("source_id")),
+        structure_hash=structure_hash,
+        energy=float(energy) if energy is not None else None,
+        functional="PBE",
+        has_hubbard_u=False,
+        calculation_type="vasp_recalculation",
+    )
+    return MaterialRecord(
+        record_id=record_id,
+        source_dataset=str(metadata.get("source_dataset")),
+        source_id=str(metadata.get("source_id")),
+        structure=structure,
+        formula_pretty=formula_reduced,
+        formula_reduced=formula_reduced,
+        composition=composition,
+        elements=elements,
+        nsites=nsites,
+        volume=output.get("volume"),
+        density=output.get("density"),
+        structure_hash=structure_hash,
+        energy=float(energy) if energy is not None else None,
+        energy_per_atom=float(energy_per_atom) if energy_per_atom is not None else None,
+        forces=output.get("forces"),
+        stress=output.get("stress"),
+        magmom=output.get("magmom"),
+        charge=output.get("charge"),
+        functional="PBE",
+        hubbard_u=None,
+        has_transition_metal=False,
+        calculation_type="vasp_recalculation",
+        calculation_parameters={"disable_ldau": True, "vasp_preset": metadata.get("vasp_preset", "omat24_like")},
+        source_metadata={"recalculation_parser": output.get("parser", "json"), "input_hash": metadata.get("input_hash")},
+        screening={"accepted": True, "reason": "recalculated_no_u"},
+        provenance={
+            "source_dataset": metadata.get("source_dataset"),
+            "source_id": metadata.get("source_id"),
+            "original_dft_u_record_id": metadata.get("original_dft_u_record_id"),
+        },
+        original_dft_u_record_id=metadata.get("original_dft_u_record_id"),
+        workflow_id=workflow_id,
+    )
