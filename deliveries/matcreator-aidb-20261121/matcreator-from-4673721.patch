+
+from ai_ready_db.ai_ready_db_Renaissance.local.local_workspace import LocalASEWorkspace
+from ai_ready_db.ai_ready_db_Renaissance.fine_tune_planer.target_profile import TargetProfile
+from ai_ready_db.core.material_record import MaterialRecord
+
+_CLOUD_QUERY_HOOK = None
+
+
+def set_cloud_query_hook(func) -> None:
+    global _CLOUD_QUERY_HOOK
+    _CLOUD_QUERY_HOOK = func
+
+
+def query_cloud_by_target_profile(profile: TargetProfile, limit: int) -> list[MaterialRecord]:
+    if _CLOUD_QUERY_HOOK is not None:
+        return list(_CLOUD_QUERY_HOOK(profile, limit))
+    return []
+
+
+def pull_cloud_records_to_local(records: list[MaterialRecord], workspace: LocalASEWorkspace) -> dict[str, Any]:
+    pulled = 0
+    for record in records:
+        record.source_metadata["cloud_record_id"] = record.source_metadata.get("cloud_record_id") or record.record_id
+        workspace.write_record(record, namespace="bulk_base_pbe" if not record.has_hubbard_u else "bulk_dft_u_archive", origin="cloud_retrieved", sync_status="retrieved_from_cloud")
+        pulled += 1
+    return {"pulled": pulled, "record_ids": [record.record_id for record in records]}
+
+
+def sync_local_record_to_cloud(record_id: str, workspace: LocalASEWorkspace) -> dict[str, Any]:
+    record = workspace.get_record(record_id)
+    if record is None:
+        return {"synced": False, "error": f"record not found: {record_id}"}
+    return {
+        "synced": False,
+        "requires_user_confirmation": True,
+        "record_id": record_id,
+        "message": "Cloud upload is explicit only; no automatic sync was performed.",
+    }
