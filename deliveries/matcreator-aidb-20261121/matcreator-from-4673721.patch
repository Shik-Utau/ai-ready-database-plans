index 0000000..7daca98
--- /dev/null
+++ b/delivery/vendor/ai-ready-db/ai_ready_db/database/models.py
@@ -0,0 +1,204 @@
+from __future__ import annotations
+
+from sqlalchemy import (
+    ARRAY,
+    Boolean,
+    CheckConstraint,
+    DateTime,
+    Float,
+    ForeignKey,
+    Index,
+    Integer,
+    MetaData,
+    String,
+    Text,
+    func,
+)
+from sqlalchemy.dialects.postgresql import JSONB, UUID
+from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column
+
+
+class Base(DeclarativeBase):
+    metadata = MetaData()
+
+
+class CleanStructure(Base):
+    __tablename__ = "structures"
+    __table_args__ = (
+        Index("idx_clean_structures_record_id", "record_id", unique=True),
+        Index("idx_clean_structures_source_dataset", "source_dataset"),
+        Index("idx_clean_structures_source_id", "source_id"),
+        Index("idx_clean_structures_formula_reduced", "formula_reduced"),
+        Index("idx_clean_structures_elements", "elements", postgresql_using="gin"),
+        Index("idx_clean_structures_structure_hash", "structure_hash"),
+        Index("idx_clean_structures_composition", "composition", postgresql_using="gin"),
+        {"schema": "bulk_base_pbe"},
+    )
+
+    id: Mapped[str] = mapped_column(UUID(as_uuid=True), primary_key=True)
+    record_id: Mapped[str] = mapped_column(Text, unique=True, nullable=False)
+    source_dataset: Mapped[str] = mapped_column(Text, nullable=False)
+    source_id: Mapped[str] = mapped_column(Text, nullable=False)
+    formula_pretty: Mapped[str | None] = mapped_column(Text)
+    formula_reduced: Mapped[str] = mapped_column(Text, nullable=False)
+    composition: Mapped[dict] = mapped_column(JSONB, nullable=False)
+    elements: Mapped[list[str]] = mapped_column(ARRAY(Text), nullable=False)
+    nsites: Mapped[int] = mapped_column(Integer, nullable=False)
+    volume: Mapped[float | None] = mapped_column(Float)
+    density: Mapped[float | None] = mapped_column(Float)
+    structure_json: Mapped[dict] = mapped_column(JSONB, nullable=False)
+    structure_hash: Mapped[str] = mapped_column(Text, nullable=False)
+    created_at = mapped_column(DateTime(timezone=True), server_default=func.now(), nullable=False)
+
+
+class CleanCalculation(Base):
+    __tablename__ = "calculations"
+    __table_args__ = (
+        CheckConstraint("has_hubbard_u = false", name="ck_clean_calculations_no_dft_u"),
+        Index("idx_clean_calculations_record_id", "record_id", unique=True),
+        Index("idx_clean_calculations_functional", "functional"),
+        Index("idx_clean_calculations_energy_per_atom", "energy_per_atom"),
