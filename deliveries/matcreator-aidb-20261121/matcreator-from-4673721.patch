+        "clouddb": "postgres",
+        "cloud_db": "postgres",
+        "local": "ase_sqlite",
+        "sqlite": "ase_sqlite",
+        "sqlite3": "ase_sqlite",
+        "ase": "ase_sqlite",
+        "ase_db": "ase_sqlite",
+        "ase_json": "ase_json",
+        "json": "ase_json",
+    }
