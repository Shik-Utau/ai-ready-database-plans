+
+def list_ai_ready_db_actions() -> list[str]:
+    """List stable user-facing Ai-ready_db_Renaissance actions."""
+
+    return list(available_agent_actions())
+
+
+def run_ai_ready_db_Renaissance_action(action: str, config_path: str) -> dict[str, Any]:
+    """Run one user-facing Ai-ready_db_Renaissance action from a YAML config file."""
+
+    return handle_agent_action(action, config_path)
+
+
+def generate_vasp_inputs(structure: dict[str, Any], output_dir: str, mode: str = "relax", user_incar_settings: dict[str, Any] | None = None) -> dict[str, Any]:
+    """Generate VASP inputs from a pymatgen-compatible structure dictionary."""
+
+    if mode == "relax":
+        path = generate_vasp_relax_inputs(structure, output_dir, user_incar_settings)
+    elif mode == "static":
+        path = generate_vasp_static_inputs(structure, output_dir, user_incar_settings)
+    else:
+        raise ValueError("mode must be 'relax' or 'static'")
+    return {"mode": mode, "output_dir": str(Path(path))}
+
+
+def reforge_omat_database(config_path: str) -> dict[str, Any]:
+    """Reforge the PostgreSQL cloud database from OMAT using a YAML config file."""
+
+    return reforge_omat_to_postgres(config_path)
+
+
+def project_overview() -> str:
+    """Read the repository-level architecture overview."""
+
+    return _read_text("README.md")
+
+
+def renaissance_workflow_guide() -> str:
+    """Read the user-facing Ai-ready_db_Renaissance workflow guide."""
+
+    return _read_text("ai_ready_db/ai_ready_db_Renaissance/README.md")
+
+
+def reforging_workflow_guide() -> str:
+    """Read the backend Ai-ready_db_Reforging workflow guide."""
+
+    return _read_text("ai_ready_db/ai_ready_db_Reforging/README.md")
+
+
+def skill_policy() -> str:
+    """Read the agent policy for the user-facing Renaissance workflow."""
+
+    return _read_text("docs/ai_ready_materials_db_skill/SKILL.md")
+
+
+def tool_selection_guide() -> dict[str, Any]:
+    """Return the short decision guide agents should read before choosing a tool."""
+
+    return {
+        "read_first": [
+            "ai-ready-db://project/overview",
+            "ai-ready-db://workflow/renaissance",
+            "ai-ready-db://workflow/reforging",
+            "ai-ready-db://policy/skill",
+        ],
+        "tool_map": {
+            "initialize user-side Renaissance workflow": "run_ai_ready_db_Renaissance_action(action='renaissance_start', ...)",
+            "archive finished DFT outputs into local ASE database": "run_ai_ready_db_Renaissance_action(action='finalize_dft', ...)",
+            "estimate fine-tune data gap before any new DFT": "run_ai_ready_db_Renaissance_action(action='finetune_plan', ...)",
+            "continue after user accepts cloud reuse": "run_ai_ready_db_Renaissance_action(action='accept_cloud_plan', ...)",
+            "continue after user rejects cloud reuse": "run_ai_ready_db_Renaissance_action(action='reject_cloud_plan', ...)",
+            "generate VASP inputs": "generate_vasp_inputs(...)",
+            "reforge PostgreSQL from OMAT": "reforge_omat_database(...)",
+        },
+        "must_not_skip": [
+            "Before new fine-tune DFT, report the data gap first.",
+            "Do not use cloud data before the user explicitly accepts it.",
+            "Do not treat failed or incomplete DFT outputs as valid records.",
+            "Keep local ASE SQLite as the private user-side store and PostgreSQL as the cloud-scale Reforging target.",
+        ],
+    }
+
+
+def choose_ai_ready_db_tool(task: str) -> str:
+    """Guide an agent to read resources before selecting an MCP tool."""
+
+    return f"""You are using the ai-ready-db MCP server.
+
+Before choosing a tool for this task, read these resources:
+1. ai-ready-db://project/overview
+2. ai-ready-db://decision/tool-selection
+3. ai-ready-db://workflow/renaissance if the task concerns local DFT, fine-tuning, VASP input generation, or user-owned data
+4. ai-ready-db://workflow/reforging if the task concerns OMAT ingestion, cleaning, deduplication, or PostgreSQL Reforging
+5. ai-ready-db://policy/skill before any user-facing fine-tune workflow
+
+Task:
+{task}
+
+Decision rules:
+- If the task is about local user workflow, prefer run_ai_ready_db_Renaissance_action.
+- If the task is about generating VASP inputs, use generate_vasp_inputs.
+- If the task is about reforging the cloud database from OMAT, use reforge_omat_database.
+- For fine-tuning, never schedule new DFT before running the gap plan.
+- Never use cloud data until the user explicitly accepts cloud reuse.
+
+After reading the relevant resources, briefly explain which tool you will use and why before calling it."""
+
+
+def plan_finetune_with_user_gate(config_path: str) -> str:
+    """Prompt template for the fine-tuning workflow with the required user decision gate."""
+
+    return f"""Read ai-ready-db://workflow/renaissance, ai-ready-db://policy/skill, and ai-ready-db://decision/tool-selection.
+
+Then:
+1. Call run_ai_ready_db_Renaissance_action with action='finetune_plan' and config_path='{config_path}'.
+2. Present the reported local/cloud counts and savings to the user.
+3. Ask whether cloud reuse is allowed.
+4. Only after the user's answer:
+   - call action='accept_cloud_plan' if accepted, or
+   - call action='reject_cloud_plan' if rejected.
+
+Do not launch or imply new DFT before step 1 has completed."""
+
+
+mcp.tool(list_ai_ready_db_actions)
+mcp.tool(run_ai_ready_db_Renaissance_action)
+mcp.tool(generate_vasp_inputs)
+mcp.tool(reforge_omat_database)
+mcp.resource("ai-ready-db://project/overview")(project_overview)
+mcp.resource("ai-ready-db://workflow/renaissance")(renaissance_workflow_guide)
+mcp.resource("ai-ready-db://workflow/reforging")(reforging_workflow_guide)
+mcp.resource("ai-ready-db://policy/skill")(skill_policy)
+mcp.resource("ai-ready-db://decision/tool-selection")(tool_selection_guide)
+mcp.prompt(choose_ai_ready_db_tool)
+mcp.prompt(plan_finetune_with_user_gate)
+
+
+def run() -> None:
+    """Start the FastMCP server with the default transport."""
+
+    mcp.run()
+
+
+if __name__ == "__main__":  # pragma: no cover
+    run()
