+++ b/delivery/vendor/ai-ready-db/ai_ready_db/cli.py
@@ -0,0 +1,454 @@
+from __future__ import annotations
+
+import argparse
+import json
+import logging
+import sys
+from pathlib import Path
+from typing import Any
+
+from ai_ready_db.config import get_canonical_database_backend, get_database_backend, load_config
+from ai_ready_db.ai_ready_db_Renaissance.cloud.cloud_sync import query_cloud_by_target_profile, sync_local_record_to_cloud
+from ai_ready_db.ai_ready_db_Renaissance.cloud.cloud_upload_policy import evaluate_cloud_upload
+from ai_ready_db.ai_ready_db_Renaissance.fine_tune_planer.dpa import DEFAULT_DPA_SKILL_ROOT, DPADataConversionPlan
+from ai_ready_db.ai_ready_db_Renaissance.fine_tune_planer.dpa import build_supplemental_dft_job_plan
+from ai_ready_db.ai_ready_db_Renaissance.fine_tune_planer.dpa import DPAFineTuneConfig, build_dpa_finetune_run
+from ai_ready_db.ai_ready_db_Renaissance.local.local_workspace import LocalASEWorkspace
+from ai_ready_db.ai_ready_db_Renaissance.local.local_query import summarize_local_workspace as summarize_ase_workspace
+from ai_ready_db.ai_ready_db_Renaissance.skills.finetune_mlff import FineTuningMLFFSkillPlanner
+from ai_ready_db.ai_ready_db_Renaissance.fine_tune_planer.target_profile import TargetProfile
+from ai_ready_db.ai_ready_db_Renaissance.cloud.cloud_sync import pull_cloud_records_to_local
+from ai_ready_db.ai_ready_db_Renaissance.fine_tune_planer.user_decision import accept_cloud_reuse, reject_cloud_reuse
+from ai_ready_db.core.normalization import normalize_json_record
+from ai_ready_db.ai_ready_db_Reforging.classify_and_route import classify_records_for_cloud, route_records_to_cloud, screen_classified_records
+from ai_ready_db.ai_ready_db_Reforging.ingest import load_cleaning_records, read_records_jsonl, write_records_jsonl
+from ai_ready_db.ai_ready_db_Reforging.vasp_recalc.input_writer import write_vasp_recalc_input
+from ai_ready_db.ai_ready_db_Reforging.vasp_recalc.parser import build_recalculated_record, parse_vasp_recalc_output
+from ai_ready_db.ai_ready_db_Reforging.workflows.dflow_recalc import submit_prepared_recalc_jobs
+from ai_ready_db.database.factory import create_database, init_database, repository_bundle, status_counts
+from ai_ready_db.ai_ready_db_Reforging.build_base_database import ingest_base_database
+
+LOGGER = logging.getLogger(__name__)
+
+
+def _setup_logging(verbose: bool = False) -> None:
+    logging.basicConfig(
+        level=logging.DEBUG if verbose else logging.INFO,
+        format="%(levelname)s %(name)s: %(message)s",
+    )
+
+
+def _load_engine(args: argparse.Namespace):
+    config = load_config(args.config)
+    return config, create_database(config)
+
+
+def cmd_init_db(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    backend = get_canonical_database_backend(config)
+    database = create_database(config)
+    init_database(config, database)
+    location = config.get("postgres", {}).get("url")
+    return {"database_schema_created": True, "backend": backend, "location": location}
+
+
+def cmd_ingest(args: argparse.Namespace) -> dict[str, Any]:
+    config, engine = _load_engine(args)
+    return ingest_base_database(config, engine)
+
+
+def _load_cleaning_input(args: argparse.Namespace, config: dict[str, Any]) -> list[Any]:
+    if getattr(args, "input_jsonl", None):
+        return read_records_jsonl(args.input_jsonl)
+    return load_cleaning_records(config)
+
+
+def cmd_classify(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    records = _load_cleaning_input(args, config)
+    classified = classify_records_for_cloud(records)
+    if args.output:
+        write_records_jsonl([item.record for item in classified], args.output)
+    counts: dict[str, int] = {}
+    for item in classified:
+        name = item.namespace["name"]
+        counts[name] = counts.get(name, 0) + 1
+    return {
+        "classified_records": len(classified),
+        "counts_by_namespace": counts,
+        "output": args.output,
+    }
+
+
+def cmd_screen(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    records = _load_cleaning_input(args, config)
+    classified = classify_records_for_cloud(records)
+    accepted, report = screen_classified_records(classified, config.get("screening", {}))
+    if args.output:
+        write_records_jsonl([item.record for item in accepted], args.output)
+    return {
+        "input_records": len(classified),
+        "accepted_records": len(accepted),
+        "output": args.output,
+        "screening": report,
+        "uses_ase_sqlite_as_canonical": False,
+    }
+
+
+def cmd_route_to_cloud(args: argparse.Namespace) -> dict[str, Any]:
+    config, database = _load_engine(args)
+    records = _load_cleaning_input(args, config)
+    return route_records_to_cloud(records, config, database)
+
+
+def _candidate_from_job(job: dict[str, Any]) -> dict[str, Any]:
+    input_metadata = job.get("input_metadata") or {}
+    if isinstance(input_metadata, dict):
+        candidate = input_metadata.get("candidate")
+        if isinstance(candidate, dict):
+            return candidate
+    return {
+        "original_dft_u_record_id": job["original_dft_u_record_id"],
+        "source_dataset": job["source_dataset"],
+        "source_id": job["source_id"],
+        "formula_reduced": job["formula_reduced"],
+        "elements": job["elements"],
+        "structure": {},
+        "target_functional": job.get("target_functional", "PBE"),
+        "target_disable_ldau": job.get("target_disable_ldau", True),
+        "recommended_job_dir": job["job_dir"],
+    }
+
+
+def cmd_prepare_recalc(args: argparse.Namespace) -> dict[str, Any]:
+    config, database = _load_engine(args)
+    repos = repository_bundle(config, database)
+    job_repo = repos.recalc_jobs
+    dft_repo = repos.dft_u
+    jobs = job_repo.get_pending_jobs(args.limit)
+    prepared = 0
+    failed = 0
+    for job in jobs:
+        original_id = job["original_dft_u_record_id"]
+        try:
+            candidate = _candidate_from_job(job)
+            output_dir = candidate.get("recommended_job_dir") or job["job_dir"]
+            path = write_vasp_recalc_input(candidate, output_dir, config)
+            metadata = dict(job.get("input_metadata") or {})
+            metadata.update({"prepared_job_dir": str(path), "candidate": candidate})
+            job_repo.update_status(original_id, "prepared", input_metadata=metadata)
+            dft_repo.update_recalc_status(original_id, "prepared")
+            prepared += 1
+        except Exception as exc:  # noqa: BLE001
+            LOGGER.exception("Failed to prepare recalculation input for %s", original_id)
+            job_repo.update_status(original_id, "failed", error_message=str(exc))
+            dft_repo.update_recalc_status(original_id, "failed", error_message=str(exc))
+            failed += 1
+    return {"pending_jobs": len(jobs), "prepared": prepared, "failed": failed}
+
+
+def cmd_submit_recalc(args: argparse.Namespace) -> dict[str, Any]:
+    config, database = _load_engine(args)
+    return submit_prepared_recalc_jobs(config, database, args.limit)
+
+
+def cmd_archive_recalc(args: argparse.Namespace) -> dict[str, Any]:
+    config, database = _load_engine(args)
+    repos = repository_bundle(config, database)
+    job_repo = repos.recalc_jobs
+    clean_repo = repos.clean
+    dft_repo = repos.dft_u
+    jobs = job_repo.get_completed_jobs(args.limit)
+    archived = 0
+    failed = 0
+    for job in jobs:
+        original_id = job["original_dft_u_record_id"]
+        workflow_id = job.get("dflow_workflow_id")
+        try:
+            parsed = parse_vasp_recalc_output(job["job_dir"])
+            record = build_recalculated_record(parsed, workflow_id)
+            clean_repo.insert_recalculated_record(record, original_id, workflow_id)
+            job_repo.update_status(
+                original_id,
+                "archived",
+                clean_record_id=record.record_id,
+                output_metadata={"parsed": parsed["output"]},
+            )
+            dft_repo.update_recalc_status(
+                original_id,
+                "completed",
+                workflow_id=workflow_id,
+                clean_record_id=record.record_id,
+            )
+            archived += 1
+        except Exception as exc:  # noqa: BLE001
+            LOGGER.exception("Failed to archive recalculation result for %s", original_id)
+            job_repo.update_status(original_id, "failed", error_message=str(exc))
+            dft_repo.update_recalc_status(original_id, "failed", error_message=str(exc))
+            failed += 1
+    return {"completed_jobs": len(jobs), "archived": archived, "failed": failed}
+
+
+def cmd_status(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    backend = get_database_backend(config)
+    if backend == "postgres":
+        database = create_database(config)
+        return status_counts(config, database)
+    return summarize_ase_workspace(LocalASEWorkspace(config))
+
+
+def _load_target_profile(path: str) -> TargetProfile:
+    import yaml
+
+    with open(path, "r", encoding="utf-8") as handle:
+        return TargetProfile.from_dict(yaml.safe_load(handle) or {})
+
+
+def cmd_archive_local(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    raw = json.loads(Path(args.record_json).read_text(encoding="utf-8"))
+    record = normalize_json_record(raw, raw.get("source_dataset", "local"))
+    workspace = LocalASEWorkspace(config)
+    record_id = workspace.write_record(record, args.namespace, args.origin, args.sync_status)
+    return {"archived": True, "record_id": record_id, "namespace": args.namespace}
+
+
+def cmd_local_status(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    return summarize_ase_workspace(LocalASEWorkspace(config))
+
+
+def cmd_plan_finetune(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    profile = _load_target_profile(args.profile)
+    return FineTuningMLFFSkillPlanner(config, LocalASEWorkspace(config)).plan(profile).to_dict()
+
+
+def cmd_accept_cloud_reuse(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    profile = _load_target_profile(args.profile)
+    return accept_cloud_reuse(profile, LocalASEWorkspace(config), config, limit=args.limit)
+
+
+def cmd_reject_cloud_reuse(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    profile = _load_target_profile(args.profile)
+    return reject_cloud_reuse(profile, LocalASEWorkspace(config), config)
+
+
+def cmd_run_supplement_dft(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    dpa_cfg = config.get("dpa_finetune", {})
+    plan = build_supplemental_dft_job_plan(args.structure, output_dir=args.output_dir)
+    return {
+        "status": "planned",
+        "bohrium_submission": "TODO",
+        "supplemental_dft_job_plan": plan.to_dict(),
+        "prototype_root": dpa_cfg.get("prototype_root", DEFAULT_DPA_SKILL_ROOT),
+        "new_records_policy": {"origin": "local_calculation", "sync_status": "local_only", "automatic_upload": False},
+    }
+
+
+def cmd_run_finetune(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    dpa_cfg = config.get("dpa_finetune", {})
+    conversion = DPADataConversionPlan(
+        dft_dirs=args.dft_dir,
+        output=args.data_dir or dpa_cfg.get("data_dir", "fine_tune_planer/data"),
+        valid_ratio=args.valid_ratio,
+        min_frames=args.min_frames,
+    )
+    train_config = DPAFineTuneConfig(
+        model=args.model or dpa_cfg.get("base_model", "DPA-3.1-3M.pt"),
+        branch=args.head if args.head is not None else dpa_cfg.get("head", "Omat24"),
+        data_dir=conversion.output,
+        steps=args.steps or int(dpa_cfg.get("steps", 10000)),
+        output=args.input_json,
+    )
+    prototype_root = dpa_cfg.get("prototype_root", DEFAULT_DPA_SKILL_ROOT)
+    run = build_dpa_finetune_run(train_config, prototype_root)
+    return {
+        "status": "planned",
+        "bohrium_submission": "TODO",
+        "data_conversion": {"spec": conversion.to_dict(), "command": conversion.build_command(prototype_root)},
+        "fine_tune_run": run.to_dict(),
+    }
+
+
+def cmd_export_local(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    workspace = LocalASEWorkspace(config)
+    output = workspace.export_records(args.record_id, args.output, args.format)
+    return {"exported": True, "output_path": output, "record_count": len(args.record_id)}
+
+
+def cmd_pull_from_cloud(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    profile = _load_target_profile(args.profile)
+    records = query_cloud_by_target_profile(profile, args.limit)
+    return pull_cloud_records_to_local(records, LocalASEWorkspace(config))
+
+
+def cmd_sync_to_cloud(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    workspace = LocalASEWorkspace(config)
+    return {"automatic_upload": False, "results": [sync_local_record_to_cloud(record_id, workspace) for record_id in args.record_id]}
+
+
+def cmd_upload_new_records_to_cloud(args: argparse.Namespace) -> dict[str, Any]:
+    config = load_config(args.config)
+    workspace = LocalASEWorkspace(config)
+    results = []
+    for record_id in args.record_id:
+        record = workspace.get_record(record_id)
+        if record is None:
+            results.append({"record_id": record_id, "upload_allowed": False, "validation_errors": ["record_not_found"]})
+            continue
+        results.append(evaluate_cloud_upload(record, allow_upload=args.allow_upload))
+    return {"automatic_upload": False, "results": results}
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="ai-ready-db",
+        description="AI-ready database CLI: runtime Fine Tuning MLFF Skill, offline cleaning, and local workspace commands.",
+    )
+    parser.add_argument("--verbose", action="store_true")
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    def add_config(subparser: argparse.ArgumentParser) -> None:
+        subparser.add_argument("--config", default="configs/base_database.yaml")
+
+    init_db = subparsers.add_parser("init-db")
+    add_config(init_db)
+    init_db.set_defaults(func=cmd_init_db)
+
+    ingest = subparsers.add_parser("ingest")
+    add_config(ingest)
+    ingest.set_defaults(func=cmd_ingest)
+
+    classify = subparsers.add_parser("classify")
+    add_config(classify)
+    classify.add_argument("--input-jsonl", default=None)
+    classify.add_argument("--output", default=None)
+    classify.set_defaults(func=cmd_classify)
+
+    screen = subparsers.add_parser("screen")
+    add_config(screen)
+    screen.add_argument("--input-jsonl", default=None)
+    screen.add_argument("--output", default=None)
+    screen.set_defaults(func=cmd_screen)
+
