@@ -0,0 +1,43 @@
+from __future__ import annotations
+
+from typing import Any
+
+from ai_ready_db.chemistry.elements import DEFAULT_TRANSITION_METALS, has_transition_metal
+from ai_ready_db.core.material_record import MaterialRecord
+
+
+def _tag(name: str, confidence: float, source: str, evidence: dict[str, Any]) -> dict[str, Any]:
+    return {"tag": name, "confidence": confidence, "source": source, "evidence": evidence, "reviewed": False}
+
+
+def assign_structure_tags(record: MaterialRecord) -> list[dict[str, Any]]:
+    elements = set(record.elements)
+    formula = record.formula_reduced.lower()
+    metadata = {**record.source_metadata, **record.provenance}
+    tags = [_tag("bulk", 0.5, "rule", {"default_mvp_assumption": True})]
+    if "O" in elements:
+        tags.append(_tag("oxide", 1.0, "rule", {"elements": record.elements}))
+    if len(elements) > 1 and "O" not in elements:
+        tags.append(_tag("alloy", 0.7, "rule", {"elements": record.elements}))
+    if "Li" in elements:
+        tags.append(_tag("lithium_containing", 1.0, "rule", {"elements": record.elements}))
+    if has_transition_metal(record.elements, DEFAULT_TRANSITION_METALS):
+        tags.append(_tag("contains_transition_metal", 1.0, "rule", {"elements": record.elements}))
+    if record.trajectory_id is not None or record.frame_index is not None:
+        tags.append(_tag("trajectory_frame", 1.0, "rule", {"trajectory_id": record.trajectory_id, "frame_index": record.frame_index}))
+    sampling_type = str(record.sampling_type or metadata.get("sampling_type") or "").lower()
+    if "rattle" in sampling_type or "rattle" in str(metadata).lower():
+        tags.append(_tag("rattled_structure", 0.9, "rule", {"sampling_type": sampling_type}))
+    if "relax" in str(record.calculation_type or "").lower() or metadata.get("relaxed_final_structure"):
+        tags.append(_tag("relaxed_final_structure", 0.8, "rule", {"calculation_type": record.calculation_type}))
+
+    prototype = None
+    for name in ("garnet", "perovskite", "spinel", "rocksalt", "fluorite"):
+        if name in formula or name in str(metadata).lower():
+            prototype = name
+            tags.append(_tag(name, 0.8, "rule", {"formula": record.formula_reduced, "metadata": metadata}))
+            break
+    if prototype is None:
+        tags.append(_tag("unknown_prototype", 0.3, "rule", {"formula": record.formula_reduced}))
+    record.tags = tags
+    return tags
