+from __future__ import annotations
+
+import json
+import shutil
+from collections import Counter
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from ai_ready_db.core.ase_converters import write_extxyz
+from ai_ready_db.ai_ready_db_Renaissance.local.dataset_manifest import build_dataset_manifest
+from ai_ready_db.core.hashing import stable_digest
+from ai_ready_db.core.material_record import MaterialRecord
+
+
+def _manifest(records: list[MaterialRecord], config: dict, target_profile: dict | None, namespaces: dict[str, str] | None, coverage_score: float | None) -> dict[str, Any]:
+    base = build_dataset_manifest(records, query=target_profile or {}, config=config)
+    base.update(
+        {
+            "export_id": stable_digest({"records": [record.record_id for record in records], "created_at": datetime.now(timezone.utc).isoformat()})[:16],
+            "target_profile": target_profile or {},
+            "source_records": [record.record_id for record in records],
+            "local_cloud_origin_distribution": dict(Counter(record.source_metadata.get("origin", "local") for record in records)),
+            "namespace_distribution": dict(Counter((namespaces or {}).get(record.record_id, record.source_metadata.get("logical_namespace", "unknown")) for record in records)),
+            "functional_distribution": dict(Counter(str(record.functional) for record in records)),
+            "hubbard_u_fraction": sum(1 for record in records if record.has_hubbard_u) / len(records) if records else 0.0,
+            "formula_distribution": dict(Counter(record.formula_reduced for record in records)),
+            "tag_distribution": dict(Counter(tag["tag"] for record in records for tag in record.tags if isinstance(tag, dict) and "tag" in tag)),
+            "coverage_score": coverage_score,
+            "created_at": datetime.now(timezone.utc).isoformat(),
+        }
+    )
+    return base
+
+
+def export_local_records(
+    records: list[MaterialRecord],
+    output_path: str | Path,
+    format: str = "extxyz",
+    config: dict | None = None,
+    target_profile: dict | None = None,
+    namespaces: dict[str, str] | None = None,
+    coverage_score: float | None = None,
+) -> dict[str, Any]:
+    config = config or {}
+    output = Path(output_path)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    fmt = format.lower()
+    if fmt == "extxyz":
+        write_extxyz(records, output)
+    elif fmt == "jsonl":
+        with output.open("w", encoding="utf-8") as handle:
+            for record in records:
+                handle.write(json.dumps(record.to_dict(), sort_keys=True, default=str) + "\n")
+    elif fmt in {"ase_db", "db"}:
+        from ase.db import connect
+
+        if output.exists():
+            output.unlink()
+        with connect(str(output)) as db:
+            from ai_ready_db.ai_ready_db_Renaissance.local.local_converters import material_record_to_atoms
+
+            for record in records:
+                db.write(material_record_to_atoms(record), key_value_pairs={"record_id": record.record_id, "formula_reduced": record.formula_reduced})
+    else:
+        raise ValueError(f"Unsupported export format: {format}")
+    manifest = _manifest(records, config, target_profile, namespaces, coverage_score)
+    manifest_path = output.parent / "dataset_manifest.json"
+    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True, default=str), encoding="utf-8")
+    configured_manifest = config.get("outputs", {}).get("dataset_manifest_json") if config else None
+    if configured_manifest:
+        configured_path = Path(configured_manifest)
+        configured_path.parent.mkdir(parents=True, exist_ok=True)
+        if configured_path.resolve() != manifest_path.resolve():
+            shutil.copyfile(manifest_path, configured_path)
+    return {"output_path": str(output), "manifest_path": str(manifest_path), "record_count": len(records), "manifest": manifest}
