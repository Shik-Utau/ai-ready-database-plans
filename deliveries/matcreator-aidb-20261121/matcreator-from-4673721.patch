+    def list_recalc_candidates(self, limit: int | None = None) -> list[dict[str, Any]]:
+        sql = f"""
+            SELECT c.record_id AS original_dft_u_record_id, s.source_dataset, s.source_id,
+                   s.formula_reduced, s.elements, s.structure_json AS structure,
+                   c.hubbard_u AS original_hubbard_u
+            FROM {self.dft_u_schema}.calculations c
+            JOIN {self.dft_u_schema}.structures s ON s.id = c.structure_id
+            WHERE c.recalc_status = 'pending' AND c.has_transition_metal = true
+            ORDER BY c.created_at, c.record_id
+        """
+        if limit is not None:
+            sql += " LIMIT :limit"
+        with self.engine.begin() as conn:
