+from __future__ import annotations
+
+from typing import Any
+
+from sqlalchemy import create_engine, text
+
+
+def connect_postgres(uri: str):
+    return create_engine(uri)
+
+
+def _where_clause(query: dict[str, Any]) -> tuple[str, dict[str, Any]]:
+    supported = {"software", "xc_functional", "spin_state", "system_type"}
+    clauses = []
+    params: dict[str, Any] = {}
+    for key, value in query.items():
+        if key not in supported:
+            continue
+        clauses.append(f"{key} = :{key}")
+        params[key] = value
+    return (" WHERE " + " AND ".join(clauses)) if clauses else "", params
+
+
+def query_relevant_cloud_records(uri: str, query: dict[str, Any], limit: int | None = None) -> list[dict[str, Any]]:
+    where, params = _where_clause(query)
+    limit_sql = " LIMIT :limit" if limit is not None else ""
+    if limit is not None:
+        params["limit"] = limit
+    sql = text(f"SELECT * FROM materials_records{where} ORDER BY id{limit_sql}")
+    with connect_postgres(uri).begin() as conn:
+        return [dict(row._mapping) for row in conn.execute(sql, params)]
+
+
+def count_relevant_cloud_records(uri: str, query: dict[str, Any]) -> int:
+    where, params = _where_clause(query)
+    sql = text(f"SELECT count(*) FROM materials_records{where}")
+    with connect_postgres(uri).begin() as conn:
+        return int(conn.execute(sql, params).scalar_one())
+
+
+def fetch_cloud_records(uri: str, query: dict[str, Any], limit: int | None = None) -> list[dict[str, Any]]:
+    return query_relevant_cloud_records(uri, query, limit=limit)
