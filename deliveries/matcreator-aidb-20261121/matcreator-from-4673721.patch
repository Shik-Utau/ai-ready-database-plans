+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable
+
+from ai_ready_db.core.classification import classify_record_four_layers
+from ai_ready_db.core.dft_defaults import get_default_dft_profile
+from ai_ready_db.core.routing import route_record_to_cloud_namespace
+from ai_ready_db.database.factory import repository_bundle
+from ai_ready_db.core.material_record import MaterialRecord
+from ai_ready_db.ai_ready_db_Reforging.screening.bias_screen import screen_records
+
+
+@dataclass(frozen=True)
+class ClassifiedRecord:
+    record: MaterialRecord
+    classification: dict[str, Any]
+    dft_profile: dict[str, Any]
+    namespace: dict[str, Any]
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "record": self.record.to_dict(),
+            "classification": self.classification,
+            "dft_profile": self.dft_profile,
+            "namespace": self.namespace,
+        }
+
+
+def classify_record_for_cloud(record: MaterialRecord) -> ClassifiedRecord:
+    classification = classify_record_four_layers(record)
+    dft_profile = get_default_dft_profile(classification, record.calculation_parameters)
+    namespace = route_record_to_cloud_namespace(classification, dft_profile)
+    record.source_metadata["cloud_namespace"] = namespace.to_dict()
+    return ClassifiedRecord(record, classification.to_dict(), dft_profile.to_dict(), namespace.to_dict())
+
+
+def classify_records_for_cloud(records: Iterable[MaterialRecord]) -> list[ClassifiedRecord]:
+    return [classify_record_for_cloud(record) for record in records]
+
+
+def screen_classified_records(classified: list[ClassifiedRecord], screening_config: dict[str, Any]) -> tuple[list[ClassifiedRecord], dict[str, Any]]:
+    clean = [item.record for item in classified if item.namespace["name"] == "bulk_base_pbe"]
+    accepted_clean, report = screen_records(clean, screening_config)
+    accepted_clean_ids = {record.record_id for record in accepted_clean}
+    accepted = [
+        item
+        for item in classified
+        if item.namespace["name"] != "bulk_base_pbe" or item.record.record_id in accepted_clean_ids
+    ]
+    return accepted, report
+
+
+def route_records_to_cloud(records: Iterable[MaterialRecord], config: dict[str, Any], database: Any) -> dict[str, Any]:
+    repos = repository_bundle(config, database)
+    if repos.routed is None:
+        raise ValueError("route-to-cloud requires a routed CloudDB repository")
+    classified = classify_records_for_cloud(records)
+    accepted, screening_report = screen_classified_records(classified, config.get("screening", {}))
+    counts: dict[str, int] = {}
+    routed: list[dict[str, Any]] = []
+    for item in accepted:
+        route = repos.routed.insert_routed_record(item.record)
+        namespace = route["namespace"]["name"]
+        counts[namespace] = counts.get(namespace, 0) + 1
+        routed.append(route)
+    return {
+        "loaded_records": len(classified),
+        "routed_records": len(routed),
+        "counts_by_namespace": counts,
+        "screening": screening_report,
+        "routes": routed,
+        "uses_ase_sqlite_as_canonical": False,
+    }
