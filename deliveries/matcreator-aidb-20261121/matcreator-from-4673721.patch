+    local_status.set_defaults(func=cmd_local_status)
+
+    plan = subparsers.add_parser("plan-finetune")
+    add_config(plan)
+    plan.add_argument("--profile", required=True)
+    plan.set_defaults(func=cmd_plan_finetune)
+
+    accept = subparsers.add_parser("accept-cloud-reuse")
+    add_config(accept)
+    accept.add_argument("--profile", required=True)
+    accept.add_argument("--limit", type=int, default=None)
+    accept.set_defaults(func=cmd_accept_cloud_reuse)
+
+    reject = subparsers.add_parser("reject-cloud-reuse")
+    add_config(reject)
