+from __future__ import annotations
+
+from ai_ready_db.ai_ready_db_Renaissance.evaluator.coverage import compute_coverage
+from ai_ready_db.ai_ready_db_Renaissance.fine_tune_planer.target_profile import TargetProfile
+from ai_ready_db.ai_ready_db_Renaissance.cloud.cloud_sync import query_cloud_by_target_profile
+from ai_ready_db.ai_ready_db_Renaissance.evaluator.cost_estimator import estimate_dft_gap, recommend_cloud_reuse_count
+from ai_ready_db.ai_ready_db_Renaissance.fine_tune_planer.plan import FineTuneMLFFPlan, FineTuneOption
+from ai_ready_db.ai_ready_db_Renaissance.local.local_workspace import LocalASEWorkspace
+from ai_ready_db.ai_ready_db_Renaissance.local.local_query import query_local_by_target_profile
+
+
+class FineTuningMLFFSkillPlanner:
+    def __init__(self, config: dict, workspace: LocalASEWorkspace | None = None):
+        self.config = config
+        self.workspace = workspace or LocalASEWorkspace(config)
+
+    def plan(self, profile: TargetProfile) -> FineTuneMLFFPlan:
+        retrieval = self.config.get("retrieval", {})
+        local_records = query_local_by_target_profile(profile, limit=retrieval.get("max_local_records_per_target"), workspace=self.workspace)
+        cloud_records = []
+        query_order = ["local_ase_sqlite"]
+        if retrieval.get("cloud_fallback", True):
+            query_order.append("postgres_cloud_metadata")
+            cloud_records = query_cloud_by_target_profile(profile, int(retrieval.get("max_cloud_records_to_pull", 500)))
+
+        local_gap = estimate_dft_gap(profile.min_records, len(local_records))
+        recommended_cloud = recommend_cloud_reuse_count(len(cloud_records), local_gap, retrieval.get("max_cloud_records_to_reuse"))
+        cloud_gap = estimate_dft_gap(profile.min_records, len(local_records) + recommended_cloud)
+        local_coverage = compute_coverage(local_records, profile, retrieval.get("coverage_weights"))
+        combined_coverage = compute_coverage(local_records + cloud_records[:recommended_cloud], profile, retrieval.get("coverage_weights"))
+
+        option_a = FineTuneOption(
+            name="local_only_no_clouddb_reuse",
+            existing_records=len(local_records),
+            cloud_records_available=0,
+            cloud_records_recommended=0,
+            additional_dft_required=local_gap,
+            upload_policy="new DFT remains local ASE SQLite unless explicit validated upload is requested",
+        )
+        option_b = FineTuneOption(
+            name="use_clouddb_reuse",
+            existing_records=len(local_records),
+            cloud_records_available=len(cloud_records),
+            cloud_records_recommended=recommended_cloud,
+            additional_dft_required=cloud_gap,
+            upload_policy="only newly computed DFT records may be upload-eligible; reused CloudDB records are not reuploaded",
+        )
+        recommended = option_b.name if cloud_gap < local_gap else option_a.name
+        return FineTuneMLFFPlan(
+            target_profile=profile.to_dict(),
+            local_records_found=len(local_records),
+            cloud_records_found=len(cloud_records),
+            recommended_cloud_records_for_reuse=recommended_cloud,
+            option_a=option_a,
+            option_b=option_b,
+            recommended_choice=recommended,
+            evidence={
+                "query_order": query_order,
+                "local_record_ids": [record.record_id for record in local_records],
+                "cloud_candidate_ids": [record.record_id for record in cloud_records],
+                "local_coverage": local_coverage,
+                "combined_coverage_after_recommended_cloud_reuse": combined_coverage,
+            },
+        )
diff --git a/delivery/vendor/ai-ready-db/ai_ready_db/ai_ready_db_Renaissance/vasp_io.py b/delivery/vendor/ai-ready-db/ai_ready_db/ai_ready_db_Renaissance/vasp_io.py
