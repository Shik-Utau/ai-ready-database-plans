+def evaluate_cloud_upload(record: MaterialRecord, allow_upload: bool = False) -> dict[str, Any]:
+    classification = classify_record_four_layers(record)
+    profile = get_default_dft_profile(classification, record.calculation_parameters)
+    namespace = route_record_to_cloud_namespace(classification, profile)
+    errors = validate_record_schema(record) + validate_upload_provenance(record)
+    return {
