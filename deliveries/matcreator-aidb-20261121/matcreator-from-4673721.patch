+
+def _json(value: Any) -> str:
+    return json.dumps(value if value is not None else {}, sort_keys=True, default=str)
+
+
+def _json_nullable(value: Any) -> str | None:
+    if value is None:
+        return None
+    return json.dumps(value, sort_keys=True, default=str)
+
+
+def _row_to_dict(row: Any) -> dict[str, Any] | None:
+    if row is None:
+        return None
+    return dict(row._mapping)
+
+
+class _BaseRepository:
+    def __init__(self, engine: Engine, config: Mapping[str, Any] | None = None):
+        self.engine = engine
+        schemas = get_schema_names(config or {"postgres": {}})
+        self.clean_schema = schemas["clean"]
+        self.dft_u_schema = schemas["dft_u"]
+        self.pbe_d3_schema = schemas["pbe_d3"]
+        self.special_schema = schemas["special"]
+        self.workflow_schema = schemas["workflow"]
+
+    @staticmethod
+    def _structure_params(record: MaterialRecord) -> dict[str, Any]:
+        return {
+            "id": uuid.uuid4(),
+            "record_id": record.record_id,
+            "source_dataset": record.source_dataset,
+            "source_id": record.source_id,
+            "ingest_run_id": record.ingest_run_id,
+            "formula_pretty": record.formula_pretty,
+            "formula_reduced": record.formula_reduced,
+            "composition": _json(record.composition),
+            "elements": record.elements,
+            "nsites": record.nsites,
+            "volume": record.volume,
+            "density": record.density,
+            "structure_json": _json(record.structure),
+            "structure_hash": record.structure_hash,
+            "trajectory_id": record.trajectory_id,
+            "frame_index": record.frame_index,
+            "parent_structure_id": record.parent_structure_id,
+            "sampling_type": record.sampling_type,
+        }
+
+    def _insert_structure(self, conn: Any, schema: str, record: MaterialRecord) -> uuid.UUID:
+        params = self._structure_params(record)
+        insert_sql = text(
+            f"""
+            INSERT INTO {schema}.structures (
+              id, record_id, source_dataset, source_id, ingest_run_id, formula_pretty, formula_reduced,
+              composition, elements, nsites, volume, density, structure_json, structure_hash,
+              trajectory_id, frame_index, parent_structure_id, sampling_type
+            )
+            VALUES (
+              :id, :record_id, :source_dataset, :source_id, :ingest_run_id, :formula_pretty, :formula_reduced,
+              CAST(:composition AS jsonb), CAST(:elements AS text[]), :nsites, :volume, :density,
+              CAST(:structure_json AS jsonb), :structure_hash,
+              :trajectory_id, :frame_index, :parent_structure_id, :sampling_type
+            )
+            ON CONFLICT (record_id) DO NOTHING
+            RETURNING id
+            """
+        )
+        row = conn.execute(insert_sql, params).first()
+        if row is not None:
+            return row._mapping["id"]
+        existing = conn.execute(
+            text(f"SELECT id FROM {schema}.structures WHERE record_id = :record_id"),
+            {"record_id": record.record_id},
+        ).first()
+        if existing is None:
+            raise RuntimeError(f"Failed to insert or find structure {record.record_id}")
+        return existing._mapping["id"]
+
+
+class CleanBaseRepository(_BaseRepository):
+    def insert_clean_record(self, record: MaterialRecord) -> str:
+        if record.has_hubbard_u:
+            raise ValueError("Refusing to insert original DFT+U record into clean PBE schema")
+        return self._insert_clean(record)
+
+    def insert_recalculated_record(
+        self,
+        record: MaterialRecord,
+        original_dft_u_record_id: str,
+        workflow_id: str | None,
+    ) -> str:
+        if record.has_hubbard_u:
+            raise ValueError("Recalculated clean record must have has_hubbard_u=false")
+        record.original_dft_u_record_id = original_dft_u_record_id
+        record.workflow_id = workflow_id
+        return self._insert_clean(record)
+
+    def _insert_clean(self, record: MaterialRecord) -> str:
+        with self.engine.begin() as conn:
+            structure_id = self._insert_structure(conn, self.clean_schema, record)
+            conn.execute(
+                text(
+                    f"""
+                    INSERT INTO {self.clean_schema}.calculations (
+                      id, structure_id, record_id, energy, energy_per_atom, forces_json, stress_json,
+                      stress_unit, stress_convention, virial_json, virial_unit,
+                      magmom_json, charge_json, functional, has_hubbard_u, calculation_type,
+                      calculation_parameters, source_metadata, screening_metadata, provenance,
+                      original_dft_u_record_id, workflow_id
+                    )
+                    VALUES (
+                      :id, :structure_id, :record_id, :energy, :energy_per_atom,
+                      CAST(:forces_json AS jsonb), CAST(:stress_json AS jsonb),
+                      :stress_unit, :stress_convention, CAST(:virial_json AS jsonb), :virial_unit,
+                      CAST(:magmom_json AS jsonb), CAST(:charge_json AS jsonb),
+                      :functional, false, :calculation_type,
+                      CAST(:calculation_parameters AS jsonb), CAST(:source_metadata AS jsonb),
+                      CAST(:screening_metadata AS jsonb), CAST(:provenance AS jsonb),
+                      :original_dft_u_record_id, :workflow_id
+                    )
+                    ON CONFLICT (record_id) DO NOTHING
+                    """
+                ),
+                {
+                    "id": uuid.uuid4(),
+                    "structure_id": structure_id,
+                    "record_id": record.record_id,
+                    "energy": record.energy,
+                    "energy_per_atom": record.energy_per_atom,
+                    "forces_json": _json_nullable(record.forces),
+                    "stress_json": _json_nullable(record.stress),
+                    "stress_unit": record.stress_unit,
+                    "stress_convention": record.stress_convention,
+                    "virial_json": _json_nullable(record.virial),
+                    "virial_unit": record.virial_unit,
+                    "magmom_json": _json_nullable(record.magmom),
+                    "charge_json": _json_nullable(record.charge),
+                    "functional": record.functional or "PBE",
+                    "calculation_type": record.calculation_type,
+                    "calculation_parameters": _json(record.calculation_parameters),
+                    "source_metadata": _json(record.source_metadata),
+                    "screening_metadata": _json(record.screening),
+                    "provenance": _json(record.provenance),
+                    "original_dft_u_record_id": record.original_dft_u_record_id,
+                    "workflow_id": record.workflow_id,
+                },
+            )
+        return record.record_id
+
+    def get_by_record_id(self, record_id: str) -> dict[str, Any] | None:
+        with self.engine.begin() as conn:
+            row = conn.execute(
+                text(
+                    f"""
+                    SELECT s.*, c.energy, c.energy_per_atom, c.functional,
+                           c.calculation_parameters, c.source_metadata, c.screening_metadata,
+                           c.provenance, c.original_dft_u_record_id, c.workflow_id
+                    FROM {self.clean_schema}.structures s
+                    JOIN {self.clean_schema}.calculations c ON c.structure_id = s.id
+                    WHERE c.record_id = :record_id
+                    """
+                ),
+                {"record_id": record_id},
+            ).first()
+            return _row_to_dict(row)
+
+    def exists(self, record_id: str) -> bool:
+        with self.engine.begin() as conn:
+            row = conn.execute(
+                text(f"SELECT 1 FROM {self.clean_schema}.calculations WHERE record_id = :record_id"),
+                {"record_id": record_id},
+            ).first()
+            return row is not None
+
+
+class DftUArchiveRepository(_BaseRepository):
