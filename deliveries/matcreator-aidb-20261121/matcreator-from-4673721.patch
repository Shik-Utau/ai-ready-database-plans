+from __future__ import annotations
+
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+from typing import Any
+
+from ..cloud.cloud_query import count_relevant_cloud_records
+from ..local.local_ase_db import count_relevant_local_records
+
+
+@dataclass
+class FineTuneGapReport:
+    required_configurations: int
+    local_available: int
+    cloud_available: int
+    needed_without_cloud: int
+    needed_with_cloud: int
+    saved_by_cloud: int
+    recommended_action: str
+    local_query_summary: dict[str, Any]
+    cloud_query_summary: dict[str, Any]
+    warnings: list[str] = field(default_factory=list)
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def plan_finetune_data_gap(local_db_path: str | Path, postgres_uri: str | None, query: dict[str, Any], min_required_configurations: int, allow_cloud_probe: bool = True) -> FineTuneGapReport:
+    local_available = count_relevant_local_records(local_db_path, query)
+    cloud_available = 0
+    warnings: list[str] = []
+    if allow_cloud_probe and postgres_uri:
+        try:
+            cloud_available = count_relevant_cloud_records(postgres_uri, query)
+        except Exception as exc:  # noqa: BLE001
+            warnings.append(f"cloud probe failed: {exc}")
+    needed_without_cloud = max(min_required_configurations - local_available, 0)
+    needed_with_cloud = max(min_required_configurations - local_available - cloud_available, 0)
+    saved_by_cloud = needed_without_cloud - needed_with_cloud
+    if needed_without_cloud == 0:
+        action = "local data already satisfy the target"
+    elif cloud_available and needed_with_cloud < needed_without_cloud:
+        action = "ask user whether cloud reuse is allowed before scheduling new DFT"
+    else:
+        action = "schedule additional local DFT calculations"
+    return FineTuneGapReport(
+        required_configurations=min_required_configurations,
+        local_available=local_available,
+        cloud_available=cloud_available,
+        needed_without_cloud=needed_without_cloud,
+        needed_with_cloud=needed_with_cloud,
+        saved_by_cloud=saved_by_cloud,
+        recommended_action=action,
+        local_query_summary={"query": query, "matched": local_available},
+        cloud_query_summary={"query": query, "matched": cloud_available, "probed": bool(allow_cloud_probe and postgres_uri)},
+        warnings=warnings,
+    )
