@@ -0,0 +1,94 @@
+from __future__ import annotations
+
+from typing import Any
+
+from ase import Atoms
+
+SOFTWARE = {"vasp": "VASP", "abacus": "ABACUS", "quantum espresso": "Quantum ESPRESSO", "qe": "Quantum ESPRESSO", "cp2k": "CP2K", "fhi-aims": "FHI-aims"}
+
+
+def classify_software(raw_metadata: dict[str, Any]) -> str:
+    value = str(raw_metadata.get("software") or raw_metadata.get("code") or "").strip().lower()
+    if not value:
+        return "unknown"
+    return SOFTWARE.get(value, "others")
+
+
+def classify_xc(raw_metadata: dict[str, Any]) -> str:
+    explicit = raw_metadata.get("xc_functional") or raw_metadata.get("functional")
+    if not explicit:
+        return "unknown"
+    base = str(explicit).upper().replace(" ", "")
+    dft_u = raw_metadata.get("dft_u")
+    dispersion = str(raw_metadata.get("dispersion") or "").upper()
+    if base == "PBE":
+        if dft_u is True and dispersion == "D3":
+            return "PBE+U+D3"
+        if dft_u is True:
+            return "PBE+U"
+        if dispersion == "D3":
+            return "PBE+D3"
+        if dft_u is None:
+            return "PBE"
+        return "PBE"
+    if base in {"SCAN", "R2SCAN", "HSE06"}:
+        return "r2SCAN" if base == "R2SCAN" else base
+    return "others"
+
+
+def classify_spin(raw_metadata: dict[str, Any]) -> str:
+    magnetic_order = raw_metadata.get("magnetic_order")
+    if magnetic_order:
+        return "magnetic order known"
+    if raw_metadata.get("spin_polarized") is True:
+        return "spin-polarized" if raw_metadata.get("magnetic_order") is None else "magnetic order unknown"
+    if raw_metadata.get("spin_polarized") is False:
+        return "non-spin-polarized"
+    return "spin metadata missing"
+
+
+def classify_system_type(atoms: Atoms | None, raw_metadata: dict[str, Any]) -> str:
+    value = str(raw_metadata.get("system_type") or "").strip().lower()
+    allowed = {"bulk", "surface", "interface", "defect", "vacancy", "interstitial", "adsorbate", "molecule"}
+    if value in allowed:
+        return value
+    if atoms is not None and not any(atoms.pbc):
+        return "molecule"
+    return "unknown"
+
+
+def classify_property_labels(raw_data: dict[str, Any]) -> list[str]:
+    labels = []
+    for key in ("energy", "forces", "stress", "formation_energy", "adsorption_energy", "migration_barrier", "magnetic_moment", "band_gap", "charge_density", "density_of_states", "phonon", "elastic_constant"):
+        if raw_data.get(key) is not None:
+            labels.append("force" if key == "forces" else key)
+    return labels or ["others"]
+
+
+def normalize_metadata(raw_metadata: dict[str, Any], atoms: Atoms | None = None, raw_data: dict[str, Any] | None = None) -> dict[str, Any]:
+    raw_data = raw_data or {}
+    spin_state = classify_spin(raw_metadata)
+    return {
+        "software": classify_software(raw_metadata),
+        "software_version": raw_metadata.get("software_version"),
+        "xc_functional": classify_xc(raw_metadata),
+        "dft_u": raw_metadata.get("dft_u"),
+        "u_scheme": raw_metadata.get("u_scheme"),
+        "u_values": raw_metadata.get("u_values") or {},
+        "dispersion": raw_metadata.get("dispersion"),
+        "spin_polarized": raw_metadata.get("spin_polarized"),
+        "spin_state": spin_state,
+        "magnetic_order": raw_metadata.get("magnetic_order"),
+        "system_type": classify_system_type(atoms, raw_metadata),
+        "property_labels": classify_property_labels(raw_data),
+        "pseudopotential_family": raw_metadata.get("pseudopotential_family"),
+        "calculation_status": raw_metadata.get("calculation_status", "unknown"),
+        "data_quality": raw_metadata.get("data_quality", "unknown"),
+    }
+
+
+def validate_metadata(metadata: dict[str, Any]) -> None:
+    required = {"software", "xc_functional", "spin_state", "system_type", "property_labels", "calculation_status", "data_quality"}
+    missing = sorted(required - set(metadata))
+    if missing:
+        raise ValueError(f"Missing normalized metadata fields: {', '.join(missing)}")
