@@ -0,0 +1,197 @@
+from __future__ import annotations
+
+import math
+from functools import reduce
+from typing import Any, Mapping
+
+from ai_ready_db.chemistry.functionals import analyze_functional_metadata
+from ai_ready_db.chemistry.elements import DEFAULT_TRANSITION_METALS, has_transition_metal
+from ai_ready_db.core.hashing import compute_structure_hash, generate_record_id
+from ai_ready_db.core.material_record import MaterialRecord
+from ai_ready_db.core.stress import normalize_stress, virial_from_stress
+
+
+def _coerce_float(value: Any) -> float | None:
+    if value is None:
+        return None
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        return None
+
+
+def _species_from_site(site: Mapping[str, Any]) -> str | None:
+    species = site.get("species")
+    if isinstance(species, list) and species:
+        first = species[0]
+        if isinstance(first, Mapping):
+            return str(first.get("element") or first.get("species") or first.get("label") or "").strip() or None
+        return str(first)
+    for key in ("specie", "element", "label"):
+        if key in site and site[key] is not None:
+            value = site[key]
+            if isinstance(value, Mapping):
+                return str(value.get("element") or value.get("symbol") or "").strip() or None
+            return str(value).strip() or None
+    return None
+
+
+def infer_composition(structure: Mapping[str, Any], raw: Mapping[str, Any]) -> dict[str, float]:
+    composition = raw.get("composition") or structure.get("composition")
+    if isinstance(composition, Mapping):
+        return {str(k): float(v) for k, v in composition.items()}
+    counts: dict[str, float] = {}
+    sites = structure.get("sites")
+    if isinstance(sites, list):
+        for site in sites:
+            if isinstance(site, Mapping):
+                element = _species_from_site(site)
+                if element:
+                    counts[element] = counts.get(element, 0.0) + 1.0
+    species = raw.get("species") or structure.get("species")
+    if not counts and isinstance(species, list):
+        for element in species:
+            counts[str(element)] = counts.get(str(element), 0.0) + 1.0
+    return counts
+
+
+def reduced_formula_from_composition(composition: Mapping[str, float]) -> str:
+    if not composition:
+        return "UNKNOWN"
+    integer_counts: list[int] = []
+    for amount in composition.values():
+        rounded = int(round(float(amount)))
+        integer_counts.append(max(1, rounded))
+    divisor = reduce(math.gcd, integer_counts) if integer_counts else 1
+    parts = []
+    for element in sorted(composition):
+        count = max(1, int(round(float(composition[element]))) // divisor)
+        parts.append(f"{element}{'' if count == 1 else count}")
+    return "".join(parts)
+
+
+def _infer_volume(structure: Mapping[str, Any], raw: Mapping[str, Any]) -> float | None:
+    direct = _coerce_float(raw.get("volume") or structure.get("volume"))
+    if direct is not None:
+        return direct
+    lattice = structure.get("lattice")
+    if isinstance(lattice, Mapping):
+        direct = _coerce_float(lattice.get("volume"))
+        if direct is not None:
+            return direct
+        matrix = lattice.get("matrix")
+    else:
+        matrix = lattice
+    if isinstance(matrix, list) and len(matrix) == 3:
+        try:
+            a, b, c = matrix
+            return abs(
+                a[0] * (b[1] * c[2] - b[2] * c[1])
+                - a[1] * (b[0] * c[2] - b[2] * c[0])
+                + a[2] * (b[0] * c[1] - b[1] * c[0])
+            )
+        except (TypeError, IndexError):
+            return None
+    return None
+
+
+def normalize_json_record(
+    raw: Mapping[str, Any],
+    source_dataset: str,
+    transition_metals: set[str] | None = None,
+) -> MaterialRecord:
+    structure = raw.get("structure") or raw.get("structure_json") or {}
+    if not isinstance(structure, Mapping):
+        raise ValueError("record structure must be a mapping")
+    structure_dict = dict(structure)
+    source_id = str(raw.get("source_id") or raw.get("id") or raw.get("material_id") or raw.get("task_id") or "")
+    if not source_id:
+        raise ValueError("record is missing source_id/id/material_id/task_id")
+
+    composition = infer_composition(structure_dict, raw)
+    elements = sorted(str(element) for element in (raw.get("elements") or composition.keys()))
+    nsites = int(raw.get("nsites") or raw.get("num_sites") or raw.get("natoms") or sum(composition.values()) or 0)
+    formula_reduced = str(
+        raw.get("formula_reduced")
+        or raw.get("reduced_formula")
+        or structure_dict.get("formula_reduced")
+        or reduced_formula_from_composition(composition)
+    )
+    formula_pretty = raw.get("formula_pretty") or raw.get("formula") or formula_reduced
+    energy = _coerce_float(raw.get("energy"))
+    energy_per_atom = _coerce_float(raw.get("energy_per_atom"))
+    if energy_per_atom is None and energy is not None and nsites:
+        energy_per_atom = energy / nsites
+
+    calculation_parameters = dict(raw.get("calculation_parameters") or raw.get("parameters") or {})
+    source_metadata = dict(raw.get("source_metadata") or raw.get("metadata") or {})
+    dft_payload = {
+        "functional": raw.get("functional"),
+        "calculation_parameters": calculation_parameters,
+        "source_metadata": source_metadata,
+        "input": raw.get("input"),
+        "run_type": raw.get("run_type"),
+        "task_type": raw.get("task_type"),
+    }
+    functional_metadata = analyze_functional_metadata(dft_payload)
+    has_hubbard_u = functional_metadata["has_hubbard_u"]
+    hubbard_u = functional_metadata["hubbard_u"]
+    structure_hash = compute_structure_hash(structure_dict, formula_reduced, elements, nsites)
+    functional = raw.get("functional") or calculation_parameters.get("functional") or source_metadata.get("functional")
+    calculation_type = raw.get("calculation_type") or raw.get("task_type") or source_metadata.get("task_type")
+    provenance = dict(raw.get("provenance") or {"source_dataset": source_dataset, "source_id": source_id})
+    stress, provenance = normalize_stress(
+        raw.get("stress"),
+        raw.get("stress_unit") or source_metadata.get("stress_unit"),
+        raw.get("stress_convention") or source_metadata.get("stress_convention"),
+        provenance,
+    )
+    volume = _infer_volume(structure_dict, raw)
+    record_id = generate_record_id(
+        source_dataset=source_dataset,
+        source_id=source_id,
+        structure_hash=structure_hash,
+        energy=energy,
+        functional=functional,
+        has_hubbard_u=has_hubbard_u,      # Shik add
+        calculation_type=calculation_type,
+    )
+    tm_set = transition_metals or DEFAULT_TRANSITION_METALS
+    return MaterialRecord(
+        record_id=record_id,
+        source_dataset=source_dataset,
+        source_id=source_id,
+        structure=structure_dict,
+        formula_pretty=str(formula_pretty) if formula_pretty is not None else None,
+        formula_reduced=formula_reduced,
+        composition=composition,
+        elements=elements,
+        nsites=nsites,
+        volume=volume,
+        density=_coerce_float(raw.get("density")),
+        structure_hash=structure_hash,
+        energy=energy,
+        energy_per_atom=energy_per_atom,
+        forces=raw.get("forces"),
+        stress=stress,
+        stress_unit="eV/Angstrom^3" if stress is not None else None,
+        stress_convention=str(raw.get("stress_convention") or source_metadata.get("stress_convention") or "unknown")
+        if stress is not None
+        else None,
+        virial=raw.get("virial") or virial_from_stress(stress, volume),
+        virial_unit=str(raw.get("virial_unit") or "eV") if stress is not None else None,
+        magmom=raw.get("magmom"),
+        charge=raw.get("charge"),
+        functional=str(functional) if functional is not None else None,
+        hubbard_u=hubbard_u if has_hubbard_u else None,
+        has_transition_metal=has_transition_metal(elements, tm_set),
+        calculation_type=str(calculation_type) if calculation_type is not None else None,
+        calculation_parameters=calculation_parameters,
+        source_metadata=source_metadata,
+        screening=dict(raw.get("screening") or {}),
+        provenance=provenance,
+        trajectory_id=raw.get("trajectory_id") or source_metadata.get("trajectory_id"),
+        frame_index=int(raw["frame_index"]) if raw.get("frame_index") is not None else None,
+        parent_structure_id=raw.get("parent_structure_id") or source_metadata.get("parent_structure_id"),
+        sampling_type=raw.get("sampling_type") or source_metadata.get("sampling_type"),
+    )
