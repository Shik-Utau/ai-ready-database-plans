+from __future__ import annotations
+
+from copy import deepcopy
+from dataclasses import asdict, dataclass, field
+from typing import Any
+
+
+@dataclass
+class MaterialRecord:
+    record_id: str
+    source_dataset: str
+    source_id: str
+    structure: dict[str, Any]
+    formula_reduced: str
+    composition: dict[str, float]
+    elements: list[str]
+    nsites: int
+    structure_hash: str
+    formula_pretty: str | None = None
+    volume: float | None = None
+    density: float | None = None
+    energy: float | None = None
+    energy_per_atom: float | None = None
+    forces: list[Any] | None = None
+    stress: list[Any] | None = None
+    stress_unit: str | None = None
+    stress_convention: str | None = None
+    virial: list[Any] | None = None
+    virial_unit: str | None = None
+    magmom: list[Any] | None = None
+    charge: list[Any] | None = None
+    functional: str | None = None
+    hubbard_u: dict[str, Any] | None = None
+    has_transition_metal: bool = False
+    calculation_type: str | None = None
+    calculation_parameters: dict[str, Any] = field(default_factory=dict)
+    source_metadata: dict[str, Any] = field(default_factory=dict)
+    screening: dict[str, Any] = field(default_factory=dict)
+    provenance: dict[str, Any] = field(default_factory=dict)
+    original_dft_u_record_id: str | None = None
+    workflow_id: str | None = None
+    ingest_run_id: str | None = None
+    trajectory_id: str | None = None
+    frame_index: int | None = None
+    parent_structure_id: str | None = None
+    sampling_type: str | None = None
+    tags: list[dict[str, Any]] = field(default_factory=list)
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+    def copy(self, **updates: Any) -> "MaterialRecord":
+        data = deepcopy(self.to_dict())
+        data.update(updates)
+        return MaterialRecord(**data)
+
+    @property
+    def has_hubbard_u(self) -> bool:
+        """Return whether this record uses DFT+U based on stored method details."""
+        if self.hubbard_u:
+            return True
+
+        params = self.calculation_parameters or {}
+        for key in ("LDAU", "ldau"):
+            if key not in params:
+                continue
+            ldau = params[key]
+            if isinstance(ldau, bool):
+                return ldau
+            if isinstance(ldau, str):
+                return ldau.strip().lower() in {"true", ".true.", "t", "1", "yes", "y", "on"}
+            if isinstance(ldau, (int, float)):
+                return bool(ldau)
+
+        return False
+
+    @classmethod
+    def from_ase_atoms(cls, atoms: Any, **kwargs: Any) -> "MaterialRecord":
+        from ai_ready_db.core.ase_converters import material_record_from_ase_atoms
+
+        return material_record_from_ase_atoms(atoms, **kwargs)
+
+    def to_ase_atoms(self) -> Any:
+        from ai_ready_db.core.ase_converters import material_record_to_ase_atoms
+
+        return material_record_to_ase_atoms(self)
diff --git a/delivery/vendor/ai-ready-db/ai_ready_db/core/normalization.py b/delivery/vendor/ai-ready-db/ai_ready_db/core/normalization.py
