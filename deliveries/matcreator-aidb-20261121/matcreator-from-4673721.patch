+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping
+
+from sqlalchemy import text
+
+from ai_ready_db.config import get_canonical_database_backend
+from ai_ready_db.database.postgres import create_postgres_engine, init_database as init_postgres_database
+from ai_ready_db.database.repositories import (
+    CleanBaseRepository,
+    DftUArchiveRepository,
+    RecalcJobRepository,
+    RoutedCloudRepository,
+    SpecialSettingsRepository,
+    WorkflowRepository,
+)
+
+
+@dataclass
+class RepositoryBundle:
+    clean: Any
+    dft_u: Any
+    recalc_jobs: Any
+    pbe_d3: Any | None = None
+    special: Any | None = None
+    routed: Any | None = None
+    workflow: Any | None = None
+
+
+def create_database(config: Mapping[str, Any]) -> Any:
+    backend = get_canonical_database_backend(config)
+    if backend == "postgres":
+        return create_postgres_engine(config)
+    raise ValueError(f"Canonical database operations require PostgreSQL CloudDB, got: {backend}")
+
+
+def init_database(config: Mapping[str, Any], database: Any) -> None:
+    backend = get_canonical_database_backend(config)
+    if backend == "postgres":
+        init_postgres_database(database)
+        return
+    raise ValueError(f"Canonical database initialization requires PostgreSQL CloudDB, got: {backend}")
+
+
+def repository_bundle(config: Mapping[str, Any], database: Any) -> RepositoryBundle:
+    backend = get_canonical_database_backend(config)
+    if backend == "postgres":
+        schemas = {
+            "pbe_d3": config.get("postgres", {}).get("schema_pbe_d3", "pbe_d3_archive"),
+            "special": config.get("postgres", {}).get("schema_special_settings", "special_settings_archive"),
+        }
+        return RepositoryBundle(
+            clean=CleanBaseRepository(database, config),
+            dft_u=DftUArchiveRepository(database, config),
+            recalc_jobs=RecalcJobRepository(database, config),
+            pbe_d3=SpecialSettingsRepository(database, schemas["pbe_d3"], config),
+            special=SpecialSettingsRepository(database, schemas["special"], config),
+            routed=RoutedCloudRepository(database, config),
+            workflow=WorkflowRepository(database, config),
+        )
+    raise ValueError(f"Canonical repositories require PostgreSQL CloudDB, got: {backend}")
+
+
+def status_counts(config: Mapping[str, Any], database: Any) -> dict[str, Any]:
+    backend = get_canonical_database_backend(config)
+    if backend == "postgres":
+        clean_schema = config["postgres"]["schema_clean"]
+        dft_schema = config["postgres"]["schema_dft_u"]
+        pbe_d3_schema = config["postgres"].get("schema_pbe_d3", "pbe_d3_archive")
+        special_schema = config["postgres"].get("schema_special_settings", "special_settings_archive")
+        workflow_schema = config["postgres"]["schema_workflow"]
+        with database.begin() as conn:
+            counts = {
+                "clean_base_structures": conn.execute(text(f"SELECT count(*) FROM {clean_schema}.structures")).scalar_one(),
+                "clean_base_calculations": conn.execute(text(f"SELECT count(*) FROM {clean_schema}.calculations")).scalar_one(),
+                "dft_u_archive_structures": conn.execute(text(f"SELECT count(*) FROM {dft_schema}.structures")).scalar_one(),
+                "dft_u_archive_calculations": conn.execute(text(f"SELECT count(*) FROM {dft_schema}.calculations")).scalar_one(),
+                "pbe_d3_archive_calculations": conn.execute(text(f"SELECT count(*) FROM {pbe_d3_schema}.calculations")).scalar_one(),
+                "special_settings_archive_calculations": conn.execute(text(f"SELECT count(*) FROM {special_schema}.calculations")).scalar_one(),
+                "recalc_jobs_by_status": {},
+            }
+            rows = conn.execute(
+                text(f"SELECT status, count(*) FROM {workflow_schema}.recalc_jobs GROUP BY status ORDER BY status")
+            ).all()
+            counts["recalc_jobs_by_status"] = {row._mapping["status"]: row._mapping["count"] for row in rows}
+            return counts
+    raise ValueError(f"Canonical status requires PostgreSQL CloudDB, got: {backend}")
diff --git a/delivery/vendor/ai-ready-db/ai_ready_db/database/models.py b/delivery/vendor/ai-ready-db/ai_ready_db/database/models.py
