+                        recalc_clean_record_id = COALESCE(:clean_record_id, recalc_clean_record_id),
+                        recalc_error_message = :error_message
+                    WHERE record_id = :record_id
+                    """
+                ),
+                {
+                    "record_id": original_dft_u_record_id,
+                    "status": status,
+                    "workflow_id": workflow_id,
+                    "clean_record_id": clean_record_id,
+                    "error_message": error_message,
