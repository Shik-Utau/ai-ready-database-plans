@@ -0,0 +1,104 @@
+from __future__ import annotations
+
+import json
+import os
+import tempfile
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from ai_ready_db.core.hashing import stable_digest
+
+
+def _now() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+class SidecarStore:
+    """Single-file JSON sidecar for small local ASE workspaces.
+
+    TODO: shard by sidecar_id prefix if local workspaces grow beyond the
+    intended 100-1000 record range.
+    """
+
+    def __init__(self, path: str | Path):
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+
+    def _read_all(self) -> dict[str, Any]:
+        if not self.path.exists() or self.path.stat().st_size == 0:
+            return {"records": {}}
+        return json.loads(self.path.read_text(encoding="utf-8"))
+
+    def _write_all(self, payload: dict[str, Any]) -> None:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        fd, tmp_name = tempfile.mkstemp(prefix=f".{self.path.name}.", suffix=".tmp", dir=str(self.path.parent))
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as handle:
+                json.dump(payload, handle, indent=2, sort_keys=True, default=str)
+                handle.write("\n")
+                handle.flush()
+                os.fsync(handle.fileno())
+            os.replace(tmp_name, self.path)
+        finally:
+            if os.path.exists(tmp_name):
+                os.unlink(tmp_name)
+
+    def put(self, record_id: str, payload: dict[str, Any]) -> str:
+        sidecar_id = str(payload.get("sidecar_id") or stable_digest({"record_id": record_id, "payload": payload})[:24])
+        now = _now()
+        complete = {
+            "record_id": record_id,
+            "cloud_record_id": payload.get("cloud_record_id"),
+            "structure_json": payload.get("structure_json"),
+            "composition": payload.get("composition"),
+            "elements": payload.get("elements"),
+            "energy": payload.get("energy"),
+            "energy_per_atom": payload.get("energy_per_atom"),
+            "functional": payload.get("functional"),
+            "has_transition_metal": payload.get("has_transition_metal"),
+            "calculation_type": payload.get("calculation_type"),
+            "sampling_type": payload.get("sampling_type"),
+            "trajectory_id": payload.get("trajectory_id"),
+            "frame_index": payload.get("frame_index"),
+            "forces": payload.get("forces"),
+            "stress": payload.get("stress"),
+            "virial": payload.get("virial"),
+            "magmom": payload.get("magmom"),
+            "charge": payload.get("charge"),
+            "hubbard_u": payload.get("hubbard_u"),
+            "calculation_parameters": payload.get("calculation_parameters") or {},
+            "source_metadata": payload.get("source_metadata") or {},
+            "screening": payload.get("screening") or {},
+            "tags": payload.get("tags") or [],
+            "provenance": payload.get("provenance") or {},
+            "workflow": payload.get("workflow") or {},
+            "export_history": payload.get("export_history") or [],
+            "created_at": payload.get("created_at") or now,
+            "updated_at": now,
+        }
+        db = self._read_all()
+        db.setdefault("records", {})[sidecar_id] = complete
+        self._write_all(db)
+        return sidecar_id
+
+    def get(self, sidecar_id: str) -> dict[str, Any]:
+        db = self._read_all()
+        try:
+            return dict(db.get("records", {})[sidecar_id])
+        except KeyError as exc:
+            raise KeyError(f"Sidecar record not found: {sidecar_id}") from exc
+
+    def update(self, sidecar_id: str, patch: dict[str, Any]) -> None:
+        db = self._read_all()
+        records = db.setdefault("records", {})
+        if sidecar_id not in records:
+            raise KeyError(f"Sidecar record not found: {sidecar_id}")
+        records[sidecar_id].update(patch)
+        records[sidecar_id]["updated_at"] = _now()
+        self._write_all(db)
+
+    def delete(self, sidecar_id: str) -> None:
+        db = self._read_all()
+        db.setdefault("records", {}).pop(sidecar_id, None)
+        self._write_all(db)
