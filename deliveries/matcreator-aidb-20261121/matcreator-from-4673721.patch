index 0000000..7df3244
--- /dev/null
+++ b/delivery/vendor/ai-ready-db/ai_ready_db/utils/dataset_splitting.py
@@ -0,0 +1,61 @@
+from __future__ import annotations
+
+from collections import defaultdict
+from typing import Any
+
+from ai_ready_db.core.hashing import stable_digest
+from ai_ready_db.core.material_record import MaterialRecord
+
+
+def _group_key(record: MaterialRecord, strategy: str) -> str:
+    if strategy == "group_by_formula":
+        return record.formula_reduced
+    if strategy == "group_by_structure_hash":
+        return record.structure_hash
+    if strategy == "group_by_trajectory":
+        return record.trajectory_id or record.parent_structure_id or record.structure_hash
+    return record.record_id
+
+
+def build_deterministic_splits(
+    records: list[MaterialRecord],
+    strategy: str = "random_by_record",
+    seed: int = 2026,
+    fractions: dict[str, float] | None = None,
+) -> dict[str, list[str]]:
+    fractions = fractions or {"train": 0.8, "val": 0.1, "test": 0.1}
+    groups: dict[str, list[MaterialRecord]] = defaultdict(list)
+    for record in records:
+        groups[_group_key(record, strategy)].append(record)
+    ordered = sorted(groups, key=lambda key: stable_digest({"seed": seed, "key": key}))
+    n = len(ordered)
+    train_cut = int(n * fractions.get("train", 0.8))
+    val_cut = train_cut + int(n * fractions.get("val", 0.1))
+    split_for_group = {
+        **{key: "train" for key in ordered[:train_cut]},
+        **{key: "val" for key in ordered[train_cut:val_cut]},
+        **{key: "test" for key in ordered[val_cut:]},
+    }
+    splits = {"train": [], "val": [], "test": []}
+    for key, items in groups.items():
+        split = split_for_group[key]
+        splits[split].extend(record.record_id for record in items)
+    return splits
+
+
+def check_split_leakage(records: list[MaterialRecord], splits: dict[str, list[str]]) -> dict[str, Any]:
+    split_by_record = {record_id: split for split, ids in splits.items() for record_id in ids}
+    seen: dict[tuple[str, str], str] = {}
+    leaks = []
+    by_id = {record.record_id: record for record in records}
+    for record_id, split in split_by_record.items():
+        record = by_id[record_id]
+        keys = [("structure_hash", record.structure_hash)]
+        if record.trajectory_id:
+            keys.append(("trajectory_id", record.trajectory_id))
+        for key in keys:
+            prior = seen.get(key)
+            if prior is not None and prior != split:
+                leaks.append({"kind": key[0], "value": key[1], "splits": sorted({prior, split})})
+            seen[key] = split
+    return {"has_leakage": bool(leaks), "leaks": leaks}
