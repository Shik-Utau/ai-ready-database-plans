@@ -0,0 +1,49 @@
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Any
+
+
+def stable_json(data: Any) -> str:
+    return json.dumps(data, sort_keys=True, separators=(",", ":"), ensure_ascii=True, default=str)
+
+
+def stable_digest(data: Any, length: int = 32) -> str:
+    return hashlib.sha256(stable_json(data).encode("utf-8")).hexdigest()[:length]
+
+
+def compute_structure_hash(
+    structure: dict[str, Any],
+    formula_reduced: str | None = None,
+    elements: list[str] | None = None,
+    nsites: int | None = None,
+) -> str:
+    payload = {
+        "structure": structure,
+        "formula_reduced": formula_reduced,
+        "elements": sorted(elements or []),
+        "nsites": nsites,
+    }
+    return stable_digest(payload, length=40)
+
+
+def generate_record_id(
+    source_dataset: str,
+    source_id: str,
+    structure_hash: str,
+    energy: float | None,
+    functional: str | None,
+    has_hubbard_u: bool,
+    calculation_type: str | None,
+) -> str:
+    payload = {
+        "source_dataset": source_dataset,
+        "source_id": source_id,
+        "structure_hash": structure_hash,
+        "energy": None if energy is None else round(float(energy), 12),
+        "functional": functional,
+        "has_hubbard_u": bool(has_hubbard_u),
+        "calculation_type": calculation_type,
+    }
+    return stable_digest(payload, length=32)
