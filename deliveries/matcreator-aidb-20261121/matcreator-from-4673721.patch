+from __future__ import annotations
+
+import json
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+
+from ai_ready_db.datasets.base import DatasetLoader
+from ai_ready_db.core.material_record import MaterialRecord
+from ai_ready_db.core.normalization import normalize_json_record
+
+
+class GenericJsonlLoader(DatasetLoader):
+    """Generic JSONL loader for MVP ingestion when private dataset formats are unavailable."""
+
+    def iter_records(self) -> Iterator[MaterialRecord]:
+        if not self.path.exists():
+            raise FileNotFoundError(f"Dataset path not found for {self.source_dataset}: {self.path}")
+        files: list[Path]
+        if self.path.is_dir():
+            files = sorted(self.path.glob("*.jsonl"))
+        else:
+            files = [self.path]
+        transition_metals = set(self.config.get("transition_metals") or [])
+        for file_path in files:
+            with file_path.open("r", encoding="utf-8") as handle:
+                for line_no, line in enumerate(handle, start=1):
+                    if not line.strip():
+                        continue
+                    raw: dict[str, Any] = json.loads(line)
+                    raw.setdefault("source_metadata", {})
+                    raw["source_metadata"].setdefault("loader", "generic_jsonl")
+                    raw["source_metadata"].setdefault("input_file", str(file_path))
+                    raw["source_metadata"].setdefault("input_line", line_no)
+                    yield normalize_json_record(raw, self.source_dataset, transition_metals or None)
