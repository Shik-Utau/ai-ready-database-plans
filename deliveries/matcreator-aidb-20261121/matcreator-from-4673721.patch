+
+DEFAULT_DPA_SKILL_ROOT = "skills/dpa-fine-tuning"
+
+
+@dataclass(frozen=True)
+class DPADataConversionPlan:
+    dft_dirs: list[str]
+    output: str = "fine_tune_planer/data"
+    valid_ratio: float = 0.2
+    min_frames: int = 2
+    format: str | None = None
+    input_json: str | None = None
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+    def build_command(self, prototype_root: str | Path = DEFAULT_DPA_SKILL_ROOT) -> list[str]:
+        command = [
+            "python", str(Path(prototype_root) / "scripts" / "convert_dft_to_dpdata.py"),
+            "--dft-dirs", *self.dft_dirs,
+            "--output", self.output,
+            "--valid-ratio", str(self.valid_ratio),
+            "--min-frames", str(self.min_frames),
+        ]
+        if self.format:
+            command.extend(["--format", self.format])
+        if self.input_json:
+            command.extend(["--input-json", self.input_json])
+        return command
+
+
+@dataclass(frozen=True)
+class SupplementalDFTJobPlan:
+    structures: list[str]
+    output_dir: str = "dft_calcs"
+    code: str = "abacus"
+    functional: str = "PBE"
+    dispersion: str = "D3"
+    calc_type: str = "relax"
+    command: list[str] | None = None
+    dft_profile: dict[str, Any] | None = None
+
+    def to_dict(self) -> dict[str, Any]:
+        payload = asdict(self)
+        payload["command"] = self.command or self.build_command()
+        payload["dft_profile"] = self.dft_profile or get_dpa_special_dft_profile().to_dict()
+        return payload
+
+    def build_command(self, prototype_root: str | Path = DEFAULT_DPA_SKILL_ROOT) -> list[str]:
+        if self.code.lower() != "abacus":
+            raise NotImplementedError("Only the prototype ABACUS DPA DFT preparation adapter is wired.")
+        return [
+            "python", str(Path(prototype_root) / "scripts" / "prepare_dft_inputs.py"),
+            "--structures", *self.structures,
+            "--output-dir", self.output_dir,
+            "--functional", self.functional,
+            "--dispersion", self.dispersion,
+            "--calc-type", self.calc_type,
+        ]
+
+
+@dataclass(frozen=True)
+class DPAFineTuneConfig:
+    model: str
+    branch: str | None = "Omat24"
+    data_dir: str = "fine_tune_planer/data"
+    steps: int = 10000
+    output: str = "fine_tune_planer/input.json"
+    type_map: list[str] | None = None
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+    def build_command(self, prototype_root: str | Path = DEFAULT_DPA_SKILL_ROOT) -> list[str]:
+        command = [
+            "python", str(Path(prototype_root) / "scripts" / "build_finetune_config.py"),
+            "--model", self.model,
+            "--data-dir", self.data_dir,
+            "--steps", str(self.steps),
+            "--output", self.output,
+        ]
+        if self.branch:
+            command.extend(["--branch", self.branch])
+        if self.type_map:
+            command.extend(["--type-map", *self.type_map])
+        return command
+
+
+@dataclass(frozen=True)
+class DPAFineTuneRun:
+    config: DPAFineTuneConfig
+    command: list[str]
+    training_command: list[str]
+    status: str = "planned"
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def build_supplemental_dft_job_plan(structures: list[str], output_dir: str = "dft_calcs") -> SupplementalDFTJobPlan:
+    return SupplementalDFTJobPlan(structures=structures, output_dir=output_dir)
+
+
+def build_dpa_finetune_run(config: DPAFineTuneConfig, prototype_root: str | Path = DEFAULT_DPA_SKILL_ROOT) -> DPAFineTuneRun:
+    training_command = ["dp", "--pt", "train", config.output, "--finetune", config.model]
+    if config.branch:
+        training_command.extend(["--model-branch", config.branch])
+    return DPAFineTuneRun(config=config, command=config.build_command(prototype_root), training_command=training_command)
