@@ -0,0 +1,63 @@
+from __future__ import annotations
+
+from collections import Counter
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+from .classify import classify_record
+from .normalize import normalize_record
+from .omat_reader import iter_omat_records
+from .postgres_writer import create_required_tables, insert_cleaned_records
+
+
+def _validate_record(record: dict[str, Any]) -> None:
+    if not record.get("structure_hash"):
+        raise ValueError("missing structure_hash")
+    if record.get("energy") is None and record.get("forces") is None and record.get("stress") is None:
+        raise ValueError("missing all target properties")
+
+
+def reforge_omat_to_postgres(config_path: str | Path) -> dict[str, Any]:
+    config = yaml.safe_load(Path(config_path).read_text(encoding="utf-8")) or {}
+    source_path = config.get("omat_path")
+    uri = config.get("postgres_uri")
+    if not source_path or not uri:
+        raise ValueError("Reforging config requires omat_path and postgres_uri")
+    create_required_tables(uri)
+    valid: list[dict[str, Any]] = []
+    invalid = Counter()
+    missing = Counter()
+    stats = {"software": Counter(), "xc": Counter(), "spin": Counter(), "system_type": Counter(), "property_label": Counter()}
+    scanned = 0
+    for raw in iter_omat_records(source_path, config.get("omat_reader") or {}):
+        scanned += 1
+        try:
+            record = normalize_record(raw)
+            classification = classify_record(record)
+            record["classification"] = classification
+            _validate_record(record)
+            valid.append(record)
+            for key, bucket in (("software", "software"), ("xc", "xc_functional"), ("spin", "spin_state"), ("system_type", "system_type")):
+                stats[key][classification[bucket]] += 1
+            for label in classification["property_labels"]:
+                stats["property_label"][label] += 1
+            if classification["software"] == "unknown":
+                missing["software"] += 1
+            if classification["xc_functional"] == "unknown":
+                missing["xc_functional"] += 1
+            if classification["spin_state"] == "spin metadata missing":
+                missing["spin"] += 1
+        except Exception as exc:  # noqa: BLE001
+            invalid[str(exc)] += 1
+    write_summary = insert_cleaned_records(uri, valid)
+    return {
+        "total_records_scanned": scanned,
+        "valid_records_inserted": write_summary["inserted"],
+        "duplicate_records_skipped": write_summary["duplicates"],
+        "invalid_records_skipped": sum(invalid.values()),
+        "missing_metadata_statistics": dict(missing),
+        "classification_statistics": {key: dict(value) for key, value in stats.items()},
+        "invalid_reasons": dict(invalid),
+    }
