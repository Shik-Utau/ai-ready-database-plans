@@ -0,0 +1,269 @@
+from __future__ import annotations
+
+import json
+import logging
+import os
+import re
+from pathlib import Path
+from typing import Any, Mapping
+
+from ai_ready_db.database.factory import repository_bundle
+from ai_ready_db.ai_ready_db_Reforging.workflows.bohrium_executor import (
+    BOHRIUM_WORKFLOWS_HOST,
+    bohrium_credentials_available,
+    build_bohrium_machine_dict,
+    build_bohrium_plugin_config,
+    build_dflow_runtime_config,
+    build_executor_metadata,
+    sanitized_bohrium_metadata,
+)
+
+LOGGER = logging.getLogger(__name__)
+
+DEFAULT_BACKWARD_LIST = [
+    "INCAR",
+    "POSCAR",
+    "KPOINTS",
+    "POTCAR",
+    "POTCAR.spec",
+    "OUTCAR",
+    "CONTCAR",
+    "OSZICAR",
+    "XDATCAR",
+    "vasprun.xml",
+    "stdout.txt",
+    "stderr.txt",
+    "metadata.json",
+    "ai_ready_recalc_status.json",
+]
+
+
+def _dflow_credentials_available(config: Mapping[str, Any]) -> bool:
+    if not config.get("dflow", {}).get("enabled", True):
+        return False
+    runtime = build_dflow_runtime_config(config)
+    return bool(runtime.get("host"))
+
+
+def _should_dry_run(config: Mapping[str, Any]) -> bool:
+    configured = config.get("dflow", {}).get("dry_run")
+    if configured is not None:
+        return bool(configured)
+    return not (_dflow_credentials_available(config) and bohrium_credentials_available(config))
+
+
+def _write_dry_run_spec(job: dict[str, Any], config: Mapping[str, Any]) -> Path:
+    output_root = Path(config.get("outputs", {}).get("root", "outputs")) / "dflow_dry_run"
+    output_root.mkdir(parents=True, exist_ok=True)
+    spec = {
+        "original_dft_u_record_id": job["original_dft_u_record_id"],
+        "job_dir": job["job_dir"],
+        "source_dataset": job["source_dataset"],
+        "source_id": job["source_id"],
+        "formula_reduced": job["formula_reduced"],
+        "executor": build_executor_metadata(config),
+        "dflow": build_dflow_runtime_config(config),
+        "bohrium": sanitized_bohrium_metadata(config),
+        "workflow_template": build_workflow_template_metadata(job, config),
+        "status": "dry_run_not_submitted",
+    }
+    path = output_root / f"{job['original_dft_u_record_id']}.json"
+    path.write_text(json.dumps(spec, indent=2, sort_keys=True, default=str), encoding="utf-8")
+    return path
+
+
+def _workflow_name(raw_name: str) -> str:
+    name = raw_name.lower()
+    name = re.sub(r"[^a-z0-9-]", "-", name)
+    name = re.sub(r"^-+", "", name)
+    name = re.sub(r"-+$", "", name)
+    name = re.sub(r"-+$", "", name[:63])
+    return name or "ai-ready-db-recalc"
+
+
+def _run_image(config: Mapping[str, Any]) -> str | None:
+    bohrium = config.get("bohrium", {})
+    vasp = config.get("vasp", {})
+    return bohrium.get("image") or vasp.get("image") or vasp.get("vasp_image_name")
+
+
+def _run_command(config: Mapping[str, Any]) -> str:
+    bohrium = config.get("bohrium", {})
+    vasp = config.get("vasp", {})
+    return str(bohrium.get("vasp_command") or vasp.get("run_command") or vasp.get("vasp_run_command") or "vasp_std")
+
+
+def _backward_list(config: Mapping[str, Any]) -> list[str]:
+    return [str(item) for item in config.get("dflow", {}).get("backward_list", DEFAULT_BACKWARD_LIST)]
+
+
+def validate_job_dir_for_real_submission(job_dir: str | Path, config: Mapping[str, Any]) -> None:
+    path = Path(job_dir)
+    required = ["POSCAR", "INCAR", "KPOINTS", "metadata.json"]
+    if config.get("vasp", {}).get("require_potcar_for_submission", True):
+        required.append("POTCAR")
+    missing = [name for name in required if not (path / name).is_file()]
+    if missing:
+        raise FileNotFoundError(
+            f"Prepared job directory {path} is missing required real-submission files: {', '.join(missing)}"
+        )
+
+
+def build_workflow_template_metadata(job: Mapping[str, Any], config: Mapping[str, Any]) -> dict[str, Any]:
+    return {
+        "kind": "direct_dflow_vasp_recalc",
+        "workflow_name": _workflow_name(
+            f"{config.get('dflow', {}).get('workflow_name_prefix', 'ai-ready-db-recalc')}-{job['original_dft_u_record_id']}"
+        ),
+        "step_name": "VASP-Recalc",
+        "op": "ai_ready_db.ai_ready_db_Reforging.workflows.dflow_ops.RunPreparedVasp",
+        "task_path": job["job_dir"],
+        "run_image": _run_image(config),
+        "run_command": _run_command(config),
+        "backward_list": _backward_list(config),
+        "executor": build_executor_metadata(config),
+    }
+
+
+def _configure_dflow(config: Mapping[str, Any]) -> None:
+    from dflow import config as dflow_config
+    from dflow import s3_config
+    from dflow.plugins import bohrium
+
+    for key, value in build_dflow_runtime_config(config).items():
+        dflow_config[key] = value
+
+    dflow_s3_config = config.get("dflow", {}).get("dflow_s3_config") or {}
+    if build_dflow_runtime_config(config).get("host") == BOHRIUM_WORKFLOWS_HOST:
+        from dflow.plugins.bohrium import TiefblueClient
+
+        s3_config["repo_key"] = dflow_s3_config.get("repo_key", "oss-bohrium")
+        s3_config["storage_client"] = dflow_s3_config.get("storage_client", TiefblueClient())
+    for key, value in dflow_s3_config.items():
+        s3_config[key] = value
+
+    for key, value in build_bohrium_plugin_config(config).items():
+        bohrium.config[key] = value
+
+
+def _build_dispatcher_executor(config: Mapping[str, Any]):
+    from dflow.plugins.dispatcher import DispatcherExecutor
+
+    bohrium = config.get("bohrium", {})
+    dispatcher_config = {
+        "image": bohrium.get("dispatcher_image"),
+        "image_pull_policy": bohrium.get("image_pull_policy", "IfNotPresent"),
+        "machine_dict": build_bohrium_machine_dict(config),
+        "resources_dict": bohrium.get("resources"),
+        "task_dict": bohrium.get("task"),
+        "command": bohrium.get("dispatcher_command", "python3"),
+        "remote_command": bohrium.get("dispatcher_remote_command"),
+    }
+    dispatcher_config.update(config.get("dflow", {}).get("dispatcher_config") or {})
+    filtered = {key: value for key, value in dispatcher_config.items() if value is not None}
+    return DispatcherExecutor(**filtered)
+
+
+def _upload_python_packages(config: Mapping[str, Any]) -> list[os.PathLike]:
+    import ai_ready_db
+
+    packages: list[os.PathLike] = []
+    for item in config.get("dflow", {}).get("upload_python_packages", []):
+        packages.append(Path(item))
+    packages.append(Path(ai_ready_db.__file__).resolve().parent)
+    return packages
+
+
+def _construct_and_submit_dflow_workflow(job: dict[str, Any], config: Mapping[str, Any]) -> dict[str, Any]:
+    try:
+        from dflow import Step, Workflow, upload_artifact
+        from dflow.python import PythonOPTemplate
+    except ModuleNotFoundError as exc:
+        raise RuntimeError("dflow is not installed; install ai-ready-db[workflow] or enable dry_run") from exc
+
+    from ai_ready_db.ai_ready_db_Reforging.workflows.dflow_ops import RunPreparedVasp
+
+    validate_job_dir_for_real_submission(job["job_dir"], config)
+    run_image = _run_image(config)
+    if not run_image:
+        raise ValueError("Real dflow/Bohrium submission requires bohrium.image or vasp.image/vasp_image_name")
+
+    _configure_dflow(config)
+    template_metadata = build_workflow_template_metadata(job, config)
+    workflow = Workflow(name=template_metadata["workflow_name"])
+    step_key = _workflow_name(f"vasp-recalc-{job['original_dft_u_record_id']}")
+    step = Step(
+        name="VASP-Recalc",
+        template=PythonOPTemplate(
+            RunPreparedVasp,
+            image=run_image,
+            python_packages=_upload_python_packages(config),
+            command=["python3"],
+        ),
+        artifacts={"task_path": upload_artifact(job["job_dir"])},
+        parameters={
+            "run_command": _run_command(config),
+            "task_name": job["original_dft_u_record_id"],
+            "backward_list": _backward_list(config),
+        },
+        key=step_key,
+        executor=_build_dispatcher_executor(config) if config.get("bohrium", {}).get("enabled", True) else None,
+    )
+    workflow.add(step)
+    workflow.submit()
+    return {
+        "dflow_workflow_id": workflow.id,
+        "dflow_workflow_uid": getattr(workflow, "uid", None),
+        "step_key": step_key,
+        "template": template_metadata,
+    }
+
+
+def submit_prepared_recalc_jobs(config: Mapping[str, Any], database: Any, limit: int | None = None) -> dict[str, Any]:
+    repo = repository_bundle(config, database).recalc_jobs
+    jobs = repo.get_prepared_jobs(limit)
+    dry_run = _should_dry_run(config)
+    submitted = 0
+    dry_run_specs: list[str] = []
+    failed = 0
+    for job in jobs:
+        original_id = job["original_dft_u_record_id"]
+        try:
+            if dry_run:
+                spec_path = _write_dry_run_spec(job, config)
+                existing_input = job.get("input_metadata") or {}
+                if not isinstance(existing_input, dict):
+                    existing_input = {"previous_input_metadata": existing_input}
+                existing_input.update({"dry_run": True, "dry_run_spec_path": str(spec_path)})
+                repo.update_status(original_id, "prepared", input_metadata=existing_input)
+                dry_run_specs.append(str(spec_path))
+                continue
+
+            try:
+                submission = _construct_and_submit_dflow_workflow(job, config)
+            except ModuleNotFoundError as exc:
+                raise RuntimeError("dflow is not installed; enable dry_run or install ai-ready-db[workflow]") from exc
+            repo.update_status(
+                original_id,
+                "submitted",
+                dflow_workflow_id=submission["dflow_workflow_id"],
+                input_metadata={
+                    "executor": build_executor_metadata(config),
+                    "restart_safe": True,
+                    "dflow_workflow_uid": submission.get("dflow_workflow_uid"),
+                    "step_key": submission.get("step_key"),
+                    "workflow_template": submission.get("template"),
+                },
+            )
+            submitted += 1
+        except Exception as exc:  # noqa: BLE001
+            LOGGER.exception("Failed to submit recalculation job %s", original_id)
+            repo.update_status(original_id, "failed", error_message=str(exc))
+            failed += 1
+    return {
+        "prepared_jobs": len(jobs),
+        "submitted": submitted,
+        "dry_run": dry_run,
+        "dry_run_specs": dry_run_specs,
+        "failed": failed,
+    }
