@@ -0,0 +1,64 @@
+from __future__ import annotations
+
+import json
+from collections import Counter
+from pathlib import Path
+from statistics import mean
+from typing import Any, Mapping
+
+from ai_ready_db import __version__
+from ai_ready_db.core.hashing import stable_digest
+from ai_ready_db.core.material_record import MaterialRecord
+
+
+def _stats(values: list[float]) -> dict[str, float | int | None]:
+    if not values:
+        return {"count": 0, "min": None, "max": None, "mean": None}
+    return {"count": len(values), "min": min(values), "max": max(values), "mean": mean(values)}
+
+
+def build_dataset_manifest(
+    records: list[MaterialRecord],
+    query: Mapping[str, Any] | None = None,
+    config: Mapping[str, Any] | None = None,
+    code_version: str | None = None,
+) -> dict[str, Any]:
+    source_counts = Counter(record.source_dataset for record in records)
+    element_counts: Counter[str] = Counter()
+    forces: list[float] = []
+    energies = [float(record.energy_per_atom) for record in records if record.energy_per_atom is not None]
+    stress_available = 0
+    for record in records:
+        element_counts.update(record.elements)
+        if record.stress is not None:
+            stress_available += 1
+        if record.screening.get("max_force_norm") is not None:
+            forces.append(float(record.screening["max_force_norm"]))
+    screening_versions = sorted({str(record.screening.get("screening_version")) for record in records if record.screening})
+    return {
+        "query": dict(query or {}),
+        "record_count": len(records),
+        "source_distribution": dict(source_counts),
+        "element_distribution": dict(element_counts),
+        "force_statistics": _stats(forces),
+        "energy_statistics": _stats(energies),
+        "stress_availability": {"available": stress_available, "missing": len(records) - stress_available},
+        "screening_version": screening_versions[0] if len(screening_versions) == 1 else screening_versions,
+        "config_hash": stable_digest(config or {}),
+        "code_version": code_version or __version__,
+    }
+
+
+def write_dataset_manifest(
+    records: list[MaterialRecord],
+    output_dir: str | Path,
+    query: Mapping[str, Any] | None = None,
+    config: Mapping[str, Any] | None = None,
+    code_version: str | None = None,
+) -> Path:
+    output = Path(output_dir)
+    output.mkdir(parents=True, exist_ok=True)
+    manifest = build_dataset_manifest(records, query=query, config=config, code_version=code_version)
+    path = output / "dataset_manifest.json"
+    path.write_text(json.dumps(manifest, indent=2, sort_keys=True), encoding="utf-8")
+    return path
