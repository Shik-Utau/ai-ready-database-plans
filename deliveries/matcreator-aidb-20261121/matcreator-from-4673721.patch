+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+from typing import Any
+
+from ai_ready_db.core.material_record import MaterialRecord
+
+
+@dataclass(frozen=True)
+class FourLayerClassification:
+    software: str
+    xc_functional: str
+    model_type: str
+    prototype: str
+    tags: list[str]
+    special_reasons: list[str]
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def _tag_names(record: MaterialRecord) -> set[str]:
+    return {str(tag.get("tag")) for tag in record.tags if isinstance(tag, dict) and tag.get("tag")}
+
+
+def _software(record: MaterialRecord) -> str:
+    meta = record.source_metadata or {}
+    params = record.calculation_parameters or {}
+    value = meta.get("software") or meta.get("calculator") or params.get("software") or params.get("calculator")
+    return str(value or "VASP").upper()
+
+
+def _xc_functional(record: MaterialRecord) -> str:
+    params = record.calculation_parameters or {}
+    functional = str(record.functional or params.get("functional") or "PBE")
+    if record.has_hubbard_u and "+U" not in functional.upper():
+        return f"{functional}+U"
+    if _truthy(params.get("IVDW")) or str(params.get("dispersion", "")).upper() in {"D2", "D3", "D3BJ", "D3_BJ"}:
+        if "+D3" not in functional.upper():
+            return f"{functional}+D3"
+    return functional
+
+
+def _model_type(record: MaterialRecord) -> str:
+    meta = record.source_metadata or {}
+    params = record.calculation_parameters or {}
+    tags = _tag_names(record)
+    explicit = meta.get("model_type") or params.get("model_type") or meta.get("domain")
+    if explicit:
+        return str(explicit).strip().replace("-", "_").title().replace("_", "_")
+    for candidate in ("interface", "defect", "interstitial", "slab", "surface", "molecule", "bulk"):
+        if candidate in tags:
+            return {"surface": "Slab"}.get(candidate, candidate.title())
+    if record.structure.get("lattice") and record.structure.get("sites"):
+        return "Bulk"
+    return "unknown"
+
+
+def _prototype(record: MaterialRecord) -> str:
+    meta = record.source_metadata or {}
+    explicit = meta.get("prototype") or meta.get("structure_prototype")
+    if explicit:
+        return str(explicit)
+    tags = _tag_names(record)
+    ordered = [
+        "perovskite",
+        "spinel",
+        "garnet",
+        "rocksalt",
+        "fluorite",
+        "alloy",
+        "lithium_containing",
+        "transition_metal_oxide",
+        "oxide",
+    ]
+    if "contains_transition_metal" in tags and ("oxide" in tags or "O" in record.elements):
+        return "transition_metal_oxide"
+    for name in ordered:
+        if name in tags:
+            return name
+    return "unknown_prototype"
+
+
+def _truthy(value: Any) -> bool:
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, (int, float)):
+        return bool(value)
+    if isinstance(value, str):
+        return value.strip().lower() in {"true", ".true.", "t", "1", "yes", "y", "on", "d3", "d3bj", "d3_bj"}
+    return bool(value)
+
+
+def _special_reasons(record: MaterialRecord, xc: str, model_type: str) -> list[str]:
+    params = record.calculation_parameters or {}
+    reasons: list[str] = []
+    if record.has_hubbard_u or "+U" in xc.upper():
+        reasons.append("dft_u")
+    if "+D3" in xc.upper() or _truthy(params.get("IVDW")) or _truthy(params.get("dispersion")):
+        reasons.append("dispersion")
+    if int(params.get("ISPIN") or params.get("nspin") or 1) != 1:
+        reasons.append("spin_polarized")
+    if model_type.lower() not in {"bulk", "unknown"}:
+        reasons.append(f"model_type_{model_type.lower()}")
+    calc_type = str(record.calculation_type or params.get("calculation_type") or params.get("calculation") or "").lower()
+    if calc_type in {"relax", "cell-relax", "cell_relax", "relaxation"}:
+        reasons.append("relaxation")
+    if record.trajectory_id or record.frame_index is not None or record.sampling_type == "trajectory":
+        reasons.append("trajectory")
+    if params.get("ISMEAR") not in (None, 0, "0") or params.get("SIGMA") not in (None, 0, "0", 0.0):
+        reasons.append("non_default_smearing")
+    return sorted(set(reasons))
+
+
+def classify_record_four_layers(record: MaterialRecord) -> FourLayerClassification:
+    software = _software(record)
+    xc = _xc_functional(record)
+    model_type = _model_type(record)
+    prototype = _prototype(record)
+    tags = sorted(_tag_names(record))
+    classification = FourLayerClassification(
+        software=software,
+        xc_functional=xc,
+        model_type=model_type,
+        prototype=prototype,
+        tags=tags,
+        special_reasons=_special_reasons(record, xc, model_type),
+    )
+    record.source_metadata["four_layer_classification"] = classification.to_dict()
+    return classification
