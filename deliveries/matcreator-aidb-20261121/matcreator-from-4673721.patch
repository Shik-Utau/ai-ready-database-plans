+from __future__ import annotations
+
+from typing import Any
+
+from ai_ready_db.ai_ready_db_Renaissance.fine_tune_planer.target_profile import TargetProfile
+from ai_ready_db.ai_ready_db_Renaissance.cloud.cloud_sync import query_cloud_by_target_profile
+from ai_ready_db.ai_ready_db_Renaissance.evaluator.cost_estimator import estimate_dft_gap, recommend_cloud_reuse_count
+from ai_ready_db.ai_ready_db_Renaissance.local.local_workspace import LocalASEWorkspace
+from ai_ready_db.ai_ready_db_Renaissance.cloud.cloud_sync import pull_cloud_records_to_local
+from ai_ready_db.ai_ready_db_Renaissance.local.local_query import query_local_by_target_profile
+
+
+def reject_cloud_reuse(profile: TargetProfile, workspace: LocalASEWorkspace, config: dict) -> dict[str, Any]:
+    local_records = query_local_by_target_profile(profile, limit=config.get("retrieval", {}).get("max_local_records_per_target"), workspace=workspace)
+    gap = estimate_dft_gap(profile.min_records, len(local_records))
+    return {
+        "decision": "reject_cloud_reuse",
+        "cloud_records_pulled": 0,
+        "additional_dft_required": gap,
+        "new_records_sync_status": "local_only",
+        "upload_automatic": False,
+        "training_set": {"local_record_ids": [record.record_id for record in local_records], "cloud_reused_record_ids": []},
+    }
+
+
+def accept_cloud_reuse(profile: TargetProfile, workspace: LocalASEWorkspace, config: dict, limit: int | None = None) -> dict[str, Any]:
+    retrieval = config.get("retrieval", {})
+    local_records = query_local_by_target_profile(profile, limit=retrieval.get("max_local_records_per_target"), workspace=workspace)
+    local_gap = estimate_dft_gap(profile.min_records, len(local_records))
+    cloud_records = query_cloud_by_target_profile(profile, int(limit or retrieval.get("max_cloud_records_to_pull", 500)))
+    recommended = recommend_cloud_reuse_count(len(cloud_records), local_gap, retrieval.get("max_cloud_records_to_reuse"))
+    selected = cloud_records[:recommended]
+    pull = pull_cloud_records_to_local(selected, workspace) if selected else {"pulled": 0, "record_ids": []}
+    gap = estimate_dft_gap(profile.min_records, len(local_records) + int(pull.get("pulled", 0)))
+    return {
+        "decision": "accept_cloud_reuse",
+        "cloud_records_found": len(cloud_records),
+        "cloud_records_pulled": int(pull.get("pulled", 0)),
+        "pulled_record_ids": list(pull.get("record_ids", [])),
+        "additional_dft_required": gap,
+        "new_records_sync_status": "local_only",
+        "cloud_reused_records_upload_eligible": False,
+        "upload_automatic": False,
+    }
